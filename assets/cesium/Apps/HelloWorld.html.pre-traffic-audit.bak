 outlineColor: Cesium.Color.WHITE,
 outlineWidth: 2,
 disableDepthTestDistance: Number.POSITIVE_INFINITY
 }
 });
 }
 const now = Date.now();
 const movedFarEnough = (lastUserMarkerHeightRefineLat === null) ||
 (haversineDistanceKm(lat, lon, lastUserMarkerHeightRefineLat, lastUserMarkerHeightRefineLon) >
 USER_MARKER_HEIGHT_REFINE_MIN_DISTANCE_KM);
 const enoughTimePassed = (now - lastUserMarkerHeightRefineTime) > USER_MARKER_HEIGHT_REFINE_MIN_INTERVAL_MS;
 if (movedFarEnough && enoughTimePassed) {
 lastUserMarkerHeightRefineTime = now;
 lastUserMarkerHeightRefineLat = lat;
 lastUserMarkerHeightRefineLon = lon;
 refineUserMarkerHeight(lat, lon);
 }
}
function refineUserMarkerHeight(lat, lon){
 const cartographic = Cesium.Cartographic.fromDegrees(lon, lat);
 viewer.scene.sampleHeightMostDetailed([cartographic]).then(function(){
 if (Cesium.defined(cartographic.height) && userMarkerEntity) {
 userMarkerEntity.position = Cesium.Cartesian3.fromDegrees(lon, lat, cartographic.height);
 console.log("User marker height refined to:", cartographic.height);
 }
 }).catch(function(heightError){
 console.error("User marker height refine failed (dot still visible at approximate height)");
 console.error(heightError);
 });
}
// ===================================================================
// FOLLOW MODE — extends the existing recenter/GPS system. Camera and
// GPS marker remain separate states; Follow only links them when
// explicitly enabled, and disables itself the instant the user
// manually moves the camera (isProgrammaticCameraMove distinguishes
// our own flyTo calls from real user drag/pinch/rotate input).
// ===================================================================
let followModeEnabled = false;
let isProgrammaticCameraMove = false;
let lastFollowFlightTime = 0;
let lastFollowLat = null;
let lastFollowLon = null;
viewer.camera.moveStart.addEventListener(function(){
 if (!isProgrammaticCameraMove && followModeEnabled) {
 followModeEnabled = false;
 console.log("FOLLOW: OFF (user took manual camera control)");
 }
});
// Clean CAMERA: state log — throttled naturally by moveEnd (fires once
// per settled pan/zoom/rotate/tilt, not per-frame, so no console spam).
viewer.camera.moveEnd.addEventListener(function(){
 const cam = viewer.camera.positionCartographic;
 console.log(
 "CAMERA: lon=" + Cesium.Math.toDegrees(cam.longitude).toFixed(6) +
 " lat=" + Cesium.Math.toDegrees(cam.latitude).toFixed(6) +
 " height=" + cam.height.toFixed(1) +
 " heading=" + Cesium.Math.toDegrees(viewer.camera.heading).toFixed(1) +
 " pitch=" + Cesium.Math.toDegrees(viewer.camera.pitch).toFixed(1)
 );
});
// ===================================================================
// PHASE 2 — OSM/OVERPASS PLACE + STREET NAME COVERAGE
// Bounded to the current visible map area only, throttled, cached in
// memory per-area, deduplicated, and capped — never bulk-downloads
// Sikkim/Kalimpong, never fires on every camera move. Non-fatal on
// failure: the 3D map and every other system keeps working normally.
// ===================================================================
// ===================================================================
// PERFORMANCE FIX (confirmed root causes #5, #6, #7):
// #5 — each OSM label previously got its own individual, unbatched
// refineEntityHeight() -> sampleHeightMostDetailed() promise call (up
// to 60 per viewport fetch). The taxi code already batches its height
// queries into one call; OSM labels now do the same.
// #6 — OSM entities were capped at OSM_MAX_LABELS but NEVER evicted.
// Once the cap filled up (from whichever areas were visited first —
// Kalimpong, then Sikkim locations, etc.) every later viewport's
// places silently failed to render, while the earliest entities sat
// resident (and were still processed every frame by Cesium's label/
// billboard visualizers) forever, off-screen or not. osmActiveEntities
// now tracks each entity with its Cesium object and add-order, and
// when the cap is reached, the OLDEST entities are genuinely removed
// via viewer.entities.remove() (not just hidden) to make room — a
// real bounded, rolling window instead of a one-time fill-and-stop.
// #7 — osmPlaceCache (the raw Overpass response cache, keyed per
// viewport bbox) had no size limit and grew for as long as the user
// kept panning to new areas. It's now capped and evicts its oldest
// entry (insertion-order, so this is O(1) with a plain Map) once full.
// ===================================================================
const osmPlaceCache = new Map();
const OSM_PLACE_CACHE_MAX_ENTRIES = 40;
const osmAddedKeys = new Set();
// osmActiveEntities is now the SINGLE source of truth for "OSM places
// currently resident" — each record carries both the Cesium entity and
// the original feature data. Search now reads from this map instead of
// a separate ever-growing array (see fix below), so search results and
// on-map entities can never drift out of sync, and both are naturally
// bounded by the same OSM_MAX_LABELS rolling window.
const osmActiveEntities = new Map(); // dedupeKey -> { entity, addOrder, feature }
let osmAddOrderCounter = 0;
let lastOsmFetchTime = 0;
const OSM_FETCH_THROTTLE_MS = 15000;
const OSM_MAX_LABELS = 150;
const OSM_MAX_CAMERA_HEIGHT_M = 20000;
function evictOldestOsmEntities(countToEvict){
 // osmActiveEntities preserves insertion order (Map), so the first
 // entries are always the oldest — cheap O(n) eviction of just the
 // entries we need, not a full rebuild or a blanket removeAll().
 let evicted = 0;
 for (const [dedupeKey, record] of osmActiveEntities) {
 if (evicted >= countToEvict) { break; }
 viewer.entities.remove(record.entity);
 osmActiveEntities.delete(dedupeKey);
 osmAddedKeys.delete(dedupeKey);
 evicted++;
 }
}
function maybeFetchOsmPlaces(){
 const now = Date.now();
 if (now - lastOsmFetchTime < OSM_FETCH_THROTTLE_MS) { return; }
 const cam = viewer.camera.positionCartographic;
 if (cam.height > OSM_MAX_CAMERA_HEIGHT_M) { return; }
 let rect;
 try {
 rect = viewer.camera.computeViewRectangle();
 } catch (rectError) {
 rect = null;
 }
 if (!rect) { return; }
 const south = Cesium.Math.toDegrees(rect.south).toFixed(2);
 const west = Cesium.Math.toDegrees(rect.west).toFixed(2);
 const north = Cesium.Math.toDegrees(rect.north).toFixed(2);
 const east = Cesium.Math.toDegrees(rect.east).toFixed(2);
 const cacheKey = south + "," + west + "," + north + "," + east;
 if (osmPlaceCache.has(cacheKey)) {
 renderOsmPlaces(osmPlaceCache.get(cacheKey));
 return;
 }
 lastOsmFetchTime = now;
 const bbox = south + "," + west + "," + north + "," + east;
 const query = "[out:json][timeout:20];(node[\"place\"~\"town|village|hamlet|locality|suburb\"](" +
 bbox + ");way[\"highway\"][\"name\"](" + bbox + "););out center 60;";
 fetch("https://overpass-api.de/api/interpreter", {
 method: "POST",
 headers: {
  "Accept": "application/json",
  "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
 },
 body: "data=" + encodeURIComponent(query)
 }).then(function(response){
 // CONFIRMED FIX (this pass — matches your exact reported error):
 // Overpass returns an HTML/XML error page (not JSON) on a 504
 // Gateway Timeout. The old code called response.json() directly
 // regardless of status, so the HTML error page's "<?xml ..." or
 // "<html>" opening tag got fed straight into JSON.parse(), which is
 // exactly "SyntaxError: Unexpected token '<'" from your console.
 // Now checked and short-circuited BEFORE parsing.
 if (!response.ok) {
 throw new Error("Overpass returned HTTP " + response.status);
 }
 return response.json();
 }).then(function(data){
 const features = (data.elements || []).map(function(el){
 const name = el.tags && el.tags.name;
 const lat = el.lat || (el.center && el.center.lat);
 const lon = el.lon || (el.center && el.center.lon);
 if (!name || !lat || !lon) { return null; }
 return { name: name, lat: lat, lon: lon, isRoad: !!(el.tags && el.tags.highway) };
 }).filter(function(f){ return f !== null; });
 if (osmPlaceCache.size >= OSM_PLACE_CACHE_MAX_ENTRIES && !osmPlaceCache.has(cacheKey)) {
 // Evict the oldest cached viewport response (Map preserves
 // insertion order) so this in-memory cache stays bounded no
 // matter how many different areas the user pans across.
 const oldestKey = osmPlaceCache.keys().next().value;
 osmPlaceCache.delete(oldestKey);
 }
 osmPlaceCache.set(cacheKey, features);
 renderOsmPlaces(features);
 }).catch(function(osmError){
 console.error("OSM Overpass fetch failed (non-fatal, map continues normally)");
 console.error(osmError);
 });
}
function renderOsmPlaces(features){
 // First pass: figure out which features are genuinely new (dedupe),
 // and make room for them by evicting the oldest resident entities if
 // needed — a real rolling window instead of a one-time fill-and-stop.
 const toAdd = [];
 features.forEach(function(f){
 const dedupeKey = f.name + "_" + f.lat.toFixed(3) + "_" + f.lon.toFixed(3);
 if (osmAddedKeys.has(dedupeKey)) { return; }
 toAdd.push({ f: f, dedupeKey: dedupeKey });
 });
 if (toAdd.length === 0) { return; }
 const roomNeeded = (osmAddedKeys.size + toAdd.length) - OSM_MAX_LABELS;
 if (roomNeeded > 0) {
 evictOldestOsmEntities(roomNeeded);
 }
 // Second pass: add entities (still respecting the cap in case more
 // arrived in this batch than we can fit even after eviction), then
 // batch ALL their height lookups into a single sampleHeightMostDetailed
 // call instead of one promise per entity.
 const addedEntities = [];
 const addedCartographics = [];
 toAdd.forEach(function(item){
 if (osmAddedKeys.size >= OSM_MAX_LABELS) { return; }
 const f = item.f;
 const dedupeKey = item.dedupeKey;
 osmAddedKeys.add(dedupeKey);
 const entity = viewer.entities.add({
 position: Cesium.Cartesian3.fromDegrees(f.lon, f.lat, 0),
 label: {
 text: f.name,
 font: f.isRoad ? "10px sans-serif" : "12px sans-serif",
 fillColor: f.isRoad ? Cesium.Color.LIGHTYELLOW : Cesium.Color.WHITE,
 outlineColor: Cesium.Color.BLACK,
 outlineWidth: 3,
 style: Cesium.LabelStyle.FILL_AND_OUTLINE,
 disableDepthTestDistance: Number.POSITIVE_INFINITY,
 distanceDisplayCondition: f.isRoad
 ? new Cesium.DistanceDisplayCondition(0.0, 1500.0)
 : new Cesium.DistanceDisplayCondition(0.0, 12000.0)
 }
 });
 osmActiveEntities.set(dedupeKey, { entity: entity, addOrder: osmAddOrderCounter++, feature: f });
 addedEntities.push({ entity: entity, lat: f.lat, lon: f.lon });
 addedCartographics.push(Cesium.Cartographic.fromDegrees(f.lon, f.lat));
 });
 if (addedCartographics.length === 0) { return; }
 viewer.scene.sampleHeightMostDetailed(addedCartographics).then(function(){
 addedEntities.forEach(function(item, index){
 const c = addedCartographics[index];
 if (Cesium.defined(c.height)) {
 item.entity.position = Cesium.Cartesian3.fromRadians(c.longitude, c.latitude, c.height);
 }
 });
 }).catch(function(heightError){
 console.error("Batched OSM height refine failed (labels still visible at approximate height)");
 console.error(heightError);
 });
 console.log("OSM: labels tracked =", osmAddedKeys.size);
}
viewer.camera.moveEnd.addEventListener(function(){
 maybeFetchOsmPlaces();
});
function followCameraTo(lat, lon){
 isProgrammaticCameraMove = true;
 viewer.camera.flyTo({
 destination: Cesium.Cartesian3.fromDegrees(lon, lat, 15000),
 duration: 1.5,
 complete: function(){ isProgrammaticCameraMove = false; },
 cancel: function(){ isProgrammaticCameraMove = false; }
 });
 lastFollowFlightTime = Date.now();
 lastFollowLat = lat;
 lastFollowLon = lon;
}
window.flyToUserLocation = function(lat, lon){
 console.log("Flutter sent GPS -> LAT:", lat, "LON:", lon);
 addOrUpdateUserMarker(lat, lon);
 viewer.camera.flyTo({
 destination: Cesium.Cartesian3.fromDegrees(
 lon,
 lat,
 15000
 ),
 duration:3
 });
};
window.updateUserMarker = function(lat, lon){
 console.log("Live GPS update -> LAT:", lat, "LON:", lon);
 addOrUpdateUserMarker(lat, lon);
 if (activeRoute) {
 trackNavigationProgress(lat, lon);
 }
 if (voiceEnabled) {
 checkHazardProximityVoice(lat, lon);
 }
 // Follow Mode: only re-center when actually needed — meaningful
 // movement (>15m) AND not already mid-flight AND at most once
 // every 4 seconds, to avoid jitter/fighting the user and avoid
 // excessive WebView JS calls on every single GPS tick.
 if (followModeEnabled) {
 const movedFarEnough = (lastFollowLat === null) ||
 (haversineDistanceKm(lat, lon, lastFollowLat, lastFollowLon) > 0.015);
 const enoughTimePassed = (Date.now() - lastFollowFlightTime) > 4000;
 if (movedFarEnough && enoughTimePassed && !isProgrammaticCameraMove) {
 followCameraTo(lat, lon);
 }
 }
};
// ===================================================================
// STAGE 1 (V2) — VOICE NAVIGATION HELPERS
// speak(): single gate for all TTS output — only speaks if voice is
// enabled and the browser's speech engine is available.
// ===================================================================
function speak(text){
 if (!voiceEnabled) { return; }
 // Android WebView does not implement window.speechSynthesis (a
 // known, long-standing Chromium/WebView limitation). Instead,
 // text is sent through the SafeRouteTTS JavaScriptChannel to
 // Flutter, which speaks it using Android's real native
 // TextToSpeech engine (see main.dart).
 if (typeof SafeRouteTTS !== "undefined" && SafeRouteTTS.postMessage) {
 SafeRouteTTS.postMessage(text);
 console.log("Voice (native Android TTS):", text);
 } else {
 console.error("SafeRouteTTS bridge unavailable — cannot speak. Text was:", text);
 }
}
// Per-hazard "already announced while nearby" state, keyed by a stable
// hazard identifier (zone name, or "rain-<location>" for rainfall
// zones). Uses hysteresis (announce radius vs. a larger clear radius)
// so a warning fires once per approach, not repeatedly while lingering
// near the edge of a zone.
let hazardApproachState = {};
function checkHazardProximityVoice(lat, lon){
 // Known historical hazard zones (Teesta III GLOF site, Kaw/Lingee-
 // Payong landslide corridor) — proximity-based, independent of
 // whether a route is active. Wording is deliberately cautious per
 // the safety rule: these are HISTORICAL zones, not claims of an
 // active disaster right now.
 staticHazardZones.forEach(function(zone){
 const d = haversineDistanceKm(lat, lon, zone.lat, zone.lon);
 const announceRadius = zone.radiusKm + 0.5;
 const clearRadius = zone.radiusKm + 1.5;
 if (d <= announceRadius) {
 if (!hazardApproachState[zone.name]) {
 speak("Warning. You are approaching a known historical hazard zone. " + zone.reason + ".");
 hazardApproachState[zone.name] = true;
 }
 } else if (d > clearRadius) {
 hazardApproachState[zone.name] = false;
 }
 });
 // Dynamic rainfall-based zones — only announced while that
 // location is CURRENTLY showing elevated rainfall (live data),
 // never presented as a permanent/historical hazard.
 latestWeatherResults.forEach(function(w){
 if (w.precipitation < RAIN_RISK_THRESHOLD_MM) { return; }
 const loc = weatherLocations.find(function(l){ return l.name === w.name; });
 if (!loc) { return; }
 const d = haversineDistanceKm(lat, lon, loc.lat, loc.lon);
 const key = "rain-" + w.name;
 const announceRadius = 5.5;
 const clearRadius = 7;
 if (d <= announceRadius) {
 if (!hazardApproachState[key]) {
 speak("Caution. Heavy rainfall risk detected near " + w.name + ". Current rainfall is elevated.");
 hazardApproachState[key] = true;
 }
 } else if (d > clearRadius) {
 hazardApproachState[key] = false;
 }
 });
}
// ===================================================================
// V2 NAVIGATION TRACKING — called on every live GPS update while a
// route is active. Handles: live ETA/remaining-distance, automatic
// rerouting if the user drifts off the route, and voice announcements
// of upcoming turns.
// ===================================================================
// ===================================================================
// CONFIRMED ROOT CAUSE (this pass — not TTS): nearestPointOnRoute()
// previously did coordinates.forEach(...) — a full linear haversine
// scan over EVERY point in the route, on EVERY GPS tick, for as long
// as a route is active. Cost scales directly with route length: a
// short 14-point route is negligible, but a real 90km mountain route
// (mentioned in your telemetry) can have hundreds to low thousands of
// points, and this reran in full every single tick, indefinitely.
// TTS (speak()) is a single lightweight async postMessage() to native
// Android TTS — not a plausible cause of frame drops on its own. It
// only APPEARED correlated with lag because both are triggered from
// this same trackNavigationProgress() call.
//
// FIX: since the user moves along the route continuously (not
// teleporting), the nearest point can only have moved a little since
// the last tick under normal conditions. Search a bounded window
// around the last known index instead of the whole array — O(window)
// instead of O(route length) on every tick. Falls back to a full scan
// only when there is no previous index to anchor from (first tick of
// a new route) or if the windowed search comes back implausibly far
// (e.g. after a reroute), so correctness is preserved.
// ===================================================================
let lastNearestRouteIndex = null;
const NAV_SEARCH_WINDOW = 40; // points ahead/behind — generous vs. realistic GPS-tick movement
function nearestPointOnRoute(lat, lon, coordinates){
 let searchStart = 0;
 let searchEnd = coordinates.length;
 let windowed = false;
 if (lastNearestRouteIndex !== null) {
 searchStart = Math.max(0, lastNearestRouteIndex - NAV_SEARCH_WINDOW);
 searchEnd = Math.min(coordinates.length, lastNearestRouteIndex + NAV_SEARCH_WINDOW);
 windowed = true;
 }
 let nearestIndex = searchStart;
 let nearestDistanceKm = Infinity;
 for (let index = searchStart; index < searchEnd; index++) {
 const coord = coordinates[index];
 const d = haversineDistanceKm(lat, lon, coord[1], coord[0]);
 if (d < nearestDistanceKm) {
 nearestDistanceKm = d;
 nearestIndex = index;
 }
 }
 // Safety net: if the windowed search's best match is still
 // implausibly far away (e.g. the user teleported in a simulator, or
 // a reroute wasn't caught by the reset above), fall back to a full
 // scan once rather than silently tracking the wrong point forever.
 if (windowed && nearestDistanceKm > 0.5) {
 nearestIndex = 0;
 nearestDistanceKm = Infinity;
 coordinates.forEach(function(coord, index){
 const d = haversineDistanceKm(lat, lon, coord[1], coord[0]);
 if (d < nearestDistanceKm) {
 nearestDistanceKm = d;
 nearestIndex = index;
 }
 });
 }
 lastNearestRouteIndex = nearestIndex;
 return { index: nearestIndex, distanceKm: nearestDistanceKm };
}
function trackNavigationProgress(lat, lon){
 if (window.__srPreview) { return; } // route preview: no voice/reroute/arrival until the user starts navigation
 const coordinates = activeRoute.coordinates;
 const nearest = nearestPointOnRoute(lat, lon, coordinates);
 const REROUTE_THRESHOLD_KM = 0.06; // ~60 meters
 const now = Date.now();
 // Auto-reroute: only check every 8s (avoid spamming GraphHopper on
 // every single GPS tick) and only if clearly off the route.
 if (nearest.distanceKm > REROUTE_THRESHOLD_KM && (now - lastRerouteCheckTime) > 8000) {
 lastRerouteCheckTime = now;
 console.log("Drifted", nearest.distanceKm.toFixed(3), "km from route — recalculating");
 speak("You are off route. Recalculating.");
 if (window.__srNavState) { window.__srNavState("rerouting"); }
 calculateRoute(lat, lon, activeRoute.destLat, activeRoute.destLon);
 return; // calculateRoute will rebuild activeRoute fresh
 }
 // Live ETA: estimate remaining distance/time as a fraction of the
 // route based on how far along the coordinate list we are.
 const fractionRemaining = 1 - (nearest.index / Math.max(1, coordinates.length - 1));
 const remainingKm = ((activeRoute.totalDistanceM / 1000) * fractionRemaining).toFixed(2);
 const remainingMin = Math.round((activeRoute.totalTimeMs / 60000) * fractionRemaining);
 const distanceRow = document.querySelector("#routeInfoText .infoRow:nth-child(1) strong");
 const timeRow = document.querySelector("#routeInfoText .infoRow:nth-child(2) strong");
 if (distanceRow) { distanceRow.textContent = remainingKm + " km"; }
 if (timeRow) { timeRow.textContent = remainingMin + " min"; }
 // Destination approach / arrival — real GraphHopper destination
 // coordinates, straight-line distance from live position. Each
 // fires exactly once per route (reset in selectAlternative).
 const distToDestKm = haversineDistanceKm(lat, lon, activeRoute.destLat, activeRoute.destLon);
 if (!announcedArrivedDestination && distToDestKm <= 0.03) {
 speak("You have arrived at your destination.");
 announcedArrivedDestination = true;
 if (window.__srNavState) { window.__srNavState("arrived"); }
 } else if (!announcedApproachingDestination && distToDestKm <= 0.3) {
 speak("You are approaching your destination.");
 announcedApproachingDestination = true;
 }
 // Voice guidance: announce the next upcoming turn once, when the
 // user is within ~300m of the point it applies to, including the
 // approximate distance — using the REAL GraphHopper instruction
 // text, not invented directions.
 if (activeRoute.instructions.length > 0) {
 for (let i = lastSpokenInstructionIndex + 1; i < activeRoute.instructions.length; i++) {
 const instruction = activeRoute.instructions[i];
 const pointIndex = instruction.interval ? instruction.interval[0] : null;
 if (pointIndex === null || pointIndex >= coordinates.length) { continue; }
 const instructionCoord = coordinates[pointIndex];
 const distToInstruction = haversineDistanceKm(lat, lon, instructionCoord[1], instructionCoord[0]);
 if (distToInstruction <= 0.3 && nearest.index <= pointIndex + 3) {
 const roundedMeters = Math.max(0, Math.round((distToInstruction * 1000) / 50) * 50);
 const spokenText = roundedMeters >= 50
 ? ("In " + roundedMeters + " meters, " + instruction.text)
 : instruction.text;
 speak(spokenText);
 lastSpokenInstructionIndex = i;
 }
 break; // only ever look at the next upcoming instruction
 }
 }
}
// "Recenter on My Location" button (like Google Maps). Uses the same
// lastUserLat/lastUserLon that's already tracked for routing, so no
// new GPS request is needed — just flies the camera back to the most
// recently known position. Also (re-)enables Follow Mode, matching
// the behavior of the recenter button in real navigation apps.
document.getElementById("recenterButton").addEventListener("click", function(){
 if (lastUserLat !== null && lastUserLon !== null) {
 isProgrammaticCameraMove = true;
 viewer.camera.flyTo({
 destination: Cesium.Cartesian3.fromDegrees(lastUserLon, lastUserLat, 15000),
 duration: 2,
 complete: function(){ isProgrammaticCameraMove = false; },
 cancel: function(){ isProgrammaticCameraMove = false; }
 });
 followModeEnabled = true;
 lastFollowLat = lastUserLat;
 lastFollowLon = lastUserLon;
 lastFollowFlightTime = Date.now();
 console.log("FOLLOW: ON (recenter pressed)");
 } else {
 console.error("No known location yet — cannot recenter");
 }
});
// ===================================================================
// PHASE 10 — GOVERNMENT INTEGRATION (part 1: emergency helplines)
// Real, verified official emergency numbers for Sikkim (confirmed via
// search, current as of this session — 108/102 ambulance service
// confirmed expanded Aug 2025). Tapping a number uses a real tel:
// link, intercepted on the Flutter side (main.dart, url_launcher) to
// open the phone's actual dialer.
// ===================================================================
const helplineButton = document.getElementById("helplineButton");
const helplinePanel = document.getElementById("helplinePanel");
const helplineSheetClose = document.getElementById("helplineSheetClose");
function closeAllSheets(){
 ["helplinePanel","permitPanel","weatherRiskPanel","osmSearchPanel"].forEach(function(id){
  const panel=document.getElementById(id);
  if(panel){panel.style.display="none";}
 });
}
helplineButton.addEventListener("click", function(){
 const isOpen = helplinePanel.style.display === "block";
 closeAllSheets();
 helplinePanel.style.display = isOpen ? "none" : "block";
});
helplineSheetClose.addEventListener("click", function(){
 helplinePanel.style.display = "none";
});
// ===================================================================
// PHASE 10 — GOVERNMENT INTEGRATION (part 3: permit / restricted area info)
// Real, verified current permit requirements for Sikkim's protected
// tourist areas (Nathula, Tsomgo, North Sikkim, Zuluk, Gurudongmar,
// Dzongri/Goechala) — confirmed via multiple cross-checked sources.
// Rules can shift with weather/security, so a link to the official
// Sikkim Tourism department page is included for current verification.
// ===================================================================
const permitButton = document.getElementById("permitButton");
const permitPanel = document.getElementById("permitPanel");
const permitSheetClose = document.getElementById("permitSheetClose");
permitButton.addEventListener("click", function(){
 const isOpen = permitPanel.style.display === "block";
 closeAllSheets();
 permitPanel.style.display = isOpen ? "none" : "block";
});
permitSheetClose.addEventListener("click", function(){
 permitPanel.style.display = "none";
});
// ===================================================================
// OSM SEARCH INTEGRATION — searches the already-fetched osmSearchableFeatures
// array from Phase 2 (no new Overpass requests here). Reuses the
// existing sheet toggle pattern, closeAllSheets, and the existing
// addSearchResultMarker function built for the Cesium geocoder.
// ===================================================================
const osmSearchButton = document.getElementById("osmSearchButton");
const osmSearchPanel = document.getElementById("osmSearchPanel");
const osmSearchClose = document.getElementById("osmSearchClose");
const osmSearchInput = document.getElementById("osmSearchInput");
const osmSearchResults = document.getElementById("osmSearchResults");
let osmCurrentMatches = [];
const SafeRouteGeographicScope = Object.freeze({
 SIKKIM:"SIKKIM", WEST_BENGAL:"WEST_BENGAL", OUTSIDE_SUPPORTED_REGION:"OUTSIDE_SUPPORTED_REGION", UNKNOWN:"UNKNOWN",
 classifyName:function(name){
  const value=String(name||"").toLowerCase();
  if(/\b(darjeeling|kalimpong|siliguri)\b/.test(value)) return this.WEST_BENGAL;
  if(/\b(gangtok|pakyong|namchi|soreng|gyalshing|mangan|rangpo|majitar|singtam|ranipool|ravangla|jorethang|nayabazar|naya bazar|yuksom|lachen|lachung|sikkim)\b/.test(value)) return this.SIKKIM;
  return this.UNKNOWN;
 }
});
window.SafeRouteGeographicScope=SafeRouteGeographicScope;
const knownSearchPlaces=[
 {name:"Gangtok",lat:27.3389,lon:88.6065,scope:"SIKKIM",scopeLabel:"SafeRoute reference · SIKKIM"},
 {name:"Pakyong",lat:27.2306,lon:88.6138,scope:"SIKKIM",scopeLabel:"SafeRoute reference · SIKKIM"},
 {name:"Namchi",lat:27.1663,lon:88.3639,scope:"SIKKIM",scopeLabel:"SafeRoute reference · SIKKIM"},
 {name:"Soreng",lat:27.1683,lon:88.1874,scope:"SIKKIM",scopeLabel:"SafeRoute reference · SIKKIM"},
 {name:"Gyalshing",lat:27.2896,lon:88.2597,scope:"SIKKIM",scopeLabel:"SafeRoute reference · SIKKIM"},
 {name:"Mangan",lat:27.5083,lon:88.5322,scope:"SIKKIM",scopeLabel:"SafeRoute reference · SIKKIM"},
 {name:"Rangpo",lat:27.1761,lon:88.5287,scope:"SIKKIM",scopeLabel:"SafeRoute reference · SIKKIM"},
 {name:"Singtam",lat:27.2340,lon:88.5014,scope:"SIKKIM",scopeLabel:"SafeRoute reference · SIKKIM"},
 {name:"Ravangla",lat:27.3061,lon:88.3631,scope:"SIKKIM",scopeLabel:"SafeRoute reference · SIKKIM"},
 {name:"Jorethang",lat:27.1482,lon:88.2673,scope:"SIKKIM",scopeLabel:"SafeRoute reference · SIKKIM"},
 {name:"Nayabazar",lat:27.13211,lon:88.27614,scope:"SIKKIM",scopeLabel:"OpenStreetMap reference · SIKKIM"},
 {name:"Yuksom",lat:27.3710,lon:88.2254,scope:"SIKKIM",scopeLabel:"SafeRoute reference · SIKKIM"},
 {name:"Lachen",lat:27.7156,lon:88.5561,scope:"SIKKIM",scopeLabel:"SafeRoute reference · SIKKIM"},
 {name:"Lachung",lat:27.6893,lon:88.7425,scope:"SIKKIM",scopeLabel:"SafeRoute reference · SIKKIM"},
 {name:"NH-10",lat:27.1730,lon:88.5300,isRoad:true,scope:"SIKKIM",scopeLabel:"SafeRoute reference · SIKKIM / WEST BENGAL connectivity"},
 {name:"Darjeeling",lat:27.041,lon:88.2663,scope:"WEST_BENGAL",scopeLabel:"SafeRoute reference · WEST BENGAL"},
 {name:"Kalimpong",lat:27.0667,lon:88.4667,scope:"WEST_BENGAL",scopeLabel:"SafeRoute reference · WEST BENGAL"}
];
window.SafeRouteSearchFallback = Object.freeze({
 normalize:function(value){
  return String(value||"").trim().toLowerCase().replace(/[,._-]+/g," ").replace(/\s+/g," ").replace(/^nh\s*10$/i,"nh-10").trim();
 },
 findBest:function(query){
  const q = this.normalize(query);
  if (!q) return null;
  const matches = [];
  for (const place of knownSearchPlaces) {
   const name = this.normalize(place.name);
   if (name === q || name.indexOf(q) !== -1 || q.indexOf(name) !== -1) {
    matches.push({score:name === q ? 3 : name.indexOf(q) !== -1 ? 2 : 1, place:place});
   }
  }
  const activeMatches = Array.from((window.osmActiveEntities || new Map()).values()).map(function(entry){
   const feature = entry && entry.feature ? entry.feature : null;
   if (!feature || !feature.name) return null;
   const name = this.normalize(feature.name);
   if (name === q || name.indexOf(q) !== -1 || q.indexOf(name) !== -1) {
    return {score:name === q ? 3 : name.indexOf(q) !== -1 ? 2 : 1, place:feature};
   }
   return null;
  }, this).filter(Boolean);
  const combined = matches.concat(activeMatches);
  if (!combined.length) return null;
  combined.sort(function(a,b){ return b.score - a.score || (a.place.name||"").length - (b.place.name||"").length; });
  return combined[0].place;
 }
});
function applyKnownPlaceSelection(place){
 if (!place) return false;
 const selected = {name:place.name || place.feature && place.feature.name, lat:Number(place.lat || place.latitude || (place.feature && place.feature.lat) || 0), lon:Number(place.lon || place.longitude || (place.feature && place.feature.lon) || 0), scope:place.scope || SafeRouteGeographicScope.classifyName(place.name || (place.feature && place.feature.name)), scopeLabel:place.scopeLabel || (place.feature && place.feature.scopeLabel) || ("SafeRoute reference · "+(place.scope || SafeRouteGeographicScope.classifyName(place.name || (place.feature && place.feature.name))))};
 if (!Number.isFinite(selected.lat) || !Number.isFinite(selected.lon)) { return false; }
 window.__srAiContext=window.__srAiContext||{};window.__srAiContext.selectedLocation={name:selected.name,lat:selected.lat,lon:selected.lon,scope:selected.scope,source:selected.scopeLabel};window.__srAiContext.lastEvent="search selection";window.__srAiContext.updatedAt=new Date().toISOString();window.dispatchEvent(new CustomEvent("saferoute:context"));
 window.__srSelectedDestination={name:selected.name,latitude:selected.lat,longitude:selected.lon,category:place.isRoad ? "road" : "place",source:selected.scopeLabel};
 if (window.__sr2dSetDestination) { window.__sr2dSetDestination(selected.lat, selected.lon); }
 if (window.__sr2dSetCenter) { window.__sr2dSetCenter(selected.lat, selected.lon, false, 14); }
 const viewerInstance = window.__srViewer || window.viewer;
 if (viewerInstance && viewerInstance.camera && window.__sr2dGetView && window.__sr2dGetView().mode === "3d") {
  isProgrammaticCameraMove = true;
  viewerInstance.camera.flyTo({ destination: Cesium.Cartesian3.fromDegrees(selected.lon, selected.lat, 3000), duration: 2, complete: function(){ isProgrammaticCameraMove = false; }, cancel: function(){ isProgrammaticCameraMove = false; } });
 }
 if (!window.__sr2dGetView || window.__sr2dGetView().mode === "3d") {
  addSearchResultMarker(selected.lat, selected.lon, selected.name);
 }
 return true;
}
function installGeocoderFallback(){
 const geocoderInput = document.querySelector(".cesium-geocoder-input");
 if (!geocoderInput || geocoderInput.dataset.srFallbackBound === "true") return;
 geocoderInput.dataset.srFallbackBound = "true";
 const handleFallback = function(){
  const query = String(geocoderInput.value || "").trim();
  if (!query) return;
  const match = window.SafeRouteSearchFallback.findBest(query);
  if (!match) return;
  geocoderInput.value = match.name || match.feature && match.feature.name || query;
  applyKnownPlaceSelection(match);
 };
 geocoderInput.addEventListener("keydown", function(event){ if (event.key === "Enter" || event.key === "NumpadEnter") { event.preventDefault(); handleFallback(); } });
 geocoderInput.addEventListener("change", handleFallback);
 const geocoderButton = document.querySelector(".cesium-geocoder-searchButton");
 if (geocoderButton) { geocoderButton.addEventListener("click", function(event){ event.preventDefault(); handleFallback(); }); }
}
setTimeout(installGeocoderFallback, 500);
osmSearchButton.addEventListener("click", function(){
 const isOpen = osmSearchPanel.style.display === "block";
 closeAllSheets();
 osmSearchPanel.style.display = isOpen ? "none" : "block";
});
osmSearchClose.addEventListener("click", function(){
 osmSearchPanel.style.display = "none";
});
// ===================================================================
// PERFORMANCE FIX (confirmed root cause — matches "even search becomes
// unusable" symptom): this handler previously fired on EVERY keystroke
// with NO debounce, and filtered osmSearchableFeatures — a plain array
// that was pushed to on every new OSM place discovered and NEVER
// pruned, even when its on-map entity was evicted. Over a long session
// covering many areas (Kalimpong, several Sikkim locations, etc.) that
// array grew without bound, so every keystroke did an ever-more-expensive
// full linear scan + toLowerCase over a permanently growing list — a
// direct, concrete mechanism for "search gets harder to use the longer
// you've been panning around." Search now reads from osmActiveEntities
// (the same bounded, evicting rolling window the map itself uses), so
// it can never exceed OSM_MAX_LABELS entries, and the keystroke handler
// is debounced (150ms) so rapid typing doesn't re-run the scan on every
// character.
// ===================================================================
let osmSearchDebounceHandle = null;
osmSearchInput.addEventListener("input", function(){
 if (osmSearchDebounceHandle) { clearTimeout(osmSearchDebounceHandle); }
 osmSearchDebounceHandle = setTimeout(function(){
 const q = osmSearchInput.value.trim().toLowerCase();
 // Accept conventional queries such as "Rangpo, Sikkim" without making a
 // network claim: known references and OSM names are matched locally first.
 const placeQuery = q.replace(/,?\s*sikkim\s*$/," ").trim() || q;
 if (q.length < 2) {
 osmSearchResults.innerHTML = "<div style='font-size:12px;opacity:0.6;'>Type at least 2 characters.</div>";
 osmCurrentMatches = [];
 return;
 }
 osmCurrentMatches = [];
 for (const place of knownSearchPlaces) {
  if (place.name.toLowerCase().indexOf(placeQuery)!==-1) { osmCurrentMatches.push(place); }
 }
 for (const record of osmActiveEntities.values()) {
 if (record.feature.name.toLowerCase().indexOf(placeQuery) !== -1) {
 osmCurrentMatches.push(Object.assign({},record.feature,{scope:SafeRouteGeographicScope.classifyName(record.feature.name),scopeLabel:"OpenStreetMap · CURRENT MAP · "+SafeRouteGeographicScope.classifyName(record.feature.name)}));
 if (osmCurrentMatches.length >= 8) { break; }
 }
 }
 if (osmCurrentMatches.length === 0) {
 osmSearchResults.innerHTML =
 "<div style='font-size:12px;opacity:0.7;line-height:1.4;'>No matches in areas discovered so far. Pan/zoom the map near your destination first, then search again.</div>";
 return;
 }
 osmSearchResults.innerHTML = osmCurrentMatches.map(function(f, i){
 return "<div class='helplineRow' style='cursor:pointer;' onclick='window.__flyToOsmResult(" + i + ")'>" +
 "<span class='helplineName'>" + f.name + (f.isRoad ? " (road)" : "") + "<small style='display:block;color:#6B7280'>" + (f.scopeLabel||f.scope||"UNKNOWN") + "</small></span></div>";
 }).join("");
 }, 150);
});
window.__flyToOsmResult = function(index){
 const f = osmCurrentMatches[index];
 if (!f) { return; }
 osmSearchPanel.style.display = "none";
 if (window.__srActiveRoute && typeof clearRoute === "function") { clearRoute(); }
 const selectedScope=f.scope||SafeRouteGeographicScope.classifyName(f.name);
 const selectedSource=f.scopeLabel||("OpenStreetMap · "+selectedScope);
 window.__srAiContext=window.__srAiContext||{};window.__srAiContext.selectedLocation={name:f.name,lat:f.lat,lon:f.lon,scope:selectedScope,source:selectedSource};window.__srAiContext.lastEvent="search selection";window.__srAiContext.updatedAt=new Date().toISOString();window.dispatchEvent(new CustomEvent("saferoute:context"));
 window.__srSelectedDestination={name:f.name,latitude:f.lat,longitude:f.lon,category:f.isRoad?"road":"place",source:selectedSource};
 if (window.__sr2dSetDestination) { window.__sr2dSetDestination(f.lat,f.lon); }
 if (window.__sr2dSetCenter) { window.__sr2dSetCenter(f.lat, f.lon, false, 14); }
 if (window.__sr2dGetView && window.__sr2dGetView().mode === "3d") {
  isProgrammaticCameraMove = true;
  viewer.camera.flyTo({
   destination: Cesium.Cartesian3.fromDegrees(f.lon, f.lat, 3000),
   duration: 2,
   complete: function(){ isProgrammaticCameraMove = false; },
   cancel: function(){ isProgrammaticCameraMove = false; }
  });
 }
 if (!window.__sr2dGetView || window.__sr2dGetView().mode === "3d") {
  addSearchResultMarker(f.lat, f.lon, f.name);
 }
};
// GOOGLE PHOTOREALISTIC 3D TILES
// Real mesh-based 3D geometry (buildings, terrain shape) — the same
// underlying data Google Earth itself uses. Per Google/Cesium's own
// guidance, the flat globe (imagery + terrain) is disabled above
// (globe: false) since this tileset fully replaces it as the ground
// surface. baseLayerPicker and sceneModePicker are disabled since
// they only apply to the flat globe, not this tileset.
// This loads AFTER the marker functions above are already defined,
// so Flutter's early GPS call is never blocked by this.
// ===================================================================
const loadingOverlay = document.getElementById("loadingOverlay");
const loadingText = document.getElementById("loadingText");
loadingText.textContent = "Loading 3D buildings and terrain...";
// ===================================================================
// PERFORMANCE FIX (confirmed root cause #1): Cesium.createGooglePhotorealistic3DTileset()
// defaults to cacheBytes = 1.5GB and maximumCacheOverflowBytes = 1GB when
// not explicitly set (confirmed by inspecting the bundled Cesium 1.143
// source — these are NOT the generic Cesium3DTileset defaults of 512MB,
// they are specifically higher for the photorealistic helper). That is a
// ~2.5GB tile-memory budget the tileset is allowed to grow into before
// the LRU cache starts aggressively evicting — completely unreasonable
// for an Android WebView. As the user pans across Kalimpong, multiple
// Sikkim locations, etc., tile memory climbs toward that huge ceiling,
// which lines up exactly with "fine for the first 1-2 minutes, then
// progressively worse." Setting an explicit, much smaller mobile-sized
// budget is the single highest-leverage fix confirmed in this pass.
// maximumScreenSpaceError is also raised from the default of 16 to 32 —
// a real, supported Cesium3DTileset property (confirmed present in the
// bundled Cesium 1.143 source) — trading a bit of visual detail for far
// fewer/lighter tiles in memory and on the GPU at any one time.
// ===================================================================
const MOBILE_TILE_CACHE_BYTES = 220 * 1024 * 1024; // 220MB active budget
const MOBILE_TILE_CACHE_OVERFLOW_BYTES = 80 * 1024 * 1024; // 80MB burst allowance
const MOBILE_MAX_SCREEN_SPACE_ERROR = 32;
// Set to true only for temporary investigation — this reproduces the
// per-network-request diagnostic wrapper that was left enabled in the
// code inspected during this pass. With it OFF (the default), every
// tile.googleapis.com request skips the extra camera-position lookup,
// string parsing, and console logging that was previously running on
// EVERY tile fetch — a cost that scales directly with how much the user
// has panned, and a second confirmed contributor to the progressive lag.
const ENABLE_NETWORK_DIAGNOSTICS = false;
try {
 const photorealisticTileset = await Cesium.createGooglePhotorealistic3DTileset({
 preloadFlightDestinations: true,
 cacheBytes: MOBILE_TILE_CACHE_BYTES,
 maximumCacheOverflowBytes: MOBILE_TILE_CACHE_OVERFLOW_BYTES,
 // preloadAncestors: verified default is already TRUE in Cesium 1.143
 // (confirmed in the bundled source) — set explicitly here only for
 // documentation clarity, not because the default was wrong. This is
 // what lets a lower-detail parent tile stay available as a fallback
 // while a higher-detail child streams in, avoiding a blank gap.
 preloadAncestors: true
 // preloadSiblings deliberately NOT enabled (verified default is
 // FALSE in Cesium 1.143). Turning it on makes the tileset proactively
 // request tiles for adjacent-but-not-yet-visible areas at the same
 // level — genuinely smoother if you then pan that direction, but it
 // directly works against the MOBILE_TILE_CACHE_BYTES budget above by
 // spending that budget on tiles the camera hasn't asked for yet. That
 // trade-off (smoother incidental panning vs. a larger working memory
 // footprint) is a real product decision, not a bug — left off by
 // default for the mobile memory budget this app is tuned for. Flip it
 // on here if device profiling shows headroom for it.
 });
 photorealisticTileset.maximumScreenSpaceError = MOBILE_MAX_SCREEN_SPACE_ERROR;
 // ===================================================================
 // REQUEST-SCHEDULING TUNING (classification B: properties confirmed to
 // exist and have the stated defaults by reading the bundled Cesium
 // 1.143 source directly — not assumed). createGooglePhotorealistic3DTileset
 // already defaults cullRequestsWhileMoving=true, dynamicScreenSpaceError=true,
 // and foveatedScreenSpaceError=true, which are all correct and are left
 // alone here rather than "randomly re-tuned" per the request not to
 // guess at values. The one deliberate change: cullRequestsWhileMovingMultiplier
 // defaults to 60, which is Cesium's general-purpose default and is not
 // tuned for a bandwidth/GPU-constrained mobile WebView specifically.
 // Lowering it makes the tileset more willing to skip/deprioritize
 // requesting tiles that are unlikely to still be on-screen once the
 // camera settles during continuous panning — directly implementing
 // "camera-movement backpressure" rather than requesting every tile the
 // camera sweeps past. This value is a reasoned mobile-appropriate
 // choice, not a blind guess, but its real-world effect has NOT been
 // measured on-device (classification D — needs real Android profiling).
 // ===================================================================
 photorealisticTileset.cullRequestsWhileMovingMultiplier = 30;
 viewer.scene.primitives.add(photorealisticTileset);
 console.log("Google Photorealistic 3D Tiles loaded (mobile cache budget + request backpressure applied)");
 // ===================================================================
 // CAMERA-MOTION ADAPTIVE QUALITY (classification: reasoned engineering
 // choice using confirmed-real Cesium 1.143 properties — cullRequestsWhileMoving
 // and maximumScreenSpaceError were both confirmed present in the bundled
 // Cesium source; this is not an invented API). This directly implements
 // the "prioritize responsiveness while moving, refine when idle" request:
 // while the camera is actively panning/zooming/rotating, screen-space
 // error is temporarily relaxed (coarser detail is considered acceptable,
 // so fewer/lighter tiles are requested and less GPU work is done per
 // frame). The instant the camera settles, the normal mobile detail
 // level is restored and Cesium's own progressive tile refinement fills
 // in higher detail — existing visible tiles are never destroyed or
 // forced to unload by this change, so there is no blank-flash or
 // content-disappearing risk; it only affects what NEW tile requests
 // are considered "detailed enough."
 // ===================================================================
 const SSE_IDLE = MOBILE_MAX_SCREEN_SPACE_ERROR; // 32 — normal mobile quality
 const SSE_MOVING = 56; // coarser while actively moving
 let cameraIsMoving = false;
 viewer.camera.moveStart.addEventListener(function(){
 if (!cameraIsMoving) {
 cameraIsMoving = true;
 photorealisticTileset.maximumScreenSpaceError = SSE_MOVING;
 }
 });
 viewer.camera.moveEnd.addEventListener(function(){
 cameraIsMoving = false;
 photorealisticTileset.maximumScreenSpaceError = SSE_IDLE;
 });
 // ===================================================================
 // TILE MEMORY TRIM ON MANUAL PAN (confirmed gap: trimLoadedTiles() is a
 // real Cesium3DTileset method — confirmed present in the bundled
 // Cesium 1.143 source — but nothing in the previously inspected code
 // ever called it, on flyTo or otherwise). Cesium's LRU cache only
 // evicts once totalMemoryUsageInBytes exceeds cacheBytes, and even then
 // only unloads tiles that are not currently needed for the visible
 // view. During long manual pan/zoom/drag sessions across many
 // viewports, calling trimLoadedTiles() after the camera settles forces
 // the cache to reconsider eviction against the current (smaller,
 // mobile-sized) budget instead of letting stale tiles from earlier
 // viewports linger. Debounced to fire only ~1s after motion stops, so
 // it never runs on every frame during active dragging.
 // ===================================================================
 let tileTrimDebounceHandle = null;
 viewer.camera.moveEnd.addEventListener(function(){
 if (tileTrimDebounceHandle) { clearTimeout(tileTrimDebounceHandle); }
 tileTrimDebounceHandle = setTimeout(function(){
 photorealisticTileset.trimLoadedTiles();
 }, 1000);
 });
 // ===================================================================
 // DIAGNOSTIC LOGGING ONLY — approved for investigation of the
 // repeated-flight rendering glitch. This block does NOT change any
 // rendering, cache, camera, quality, geocoder, or render-mode
 // behavior. Every line here is either console.log or console.error.
 // Gated behind ENABLE_NETWORK_DIAGNOSTICS (see above) — OFF by default
 // now that the real root causes have been confirmed and fixed.
 // ===================================================================
 // This whole diagnostic block (motion counters, tileUnload/tileFailed
 // listeners, and the fetch/XHR wrappers below) now only installs when
 // ENABLE_NETWORK_DIAGNOSTICS is true. Previously these ran unconditionally
 // on every camera moveEnd and every tile request — real, confirmed
 // per-interaction overhead that scaled with how much panning/zooming
 // the user had done, which is exactly the "gets laggier over time"
 // symptom reported.
 // ===================================================================
 let diagnosticMotionCounter = 0;
 if (ENABLE_NETWORK_DIAGNOSTICS) {
 let diagnosticUnloadCount = 0;
 photorealisticTileset.tileUnload.addEventListener(function(){
 diagnosticUnloadCount++;
 });
 viewer.camera.moveStart.addEventListener(function(){
 diagnosticMotionCounter++;
 const label = diagnosticMotionCounter === 1
 ? "FIRST FLIGHT/MOTION"
 : "REPEAT FLIGHT/MOTION #" + diagnosticMotionCounter;
 console.log("DIAGNOSTIC: === " + label + " STARTED ===");
 });
 viewer.camera.moveEnd.addEventListener(function(){
 const stats = photorealisticTileset.statistics;
 const label = diagnosticMotionCounter === 1
 ? "FIRST FLIGHT/MOTION"
 : "REPEAT FLIGHT/MOTION #" + diagnosticMotionCounter;
 console.log(
 "DIAGNOSTIC: === " + label + " ENDED === pending=" + stats.numberOfPendingRequests +
 " processing=" + stats.numberOfTilesProcessing +
 " readyTiles=" + stats.numberOfTilesWithContentReady +
 " unloadedTotal=" + diagnosticUnloadCount
 );
 const cam = viewer.camera.positionCartographic;
 console.log(
 "DIAGNOSTIC POSITION [motion #" + diagnosticMotionCounter + "] lon=" +
 Cesium.Math.toDegrees(cam.longitude).toFixed(6) + " lat=" +
 Cesium.Math.toDegrees(cam.latitude).toFixed(6) + " height=" + cam.height.toFixed(1)
 );
 });
 let diagnosticFailedTotal = 0;
 photorealisticTileset.tileFailed.addEventListener(function(error){
 diagnosticFailedTotal++;
 const cam = viewer.camera.positionCartographic;
 console.error(
 "DIAGNOSTIC: TILE FAILED during motion #" + diagnosticMotionCounter +
 " failedTotal=" + diagnosticFailedTotal +
 " url=" + error.url + " message=" + error.message +
 " camLon=" + Cesium.Math.toDegrees(cam.longitude).toFixed(6) +
 " camLat=" + Cesium.Math.toDegrees(cam.latitude).toFixed(6) +
 " camHeight=" + cam.height.toFixed(1)
 );
 });
 }
 // ===================================================================
 // DIAGNOSTIC FETCH WRAPPER — distinguishes:
 // - CESIUM_CANCELLED: promise rejected with error.name === "AbortError"
 // (Cesium's own RequestScheduler cancelling a stale request)
 // - NETWORK_FAILURE: promise rejected with any other error
 // - HTTP_ERROR: promise resolved, but response.ok is false (a real
 // HTTP status from Google we've never been able to see before)
 // - SUCCESS: promise resolved with response.ok true
 // This is a transparent proxy only — always calls through to the
 // real fetch and returns/re-throws its exact result unmodified, so
 // it cannot alter tile loading behavior. Only tile.googleapis.com
 // requests are logged; everything else passes through silently.
 // CONFIRMED COST: with Photorealistic 3D Tiles, tile.googleapis.com
 // requests can number in the hundreds during a few minutes of active
 // panning across viewports. Every one of those requests was paying
 // for a camera-position lookup, string parsing, and a console.log —
 // work that scales with exactly how much the user has moved around,
 // matching the reported "gets laggier the more you use it" symptom.
 // Now skipped entirely unless ENABLE_NETWORK_DIAGNOSTICS is turned on.
 // ===================================================================
 if (!ENABLE_NETWORK_DIAGNOSTICS) {
 // no-op: skip installing the fetch/XHR wrappers below entirely
 } else {
 const diagnosticOriginalFetch = window.fetch;
 window.fetch = function(input, init){
 const requestUrl = typeof input === "string" ? input : ((input && input.url) || "");
 if (requestUrl.indexOf("tile.googleapis.com") === -1) {
 return diagnosticOriginalFetch.apply(this, arguments);
 }
 const startTime = performance.now();
 const motionAtStart = diagnosticMotionCounter;
 let camLon = "N/A", camLat = "N/A", camHeight = "N/A";
 try {
 const cam = viewer.camera.positionCartographic;
 camLon = Cesium.Math.toDegrees(cam.longitude).toFixed(6);
 camLat = Cesium.Math.toDegrees(cam.latitude).toFixed(6);
 camHeight = cam.height.toFixed(1);
 } catch (camErr) { /* camera not ready yet, leave as N/A */ }
 const shortUrl = requestUrl.substring(
 requestUrl.lastIndexOf("/") + 1,
 requestUrl.indexOf("?") > -1 ? requestUrl.indexOf("?") : requestUrl.length
 );
 return diagnosticOriginalFetch.apply(this, arguments).then(function(response){
 const durationMs = (performance.now() - startTime).toFixed(0);
 console.log(
 "DIAGNOSTIC FETCH " + (response.ok ? "SUCCESS" : "HTTP_ERROR") +
 " status=" + response.status +
 " durationMs=" + durationMs +
 " motion=" + motionAtStart +
 " camLon=" + camLon + " camLat=" + camLat + " camHeight=" + camHeight +
 " url=" + shortUrl
 );
 return response;
 }).catch(function(fetchError){
 const durationMs = (performance.now() - startTime).toFixed(0);
 const wasCancelled = fetchError && fetchError.name === "AbortError";
 console.error(
 "DIAGNOSTIC FETCH " + (wasCancelled ? "CESIUM_CANCELLED" : "NETWORK_FAILURE") +
 " errorName=" + (fetchError && fetchError.name) +
 " errorMessage=" + (fetchError && fetchError.message) +
 " durationMs=" + durationMs +
 " motion=" + motionAtStart +
 " camLon=" + camLon + " camLat=" + camLat + " camHeight=" + camHeight +
 " url=" + shortUrl
 );
 throw fetchError;
 });
 };
 // ===================================================================
 // DIAGNOSTIC XHR WRAPPER — Phase 2. Determines whether tile requests
 // use XMLHttpRequest instead of fetch (Phase 1 found zero "DIAGNOSTIC
 // FETCH" log lines, meaning fetch is NOT the mechanism in use).
 // Transparent proxy only: always calls through to the real open/send,
 // only attaches listeners for logging, never alters request behavior.
 // Only tile.googleapis.com requests are logged.
 // ===================================================================
 const diagnosticOriginalXHROpen = XMLHttpRequest.prototype.open;
 const diagnosticOriginalXHRSend = XMLHttpRequest.prototype.send;
 XMLHttpRequest.prototype.open = function(method, url){
 this.__diagnosticUrl = url;
 this.__diagnosticIsTileRequest = typeof url === "string" && url.indexOf("tile.googleapis.com") !== -1;
 return diagnosticOriginalXHROpen.apply(this, arguments);
 };
 XMLHttpRequest.prototype.send = function(){
 if (!this.__diagnosticIsTileRequest) {
