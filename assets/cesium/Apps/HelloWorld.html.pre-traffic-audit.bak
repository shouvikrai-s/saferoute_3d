 if (window.__sr2dSetUser) { window.__sr2dSetUser(lat,lon); }
 const approxPosition = Cesium.Cartesian3.fromDegrees(lon, lat, 0);
 if (userMarkerEntity) {
 userMarkerEntity.position = approxPosition;
 } else {
 userMarkerEntity = viewer.entities.add({
 position: approxPosition,
 point: {
 pixelSize: new Cesium.CallbackProperty(function(time){
 const seconds = Cesium.JulianDate.secondsDifference(time, viewer.clock.startTime);
 return 12 + 8 * Math.abs(Math.sin(seconds * 2));
 }, false),
