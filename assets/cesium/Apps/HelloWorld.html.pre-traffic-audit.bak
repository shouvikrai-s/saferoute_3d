  searchTextObservable.subscribe(function(value){
   if (!value || !viewer.geocoder || !viewer.geocoder.viewModel || !viewer.geocoder.viewModel.destination) {
    return;
   }
   hookDestination(viewer.geocoder.viewModel.destination);
  });
