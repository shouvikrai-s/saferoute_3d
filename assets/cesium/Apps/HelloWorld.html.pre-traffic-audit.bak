 }
 });
 setInterval(function(){
 // photorealisticTileset is only defined after the try block below
 // resolves; guarded so the HUD works even before/if that fails.
 const ts = (typeof photorealisticTileset !== "undefined" && photorealisticTileset)
 ? photorealisticTileset.statistics
 : null;
 const lines = [
 "FPS: " + perfFps,
 "Entities: " + viewer.entities.values.length,
 "OSM active: " + (typeof osmActiveEntities !== "undefined" ? osmActiveEntities.size : "n/a"),
 "OSM cache: " + (typeof osmPlaceCache !== "undefined" ? osmPlaceCache.size : "n/a"),
 "Camera moving: " + (typeof cameraIsMoving !== "undefined" ? cameraIsMoving : "n/a"),
 ts ? ("Tiles ready: " + ts.numberOfTilesWithContentReady) : "Tiles ready: n/a",
 ts ? ("Tile requests pending: " + ts.numberOfPendingRequests) : "Tile pending: n/a",
 ts ? ("Tile mem: " + (ts.totalMemoryUsageInBytes ? (ts.totalMemoryUsageInBytes / 1048576).toFixed(1) + " MB" : "n/a")) : "Tile mem: n/a"
 ];
 perfHud.textContent = lines.join("\n");
 }, 500);
 console.log("Performance diagnostics HUD enabled");
}
// ===================================================================
// SEARCH RESULT MARKER
// Searching previously just flew the camera with no visual
// confirmation of what was found — unlike Google Maps, which always
// drops a labeled pin. This listens to the built-in geocoder's result
// and places a purple "S" pin with the searched name at that spot.
// ===================================================================
let searchResultEntity = null;
function addSearchResultMarker(lat, lon, label){
