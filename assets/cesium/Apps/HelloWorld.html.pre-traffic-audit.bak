 if(selected&&Number.isFinite(Number(selected.latitude))&&Number.isFinite(Number(selected.longitude))){
  addSearchResultMarker(Number(selected.latitude),Number(selected.longitude),selected.name||"Search result");
 }
};
try {
 if (viewer.geocoder && viewer.geocoder.viewModel) {
