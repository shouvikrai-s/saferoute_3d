  if (!Cesium.defined(destination)) { return; }
  let resultLat, resultLon;
  if (destination instanceof Cesium.Rectangle) {
   const center = Cesium.Rectangle.center(destination);
   resultLat = Cesium.Math.toDegrees(center.latitude);
   resultLon = Cesium.Math.toDegrees(center.longitude);
  } else if (destination instanceof Cesium.Cartesian3) {
   const cartographic = Cesium.Cartographic.fromCartesian(destination);
   resultLat = Cesium.Math.toDegrees(cartographic.latitude);
   resultLon = Cesium.Math.toDegrees(cartographic.longitude);
  } else {
   return;
  }
  const label = viewer.geocoder && viewer.geocoder.viewModel && viewer.geocoder.viewModel.searchText
    ? viewer.geocoder.viewModel.searchText
    : "Search result";
  if (window.__srActiveRoute && typeof clearRoute === "function") { clearRoute(); }
  window.__srSelectedDestination={name:label,latitude:resultLat,longitude:resultLon,category:"search",source:"Cesium geocoder"};
  addSearchResultMarker(resultLat, resultLon, label);
  window.__sr2dSetDestination && window.__sr2dSetDestination(resultLat, resultLon);
  window.__sr2dSetCenter && window.__sr2dSetCenter(resultLat, resultLon, true, 14);
