let trafficManager = null;
if (typeof window.SafeRouteTrafficManager === "function") {
 try {
  trafficManager = new window.SafeRouteTrafficManager().init(viewer, {
   backendTileUrl: trafficBackendUrl,
   clientKey: SAFEROUTE_CLIENT_KEY,
   diagnostics: true,
   enabled: false
