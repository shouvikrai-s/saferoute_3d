 } else {
 console.error("Geocoder destination observable not available — search result marker disabled, search itself still works normally");
 }
} catch (geocoderHookError) {
 console.error("Failed to attach search result marker hook (non-fatal — search itself still works normally)");
 console.error(geocoderHookError);
}
viewer.camera.flyTo({
 destination: Cesium.Cartesian3.fromDegrees(
 88.5122,
 27.3389,
 15000
 ),
 duration:3
});
console.log("Camera moved to Sikkim");
// ===================================================================
// IMPORTANT: these window functions are defined HERE, immediately
// after the viewer is created — NOT after the 3D tileset finishes
// loading below. Flutter calls window.flyToUserLocation as soon as
// the page finishes loading, which can happen well before the heavy
// 3D tileset download completes. If these were defined after that
// await, Flutter's call would arrive too early and silently fail
// (the function wouldn't exist yet) — that was the original bug.
// ===================================================================
let userMarkerEntity = null;
let lastUserLat = null;
let lastUserLon = null;
// Simple, reliable, immediate rendering. disableDepthTestDistance ensures
// the dot is always visible on top of the 3D tileset regardless of exact
// height match — reliability matters more than pixel-perfect elevation
// for a live position indicator.
// Places/updates the dot immediately at an approximate height (so it's
// never missing), then quietly refines to the REAL ground elevation in
// the background once known. Without this, the dot sits at height 0
// (sea level) while the actual terrain in Sikkim is much higher — since
// the dot always renders on top (disableDepthTestDistance), that height
// mismatch makes it appear to slide around as you zoom/pan, instead of
// staying locked to the real ground position.
// ===================================================================
// PERFORMANCE FIX (confirmed root cause #3): window.updateUserMarker
// (called by Flutter on every live GPS tick) previously called
// addOrUpdateUserMarker -> refineUserMarkerHeight -> an UNTHROTTLED
// viewer.scene.sampleHeightMostDetailed() on every single GPS update.
// That is an async terrain/tileset sample against the Photorealistic
// 3D Tiles for every GPS fix — with a typical GPS update interval of a
// few seconds, this adds up to dozens of these expensive queries per
// minute of active navigation, on top of everything else happening
// during panning. This did NOT match the "already throttled" claim
// from the prior investigation notes — it was confirmed unthrottled in
// the actual code. Now refined at most once every 3 seconds, and only
// if the user has moved a meaningful distance (>3m) since the last
// refine — the visible dot still updates its lat/lon immediately every
// tick, only the expensive terrain-height lookup is throttled.
// ===================================================================
