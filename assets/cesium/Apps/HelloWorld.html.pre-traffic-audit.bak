 <div id="aiModuleContent" aria-live="polite"></div>
</div>
<div id="srOffline" role="status" aria-live="polite">Offline. Search, rainfall and routing need a connection; safety data is unavailable until you reconnect.</div>
<nav id="srNav" aria-label="Main">
 <button id="navMap" aria-current="page"><svg class="sr-i" aria-hidden="true" focusable="false"><use href="#i-map"/></svg>Map</button>
 <button id="navExplore"><svg class="sr-i" aria-hidden="true" focusable="false"><use href="#i-compass"/></svg>Explore</button>
 <button id="navSafety"><svg class="sr-i" aria-hidden="true" focusable="false"><use href="#i-shield-check"/></svg>Safety</button>
</nav>
<script>
(function(){
 var $=function(i){return document.getElementById(i);};
 var SR_PANELS=["osmSearchPanel","weatherRiskPanel","permitPanel","helplinePanel","profilePanel","aiPanel","aiModulePanel","mapControlsPanel"];
 function hideAll(){ SR_PANELS.forEach(function(id){ $(id).style.display="none"; }); }
 function hideProfile(){ $("profilePanel").style.display="none"; $("aiPanel").style.display="none"; $("aiModulePanel").style.display="none"; }
 function sync(){
  var cur="navMap";
  if($("osmSearchPanel").style.display==="block") cur="navExplore";
  if($("weatherRiskPanel").style.display==="block") cur="navSafety";
  ["navMap","navExplore","navSafety"].forEach(function(id){ if(id===cur) $(id).setAttribute("aria-current","page"); else $(id).removeAttribute("aria-current"); });
 }
 SR_PANELS.forEach(function(id){
  new MutationObserver(sync).observe($(id),{attributes:true,attributeFilter:["style"]});
 });
 $("navMap").addEventListener("click",function(){ hideAll(); sync(); });
 $("navExplore").addEventListener("click",function(){ hideProfile(); if($("osmSearchPanel").style.display!=="block") $("osmSearchButton").click(); });
 $("navSafety").addEventListener("click",function(){ hideProfile(); if($("weatherRiskPanel").style.display!=="block") $("safetyChip").click(); });
 $("profileButton").addEventListener("click",function(){ var o=$("profilePanel").style.display==="block"; hideAll(); $("profilePanel").style.display=o?"none":"block"; });
 $("mapControlsButton").addEventListener("click",function(){ var o=$("mapControlsPanel").style.display==="block"; hideAll(); $("mapControlsPanel").style.display=o?"none":"block"; sync(); });
 function openAiCenter(){
  hideAll(); $("aiPanel").style.display="block"; sync();
  var live=SafeRouteAIEngine.live(), rows=[["MAP",SafeRouteAIEngine.map()],["ROUTE",live.route],["TRAFFIC",live.traffic],["WEATHER",live.weather],["FLOOD",live.flood],["DAM",live.dam],["HAZARDS",live.hazards],["LANDSLIDE",SafeRouteAIEngine.landslide()],["SAFETY",SafeRouteAIEngine.safety()],["TOURISM",SafeRouteAIEngine.tourism()],["EMERGENCY",SafeRouteAIEngine.emergency()],["GPS",live.gps]];
  $("aiCenterSummary").textContent="";
  var note=document.createElement("span"); note.className="sr-tag"; note.textContent="LOCAL RULES · NOT A TRAINED AI MODEL"; $("aiCenterSummary").appendChild(note);
  rows.forEach(function(row){ var d=document.createElement("div"); d.className="sr-control-row"; var c=document.createElement("div"); c.className="sr-control-copy"; var s=document.createElement("strong"); s.textContent=row[0]+" · "+row[1].status; var v=document.createElement("small"); v.textContent="Checked "+row[1].timestamp+" · "+row[1].reason; c.appendChild(s); c.appendChild(v); d.appendChild(c); $("aiCenterSummary").appendChild(d); });
 }
 $("aiMonitorButton").addEventListener("click",openAiCenter);
 $("mapAiMonitorButton").addEventListener("click",openAiCenter);
 $("mapControlsClose").addEventListener("click",function(){ $("mapControlsPanel").style.display="none"; sync(); });
 $("trafficToggle").addEventListener("click",function(){
  if (!window.__srTrafficManager) return;
  var enabled = !window.__srTrafficManager.enabled;
  window.__srTrafficManager.setEnabled(enabled);
  this.setAttribute("aria-pressed",String(enabled));
  this.textContent = enabled ? "Shown" : "Hidden";
  window.__srUpdateTrafficLegend();
 });
 $("profileClose").addEventListener("click",hideProfile);
 ["safetyChip","helplineButton","permitButton"].forEach(function(id){ $(id).addEventListener("click",hideProfile,true); });
 $("profileOpenAI").addEventListener("click",function(){ hideAll(); $("aiPanel").style.display="block"; });
 $("aiClose").addEventListener("click",function(){ $("aiPanel").style.display="none"; });
 $("aiModuleClose").addEventListener("click",function(){ $("aiModulePanel").style.display="none"; });
 document.addEventListener("keydown",function(e){ if(e.key==="Escape"){ hideAll(); sync(); } });
 function aiValue(selector, fallback){
  var node=$(selector); return node && node.textContent.trim() ? node.textContent.trim() : fallback;
 }
 function trafficEvidence(manager){
  var now=Date.now(),samples=0,tileCount=0,newest=0;
  if(manager&&manager.cache){manager.cache.forEach(function(entry){
   var data=entry.data;
   if(!data||!data.decoded||!Array.isArray(data.features)||!entry.timestamp)return;
   tileCount++;newest=Math.max(newest,Number(entry.timestamp)||0);
   data.features.forEach(function(feature){
    var value=Number(feature.properties&&feature.properties.relative_speed);
    if(Number.isFinite(value)&&value>=0&&value<=1)samples++;
   });
  });}
  return {samples:samples,tileCount:tileCount,newest:newest,ageMs:newest?now-newest:Infinity};
 }
 function aiTrafficState(){
  var manager=window.__srTrafficManager;
  if(!manager) return {state:"UNAVAILABLE",detail:"Traffic manager unavailable"};
  var evidence=trafficEvidence(manager),ttl=manager.options&&manager.options.tileTtlMs||120000;
  if(evidence.samples>0){
   if(evidence.ageMs>ttl)return {state:"STALE",detail:evidence.samples+" decoded observation(s) from "+evidence.tileCount+" cached tile(s) are older than "+Math.round(ttl/1000)+"s; not rendered as current"};
   var state=manager.enabled?"RECENT":"CACHED";
   return {state:state,detail:evidence.samples+" decoded relative_speed observation(s) from "+evidence.tileCount+" tile(s); age "+Math.max(0,Math.round(evidence.ageMs/1000))+"s"};
  }
  if(manager.stats&&manager.stats.failed>0)return {state:"ERROR",detail:"Traffic tile requests failed; no usable relative_speed observations"};
  if(manager.stats&&manager.stats.loaded>0)return {state:"UNAVAILABLE",detail:"Tiles loaded but contained no usable fresh decoded relative_speed observations"};
  if(manager.enabled&&(manager.activeRequests>0||manager.queue.length>0))return {state:"PROCESSING",detail:"Waiting for validated traffic observations"};
  return {state:"UNAVAILABLE",detail:manager.enabled?"No usable traffic observations loaded":"Traffic layer is off"};
 }
 window.__srUpdateTrafficLegend=function(){
  var legend=document.getElementById("srTrafficLegend"),freshness=document.getElementById("srTrafficFreshness"),manager=window.__srTrafficManager;
  if(!legend||!freshness)return;
  var enabled=Boolean(manager&&manager.enabled);
  legend.setAttribute("aria-hidden",String(!enabled));
  var evidence=trafficEvidence(manager),state=aiTrafficState();
  if(!enabled){freshness.textContent="Traffic layer off · no segments colored.";return;}
  if(state.state==="STALE"){freshness.textContent="STALE · "+state.detail+" · gray/no current segment coverage." ;return;}
  if(evidence.samples>0){freshness.textContent=state.state+" · "+evidence.samples+" valid observation(s), "+evidence.tileCount+" tile(s) · newest proxy receipt "+Math.max(0,Math.round(evidence.ageMs/1000))+"s ago · "+state.detail;return;}
  freshness.textContent=state.state+" · "+state.detail+" · Unobserved roads are not classified.";
 };
 function aiWeatherState(){
  var value=aiValue("#safetyChipText","Unavailable");
  var weather=window.SafeRouteAIEngine&&window.SafeRouteAIEngine.weather();
  if(weather&&weather.status) return {state:weather.status,value:value};
  if(value.indexOf("Checking")===0) return {state:"PROCESSING",value:value};
  return {state:navigator.onLine?"UNAVAILABLE":"OFFLINE",value:value};
 }
 function LocalDataGroundedEngine(){
  this.name="LocalDataGroundedEngine";
 }
 LocalDataGroundedEngine.prototype.now=function(){return new Date().toISOString();};
 LocalDataGroundedEngine.prototype.result=function(status,severity,confidence,risk,reason,recommendation,affectedArea,sources){
  return {status:status,severity:severity,risk:risk,reason:reason,recommendation:recommendation,affectedArea:affectedArea,timestamp:this.now(),sources:sources||[]};
 };
 LocalDataGroundedEngine.prototype.traffic=function(){
  var manager=window.__srTrafficManager, samples=[], evidence=trafficEvidence(manager);
  if(manager&&manager.cache){ manager.cache.forEach(function(entry){ var data=entry.data;if(!data||!data.decoded||!Array.isArray(data.features)||!entry.timestamp||Date.now()-entry.timestamp>(manager.options&&manager.options.tileTtlMs||120000))return;(data.features||[]).forEach(function(f){var v=Number(f.properties&&f.properties.relative_speed);if(Number.isFinite(v)&&v>=0&&v<=1)samples.push(v);}); }); }
  if(!manager||evidence.samples===0||samples.length===0) return this.result("UNAVAILABLE","UNKNOWN",0,"UNKNOWN","No fresh, validated TomTom relative_speed samples are currently available.","Gray indicates missing, invalid, or expired traffic evidence; enable Traffic and wait for a valid tile response.","No fresh traffic tiles",["TomTom Traffic Flow"]);
  var avg=samples.reduce(function(a,b){return a+b;},0)/samples.length, severe=samples.filter(function(v){return v<0.25;}).length, moderate=samples.filter(function(v){return v>=0.25&&v<0.8;}).length;
  var severity=avg<0.25?"SLOW":avg<0.8?"REDUCED":"FLOWING";
  var ttl=manager.options&&manager.options.tileTtlMs||120000,status=evidence.ageMs>ttl?"STALE":manager.enabled?"LIVE":"CACHED";
  return this.result(status,severity,0,"UNKNOWN",samples.length+" fresh decoded relative_speed observation(s) across "+evidence.tileCount+" tile(s); "+severe+" are below 0.25 and "+moderate+" are between 0.25 and 0.80. These are tile-feature observations, not district-wide road coverage. Newest tile age "+Math.max(0,Math.round(evidence.ageMs/1000))+"s.","Use only colored observed segments; unobserved/stale segments remain gray. This app's relative-speed bands are not TomTom incident alerts.",""+evidence.tileCount+" fresh tile(s)",["TomTom Traffic Flow relative_speed · tile timestamps are proxy receipt times"]);
 };
 LocalDataGroundedEngine.prototype.weather=function(){
  var weather=window.__srLatestWeatherResults||[],fetchedAt=Date.parse(window.__srWeatherFetchedAt||""),age=Date.now()-fetchedAt;
  if(weather.length===0) return this.result("UNAVAILABLE","UNKNOWN",0,"UNKNOWN","No current rainfall readings are available.","Retry the existing weather check before assessing weather impact.","Weather locations",["Open-Meteo current precipitation"]);
  var max=weather.reduce(function(a,b){return Math.max(a,Number(b.precipitation)||0);},0), severity=max>=10?"HIGH":max>0?"MEDIUM":"LOW";
  var status=!Number.isFinite(fetchedAt)?"STALE":age>900000?"STALE":"LIVE";
  return this.result(status,severity,0,severity==="HIGH"?"HIGH":severity==="MEDIUM"?"MEDIUM":"LOW","Open-Meteo current precipitation readings; peak reported value is "+max.toFixed(1)+" mm. Data age "+(Number.isFinite(age)?Math.max(0,Math.round(age/1000))+"s":"unknown")+".",""+(severity==="HIGH"?"Avoid unnecessary travel and check official alerts.":"Proceed while monitoring current rainfall."),"Weather locations with current readings",["Open-Meteo current precipitation"]);
 };
 LocalDataGroundedEngine.prototype.flood=function(){
  var source=window.__srMonitoring&&window.__srMonitoring.flood,weather=this.weather(),hazards=this.hazards();
  if(source&&(source.status==="LIVE"||source.status==="MODEL")) {
   var risk=source.severity||source.classification||"LOW";
   var mode=source.status==="LIVE"?"LIVE":"MODEL";
   return this.result(mode,risk,0,risk,source.summary,"This is a model-based discharge forecast, not an official flood alert.",source.area||"Sikkim",source.sources||[]);
  }
  if(weather.status==="LIVE"||hazards.status!=="UNAVAILABLE"){var risk=weather.risk==="HIGH"?"HIGH":weather.risk==="MEDIUM"?"MODERATE":"UNKNOWN";return this.result("INFERRED",risk,0,risk,"No verified live flood feed is configured. "+(weather.status==="LIVE"?"Current rainfall is contextual evidence;":"Rainfall evidence is not current.")+" Dated hazard references are not flood observations. This does not assert flooding or flood absence.","Consult official Sikkim disaster-management alerts.","Current Sikkim map/route context",["Open-Meteo current precipitation","SafeRoute dated hazard references"]);} 
  return this.result("UNAVAILABLE","UNKNOWN",0,"INSUFFICIENT DATA","FLOOD DATA UNAVAILABLE: no verified live flood feed or contextual evidence is available.","Consult official Sikkim disaster-management alerts.","Sikkim",source&&source.sources||[]);
 };
 LocalDataGroundedEngine.prototype.dam=function(){
  var source=window.__srMonitoring&&window.__srMonitoring.dam,weather=this.weather(),hazards=this.hazards();
  if(source&&source.status==="LIVE") return this.result("LIVE",source.severity,0,source.severity,source.summary,"Monitor the named provider.",source.area,source.sources);
  if(weather.status==="LIVE"||hazards.status!=="UNAVAILABLE"){var risk=weather.risk==="HIGH"?"HIGH":weather.risk==="MEDIUM"?"MODERATE":"UNKNOWN";return this.result("INFERRED",risk,0,risk,"DAM LIVE DATA UNAVAILABLE. "+(weather.status==="LIVE"?"Current rainfall is contextual evidence;":"Rainfall evidence is not current.")+" Dated hazard references do not indicate dam status. No reservoir level, discharge, release, or gate-status data is available.","Static dam markers are geographic reference only; monitor an official operator or authority.","Current Sikkim map/route context",["Open-Meteo current precipitation","SafeRoute dated hazard references"]);} 
  return this.result("UNAVAILABLE","UNKNOWN",0,"INSUFFICIENT DATA","DAM LIVE DATA UNAVAILABLE: no verified provider feed or contextual evidence is available.","Static dam markers are reference-only, not monitoring.","Sikkim",source&&source.sources||[]);
 };
 LocalDataGroundedEngine.prototype.hazards=function(){
  var zones=window.__srHazardZones||[], route=window.__srActiveRoute, routeHits=[];
  if(!zones.length)return this.result("UNAVAILABLE","UNKNOWN",0,"UNKNOWN","No verified hazard reference zones are available in this session.","Consult current official advisories; no hazard absence is implied.","Sikkim",[]);
  if(route&&route.coordinates){ var distance=function(lat1,lon1,lat2,lon2){var r=6371,dLat=(lat2-lat1)*Math.PI/180,dLon=(lon2-lon1)*Math.PI/180,a=Math.sin(dLat/2)*Math.sin(dLat/2)+Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)*Math.sin(dLon/2);return 2*r*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));}; zones.forEach(function(zone){ var hit=route.coordinates.some(function(c){return distance(zone.lat,zone.lon,c[1],c[0])<=zone.radiusKm;}); if(hit) routeHits.push(zone.name); }); }
  return this.result("STALE",routeHits.length?"REFERENCE OVERLAP":"REFERENCE DATA",0,"UNKNOWN",zones.length+" dated hazard reference zone(s) are loaded; "+(routeHits.length?routeHits.length+" reference zone(s) overlap the current route geometry.":"no route overlap is established.")+" These are not current incident observations.","Verify current official advisories; reference data cannot establish present hazard conditions.",zones.length+" dated reference zone(s)",["SafeRoute hazard reference data","Route geometry when active"]);
 };
 LocalDataGroundedEngine.prototype.route=function(){
  var route=window.__srActiveRoute;
  if(!route) return this.result("UNAVAILABLE","UNKNOWN",0,"UNKNOWN","No active GraphHopper route is available.","Calculate a route before requesting route intelligence.","No active route",["GraphHopper route response"]);
  var t=this.traffic(),w=this.weather(),h=this.hazards(),high=t.risk==="HIGH"||w.risk==="HIGH",moderate=t.risk==="MEDIUM"||w.risk==="MEDIUM",currentTraffic=t.status==="LIVE"||t.status==="CACHED",currentWeather=w.status==="LIVE",hasEvidence=currentTraffic||currentWeather,risk=high?"HIGH":moderate?"MODERATE":currentTraffic&&currentWeather&&t.risk==="LOW"&&w.risk==="LOW"?"LOW":"UNKNOWN";
  return this.result(hasEvidence?"INFERRED":"UNAVAILABLE",risk,risk,risk,"GraphHopper route distance is "+(route.totalDistanceM/1000).toFixed(2)+" km and estimated duration is "+Math.round(route.totalTimeMs/60000)+" min. "+(h.reason)+" Current traffic/weather evidence is used where available; missing or dated sources are not treated as clear.","Review current official information before travel; missing evidence means risk is unknown.","Current route destination and provider geometry",["GraphHopper route response",currentTraffic?"TomTom relative_speed observations":"Traffic unavailable",currentWeather?"Open-Meteo current precipitation":"Weather unavailable",h.status!=="UNAVAILABLE"?"SafeRoute dated hazard references":"Hazards unavailable"]);
 };
 LocalDataGroundedEngine.prototype.landslide=function(){
  var weather=this.weather(),hazards=this.hazards();
  if(weather.status!=="LIVE"&&hazards.status==="UNAVAILABLE")return this.result("UNAVAILABLE","UNKNOWN",0,"UNKNOWN","No verified live landslide feed or current rainfall evidence is available. This app cannot confirm or predict landslides.","Check official disaster-management alerts and local authorities.","Sikkim",[]);
  var risk=weather.status==="LIVE"&&weather.risk==="HIGH"?"HIGH":weather.status==="LIVE"&&weather.risk==="MEDIUM"?"MODERATE":"UNKNOWN";
  return this.result("INFERRED",risk,risk,"No live landslide observations or prediction provider is configured. "+(weather.status==="LIVE"?"Current Open-Meteo rainfall is contextual evidence;":"Rainfall evidence is not current.")+" Dated hazard references are not incident reports.","Do not treat this screening as a landslide warning; check current official alerts.","Current rainfall and dated reference zones",["Open-Meteo current precipitation","SafeRoute hazard reference data"]);
 };
 LocalDataGroundedEngine.prototype.gps=function(){
  var location=window.__srUserLocation;
  if(!location)return this.result("UNAVAILABLE","UNKNOWN",0,"UNKNOWN","No GPS fix has been received from the device bridge.","Enable device location and grant permission to the app.","Device location",["Flutter GPS bridge"]);
  return this.result("LIVE","UNKNOWN",0,"UNKNOWN","A device GPS position was received at "+location.lat.toFixed(5)+", "+location.lon.toFixed(5)+(location.timestamp?" · fix time "+location.timestamp:"")+".","Position availability is confirmed; GPS accuracy and emergency reachability are not independently assessed.","Device GPS position",["Flutter GPS bridge"]);
 };
 LocalDataGroundedEngine.prototype.map=function(){
  var traffic=this.traffic(), weather=this.weather(), hazards=this.hazards(), context=window.__srAiContext||{},view=context.viewport,gps=Boolean(window.__srUserLocation),selected=context.selectedLocation;
  var area=selected?selected.name+" · "+selected.scope:(view?view.lat.toFixed(3)+", "+view.lon.toFixed(3)+" · zoom "+view.zoom:(gps?window.__srUserLocation.lat.toFixed(3)+", "+window.__srUserLocation.lon.toFixed(3):"Map location unavailable"));
  var high=traffic.risk==="HIGH"||weather.risk==="HIGH",currentTraffic=traffic.status==="LIVE"||traffic.status==="CACHED",currentWeather=weather.status==="LIVE",risk=high?"HIGH":currentTraffic&&currentWeather&&traffic.risk==="LOW"&&weather.risk==="LOW"?"LOW":"UNKNOWN";
  return this.result(view||gps?"INFERRED":"UNAVAILABLE",risk,risk,"Map context is "+area+"; last map event: "+(context.lastEvent||"none")+". "+traffic.reason+" "+hazards.reason,"Use the selected/current viewport context and review source-labelled information; missing observations do not imply safe conditions.",area,["2D viewport","Selected search location","GPS when available","TomTom Traffic Flow","Open-Meteo","SafeRoute hazard data"]);
 };
 LocalDataGroundedEngine.prototype.safety=function(){
  var r=this.route(),m=this.map(),flood=this.flood(),dam=this.dam(),resources=(window.__srResourceData||[]).filter(function(x){return x.type==="hospital"||x.type==="police";}),high=r.risk==="HIGH"||m.risk==="HIGH"||flood.risk==="HIGH"||dam.risk==="HIGH",moderate=r.risk==="MODERATE"||m.risk==="MODERATE"||flood.risk==="MODERATE"||dam.risk==="MODERATE",risk=high?"HIGH":moderate?"MODERATE":r.risk==="LOW"&&m.risk==="LOW"?"LOW":"UNKNOWN";
  return this.result(r.status==="INFERRED"||m.status==="INFERRED"?"INFERRED":"UNAVAILABLE",risk,risk,"Combined route/map context and available rainfall, traffic, hazard-reference, and emergency-resource evidence. "+flood.reason+" "+dam.reason,"Keep emergency numbers available and follow verified guidance; unavailable data is not a safe finding.","Built-in hospital/police references: "+resources.length,["GraphHopper","TomTom Traffic Flow","Open-Meteo","SafeRoute hazards","Flood source status","Dam source status"]);
 };
 LocalDataGroundedEngine.prototype.tourism=function(){
  var places=window.__srTourismPlaces||[],w=this.weather(),updated=Number(window.__srTourismPlacesUpdatedAt)||0,age=updated?Date.now()-updated:Infinity,status=places.length?(age>120000?"STALE":"RECENT"):"UNAVAILABLE",risk=places.length&&w.status==="LIVE"?(w.risk==="HIGH"?"HIGH":"LOW"):"UNKNOWN";
  return this.result(status,risk,risk,places.length?places.length+" OpenStreetMap tourism place(s) were returned for the current view; weather status is "+w.status+".":"No current-view tourism results are available. Static reference locations are not presented as live results.","Use source-labelled Explore results and verify permits/restrictions before travel.","Current map view · "+places.length+" tourism result(s)",places.length?["OpenStreetMap current-view query",w.status==="LIVE"?"Open-Meteo":"Weather unavailable"]:[]);
 };
 LocalDataGroundedEngine.prototype.emergency=function(){
  var resources=(window.__srResourceData||[]).filter(function(x){return x.type==="hospital"||x.type==="police";}), h=this.hazards();
  return this.result(resources.length?"STALE":"UNAVAILABLE",h.status==="UNAVAILABLE"?"UNKNOWN":h.risk,h.status==="UNAVAILABLE"?"UNKNOWN":h.risk,resources.length+" built-in hospital/police reference(s) are listed; current staffing, availability, and response status are not verified. "+h.reason,"Use Emergency & Help to contact services directly; these references do not confirm availability.","Built-in reference locations: "+resources.length,["SafeRoute reference data","SafeRoute hazard reference data"]);
 };
 LocalDataGroundedEngine.prototype.live=function(){return {traffic:this.traffic(),weather:this.weather(),flood:this.flood(),dam:this.dam(),hazards:this.hazards(),landslide:this.landslide(),gps:this.gps(),route:this.route()};};
 var SafeRouteAIEngine=new LocalDataGroundedEngine();
 window.SafeRouteAIEngine=SafeRouteAIEngine;
 var trafficModelState={status:"UNAVAILABLE",result:null,error:"Rules analysis has not been requested.",inferenceTimestamp:null,attemptedAt:0};
 var trafficModelRequest=null;
 function trafficModelInput(){
  var manager=window.__srTrafficManager, observations=[],now=Date.now(),ttl=manager&&manager.options&&manager.options.tileTtlMs||120000,newest=0;
  if(manager&&manager.cache){ manager.cache.forEach(function(entry){ if(!entry.data||!entry.data.decoded||!entry.timestamp||now-entry.timestamp>ttl)return;var before=observations.length;(entry.data.features||[]).forEach(function(feature){ var value=feature.properties&&feature.properties.relative_speed; if(typeof value==="number"&&Number.isFinite(value)&&value>=0&&value<=1&&observations.length<500){ observations.push({relativeSpeed:value}); } });if(observations.length>before)newest=Math.max(newest,entry.timestamp); }); }
  return {task:"traffic",source:"TomTom Traffic Flow",observedAt:newest?new Date(newest).toISOString():null,observations:observations,routeRelationship:null};
 }
 function requestTrafficModel(){
  if(trafficModelRequest) return trafficModelRequest;
  var input=trafficModelInput();
  if(input.observations.length<3){ trafficModelState={status:"UNAVAILABLE",result:null,error:"Insufficient current decoded relative_speed observations for traffic rules.",inferenceTimestamp:null,attemptedAt:Date.now()}; return Promise.resolve(null); }
  trafficModelState={status:"PROCESSING",result:null,error:"",inferenceTimestamp:null,attemptedAt:Date.now()};
  var controller=new AbortController(), timer=setTimeout(function(){controller.abort();},4000);
  trafficModelRequest=fetch(window.__srBackendOrigin+"/api/ai/analyze",{method:"POST",headers:{"Content-Type":"application/json","X-SafeRoute-Client-Key":SAFEROUTE_CLIENT_KEY},body:JSON.stringify(input),signal:controller.signal})
   .then(function(response){return response.json().then(function(body){if(!response.ok) throw new Error(body.message||"Traffic rules request failed."); return body;});})
   .then(function(body){
    var result=body&&body.result;
    if(!result||result.model!=="SafeRouteTrafficKMeans"||result.status!=="INFERRED"||!result.congestionClass||!result.inferenceTimestamp){throw new Error("Traffic rules response failed validation.");}
    trafficModelState={status:"INFERRED",result:result,error:"",inferenceTimestamp:result.inferenceTimestamp,attemptedAt:Date.now()}; return result;
   })
   .catch(function(error){trafficModelState={status:"ERROR",result:null,error:error.name==="AbortError"?"Traffic rules request timed out.":error.message||"Traffic rules unavailable.",inferenceTimestamp:null,attemptedAt:Date.now()}; return null;})
   .finally(function(){clearTimeout(timer); trafficModelRequest=null;});
  return trafficModelRequest;
 }
 window.SafeRouteAIModel={traffic:requestTrafficModel,getState:function(){return trafficModelState;}};
 var modelStates={};
 var modelRequests={};
 function riskNumber(value){ return value==="CRITICAL"?1:value==="HIGH"?0.8:value==="MEDIUM"||value==="MODERATE"?0.5:value==="LOW"||value==="LIGHT"?0.1:null; }
 function modelInput(key){
  var live=SafeRouteAIEngine.live(), weather=SafeRouteAIEngine.weather(), hazards=SafeRouteAIEngine.hazards(), traffic=SafeRouteAIEngine.traffic(), route=SafeRouteAIEngine.route(), resources=(window.__srResourceData||[]).filter(function(x){return x.type==="hospital"||x.type==="police";});
  var features;
  if(key==="route") features={distanceKm:window.__srActiveRoute?window.__srActiveRoute.totalDistanceM/1000:0,durationMin:window.__srActiveRoute?window.__srActiveRoute.totalTimeMs/60000:0,trafficRisk:riskNumber(traffic.risk),weatherRisk:riskNumber(weather.risk),hazardRisk:riskNumber(hazards.risk)};
  else if(key==="weather"){var readings=window.__srLatestWeatherResults||[];features={precipitation:readings.length?Math.max.apply(null,readings.map(function(x){return Number(x.precipitation)||0;})):0};}
  else if(key==="hazards"){var hits=hazards.reason.indexOf("overlap the current route geometry")>=0?1:0;features={verifiedCount:(window.__srHazardZones||[]).length,routeHits:hits,precipitation:(window.__srLatestWeatherResults||[]).reduce(function(a,b){return Math.max(a,Number(b.precipitation)||0);},0)};}
  else if(key==="safety") features={trafficRisk:riskNumber(traffic.risk),weatherRisk:riskNumber(weather.risk),hazardRisk:riskNumber(hazards.risk),resourceCount:resources.length};
  else if(key==="map") features={gpsAvailable:window.__srUserLocation?1:0,trafficRisk:riskNumber(traffic.risk),weatherRisk:riskNumber(weather.risk),resourceCount:resources.length};
  else if(key==="tourism") features={placeCount:(window.__srTourismPlaces||[]).length,weatherRisk:riskNumber(weather.risk)};
  else if(key==="emergency") features={resourceCount:resources.length,hazardRisk:riskNumber(hazards.risk),routeAvailable:window.__srActiveRoute?1:0};
  return {task:key,features:features,inputTimestamp:new Date().toISOString(),dataState:live[key]?live[key].status:"CURRENT",sourceCount:(traffic.status==="LIVE"?1:0)+(weather.status==="LIVE"?1:0)+(hazards.status!=="UNAVAILABLE"?1:0),dataQuality:live[key]?live[key].status:"CURRENT"};
 }
 function requestModelTask(key){
  if(key==="traffic") return requestTrafficModel();
  if(modelRequests[key]) return modelRequests[key];
  var input=modelInput(key);
  var unavailableReason="";
  if(key==="route"&&!window.__srActiveRoute) unavailableReason="No active GraphHopper route is available.";
  else if(key==="weather"&&(weather.status!=="LIVE"||!(window.__srLatestWeatherResults||[]).length)) unavailableReason="No current weather readings are available.";
  else if((key==="map"||key==="safety"||key==="route")&&(traffic.status==="UNAVAILABLE"||weather.status==="UNAVAILABLE"||hazards.status==="UNAVAILABLE")) unavailableReason="Current traffic, weather, or hazard inputs are insufficient for this rules analysis.";
  else if(key==="map"&&!window.__srAiContext) unavailableReason="Current map context is unavailable.";
  else if(key==="emergency"&&(hazards.status==="UNAVAILABLE"||riskNumber(hazards.risk)===null)) unavailableReason="No numeric current hazard assessment is available; emergency availability cannot be inferred from reference data.";
  else if(key==="hazards"&&(!(window.__srHazardZones||[]).length||weather.status!=="LIVE"||!(window.__srLatestWeatherResults||[]).length)) unavailableReason="Verified hazard references and current rainfall readings are required.";
  else if(key==="weather"&&(!(window.__srLatestWeatherResults||[]).length)) unavailableReason="No current weather readings are available.";
  else if(key==="tourism"&&(weather.status!=="LIVE"||!(window.__srLatestWeatherResults||[]).length)) unavailableReason="Current weather readings are required to assess tourism conditions.";
  else if(input.features&&Object.keys(input.features).some(function(name){return input.features[name]===null||!Number.isFinite(input.features[name]);})) unavailableReason="One or more required values are unknown; no numeric default will be substituted.";
  if(unavailableReason){modelStates[key]={status:"UNAVAILABLE",result:null,error:unavailableReason};return Promise.resolve(null);}
  if(key==="tourism"&&input.features.placeCount===0){modelStates[key]={status:"UNAVAILABLE",result:null,error:"No verified tourism records are available in the current map scope."};return Promise.resolve(null);}
  modelStates[key]={status:"PROCESSING",result:null,error:""};
  var controller=new AbortController(), timer=setTimeout(function(){controller.abort();},4000);
  modelRequests[key]=fetch(window.__srBackendOrigin+"/api/ai/analyze",{method:"POST",headers:{"Content-Type":"application/json","X-SafeRoute-Client-Key":SAFEROUTE_CLIENT_KEY},body:JSON.stringify(input),signal:controller.signal})
   .then(function(response){return response.json().then(function(body){if(!response.ok)throw new Error(body.message||"Rules analysis request failed.");return body;});})
   .then(function(body){var result=body&&body.result;if(!result||result.task!==key||result.status!=="INFERRED"||!result.modelVersion||!result.explanation)throw new Error("Rules analysis response failed validation.");modelStates[key]={status:"INFERRED",result:result,error:""};return result;})
   .catch(function(error){modelStates[key]={status:"ERROR",result:null,error:error.name==="AbortError"?"Rules analysis request timed out.":error.message||"Rules analysis unavailable."};return null;})
   .finally(function(){clearTimeout(timer);modelRequests[key]=null;});
  return modelRequests[key];
 }
 window.SafeRouteAIModel.analyze=function(key){return requestModelTask(key);};
 window.SafeRouteAIModel.states=modelStates;
 var aiModules={
  map:{title:"AI MAP", rows:[["Status","NOT CONFIGURED"],["Last Update","No AI analysis"],["Coverage","Current map state available; AI service unavailable"],["Analysis","No inference performed"],["Recommendation","Use Map Controls and verified map layers"]]},
  route:{title:"AI ROUTE", rows:[["Status","NOT CONFIGURED"],["Current Route",function(){return aiValue("#routeInfoText","No active route");}],["Risk","No AI risk assessment"],["Traffic Impact","No AI assessment"],["Weather Impact","No AI assessment"],["Hazard Impact","No AI assessment"],["Recommendation","GraphHopper remains the deterministic routing engine"]]},
  traffic:{title:"AI TRAFFIC", rows:[["Status",function(){return aiTrafficState().state}],["Last Update",function(){var m=window.__srTrafficManager;return m&&m.stats&&m.stats.loaded>0?"Current session":"No validated tile update"}],["Coverage",function(){return aiTrafficState().detail}],["Congestion Areas","Awaiting observation analysis"],["Analysis","Open AI Traffic to run deterministic clustering rules on current decoded observations"],["Recommendation","No trained traffic prediction model is connected"]]},
  weather:{title:"AI WEATHER", rows:[["Status",function(){return aiWeatherState().state}],["Current Conditions",function(){return aiWeatherState().value}],["Rainfall",function(){return aiWeatherState().value}],["Forecast Data","Not configured"],["Risk Analysis","No AI forecast analysis"],["Recommendation","Verify conditions against the current weather panel"]]},
  hazards:{title:"AI HAZARDS", rows:[["Status","NOT CONFIGURED"],["Active Hazards","No AI-confirmed hazards"],["Road Risk","Not analyzed"],["Flood/Landslide Risk","Prediction unavailable"],["Severity","Unavailable"],["Affected Area","Unavailable"],["Recommendation","Use validated hazard information only"]]},
  landslide:{title:"AI LANDSLIDE", rows:[["Status","UNAVAILABLE"],["Live incidents","No verified landslide incident feed is configured"],["Prediction","Not available"],["Recommendation","Check official disaster-management alerts"]]},
  flood:{title:"AI FLOOD", rows:[["Flood source","FLOOD DATA UNAVAILABLE"],["Source status","UNAVAILABLE"],["Freshness","Unavailable"],["Analysis","INSUFFICIENT DATA — no verified live flood feed is configured"],["Recommendation","Use official Sikkim disaster-management alerts"]]},
  dam:{title:"AI DAM / WATER SAFETY", rows:[["Dam source","DAM LIVE DATA UNAVAILABLE"],["Source status","UNAVAILABLE"],["Freshness","Unavailable"],["Water level / release","Unavailable — never estimated"],["Analysis","AI DAM ANALYSIS UNAVAILABLE"],["Recommendation","Static dam markers are geographic reference only"]]},
  safety:{title:"AI SAFETY", rows:[["Safety Status","NOT CONFIGURED"],["Current Risk",function(){return aiValue("#safetyChipText","Unavailable")}],["Nearby Risk Factors","Not analyzed"],["Analysis","No AI safety inference"],["Recommendation","Use existing safety markers, weather, hazards and emergency tools"]]},
  tourism:{title:"AI TOURISM", rows:[["Status","NOT CONFIGURED"],["Nearby Places","Use verified Explore data"],["Conditions","Unavailable"],["Restrictions","Not analyzed"],["Road Access","Not analyzed"],["Weather Impact","Not analyzed"],["Recommendation","Open Explore for source-labelled places"]]},
  emergency:{title:"AI EMERGENCY", rows:[["Status","NOT CONFIGURED"],["Nearest Help","Use Emergency & Help"],["Road Access","Not analyzed"],["Current Hazards","Not analyzed"],["Emergency Numbers","Available in Emergency & Help"],["Recommended Action","For emergencies contact local services directly"]]},
  live:{title:"LIVE MONITOR", rows:[["Traffic",function(){return aiTrafficState().state}],["Weather",function(){return aiWeatherState().state}],["Hazards","UNAVAILABLE"],["GPS","Status unavailable to AI panel"],["Route",function(){return $("routeInfoPanel").style.display==="block"?"ACTIVE":"NONE"}],["AI Engine","UNAVAILABLE"],["Traffic Last Update","Session state only"],["Weather Last Update","Current weather panel"],["Hazards Last Update","Unavailable"]]},
  status:{title:"AI SYSTEM STATUS", rows:[["AI Engine","UNAVAILABLE"],["Map Intelligence","NOT CONFIGURED"],["Route Intelligence","NOT CONFIGURED"],["Traffic Intelligence",function(){return aiTrafficState().state}],["Weather Intelligence","NOT CONFIGURED"],["Hazard Intelligence","NOT CONFIGURED"],["Safety Intelligence","NOT CONFIGURED"],["Tourism Intelligence","NOT CONFIGURED"],["Emergency Intelligence","NOT CONFIGURED"],["Data Sources","Cesium, GraphHopper, TomTom traffic, weather and existing app data"],["Last Update","No AI inference update"]]}
 };
 function openAiModule(key, skipRulesRequest){
  var module=aiModules[key]; if(!module) return;
  var analyses={map:SafeRouteAIEngine.map,route:SafeRouteAIEngine.route,traffic:SafeRouteAIEngine.traffic,weather:SafeRouteAIEngine.weather,hazards:SafeRouteAIEngine.hazards,landslide:SafeRouteAIEngine.landslide,flood:SafeRouteAIEngine.flood,dam:SafeRouteAIEngine.dam,safety:SafeRouteAIEngine.safety,tourism:SafeRouteAIEngine.tourism,emergency:SafeRouteAIEngine.emergency};
  if(key==="live"){ var live=SafeRouteAIEngine.live(); module={title:"LIVE MONITOR",rows:[["GPS",live.gps.status+" · "+live.gps.reason],["Traffic",live.traffic.status+" · "+live.traffic.reason],["Weather",live.weather.status+" · "+live.weather.reason],["Flood",live.flood.status+" · "+live.flood.reason],["Dam",live.dam.status+" · "+live.dam.reason],["Hazards",live.hazards.status+" · "+live.hazards.reason],["Landslide",live.landslide.status+" · "+live.landslide.reason],["Route",live.route.status+" · "+live.route.reason],["Roads",typeof osmActiveEntities!=="undefined"&&osmActiveEntities.size?"CURRENT · OpenStreetMap viewport data":"UNAVAILABLE · no current road features loaded"],["Rules analysis","Available on request; this is not a connected generative AI model"]]}; }
  else if(key==="status"){ var liveStatus=SafeRouteAIEngine.live(); module={title:"AI SYSTEM STATUS",rows:[["AI model","NOT CONFIGURED · deterministic rules only"],["Rules engine","LOCAL · feature validation and contextual screening"],["Traffic rules",trafficModelState.status],["Rules version",trafficModelState.result?trafficModelState.result.modelVersion:"Not run"],["Last traffic analysis",trafficModelState.inferenceTimestamp||"No inference completed"],["Traffic analysis time",trafficModelState.result?trafficModelState.result.inferenceTimeMs+" ms":"Unavailable"],["Fallback","No synthetic data; unavailable evidence remains unknown"],["Map rules",SafeRouteAIEngine.map().status],["Route rules",SafeRouteAIEngine.route().status],["Traffic observations",liveStatus.traffic.status],["Weather readings",liveStatus.weather.status],["Hazard references",liveStatus.hazards.status],["Landslide screening",liveStatus.landslide.status],["Safety rules",SafeRouteAIEngine.safety().status],["Tourism data",SafeRouteAIEngine.tourism().status],["Emergency references",SafeRouteAIEngine.emergency().status],["Last check",SafeRouteAIEngine.now()]]}; }
  else if(analyses[key]){ var analysis=analyses[key].call(SafeRouteAIEngine); module={title:module.title,rows:[["Status",analysis.status],["Severity",analysis.severity],["Risk",analysis.risk],["Analysis",analysis.reason],["Affected Area",analysis.affectedArea],["Recommendation",analysis.recommendation],["Last Update",analysis.timestamp],["Sources",analysis.sources.join("; ")||"No verified source available"]]}; }
  $("aiPanel").style.display="none"; $("aiModulePanel").style.display="block"; $("aiModuleTitle").textContent=module.title;
  var content=$("aiModuleContent"); content.textContent="";
  var note=document.createElement("div"); note.className="sr-note"; note.innerHTML="<span class='sr-tag'>LOCAL RULES ENGINE</span> Explainable analysis from current SafeRoute data."; content.appendChild(note);
  module.rows.forEach(function(row){ var d=document.createElement("div"); d.className="sr-control-row"; var l=document.createElement("div"); l.className="sr-control-copy"; var s=document.createElement("strong"); s.textContent=row[0]; var v=document.createElement("small"); v.textContent=typeof row[1]==="function"?row[1]():row[1]; l.appendChild(s); l.appendChild(v); d.appendChild(l); content.appendChild(d); });
  if(key==="traffic"){
   var rules=SafeRouteAIEngine.traffic(), model=trafficModelState;
   var modelSection=document.createElement("div"); modelSection.className="sr-ai-assessment";
   var title=document.createElement("div"); title.className="sr-ai-assessment-title"; title.textContent="TRAFFIC OBSERVATION RULES"; modelSection.appendChild(title);
   [["OBSERVATIONS",aiTrafficState().detail],["LOCAL RULES",rules.severity+" · "+rules.risk],["CLUSTERING",model.status==="INFERRED"?model.result.congestionClass+" · "+model.result.risk:model.status],["ASSESSMENT",rules.reason]].forEach(function(row){var d=document.createElement("div");d.className="sr-control-row";var l=document.createElement("div");l.className="sr-control-copy";var s=document.createElement("strong");s.textContent=row[0];var v=document.createElement("small");v.textContent=row[1];l.appendChild(s);l.appendChild(v);d.appendChild(l);modelSection.appendChild(d);});
   var noteModel=document.createElement("div"); noteModel.className="sr-note"; noteModel.textContent=model.status==="INFERRED"?"Deterministic clustering: "+model.result.model+" v"+model.result.modelVersion+" · "+model.result.inferenceTimeMs+" ms · input provenance was not independently verified.":model.error; modelSection.appendChild(noteModel); content.appendChild(modelSection);
   if((model.status==="UNAVAILABLE"||model.status==="ERROR")&&Date.now()-trafficModelState.attemptedAt>30000){requestTrafficModel().then(function(){if($("aiModulePanel").style.display==="block"&&$("aiModuleTitle").textContent==="AI TRAFFIC"){openAiModule("traffic");}});}
  }
  if(["map","route","weather","hazards","safety","tourism","emergency"].indexOf(key)>=0){
   var state=modelStates[key]||{status:"UNAVAILABLE",result:null,error:"Rules analysis has not been requested."};
   var section=document.createElement("div"); section.className="sr-ai-assessment";
   var heading=document.createElement("div"); heading.className="sr-ai-assessment-title"; heading.textContent="DETERMINISTIC RULES · "+module.title; section.appendChild(heading);
   [["RULES STATUS",state.status],["RULES RESULT",state.result?state.result.result:state.status],["FINAL ASSESSMENT",analysisStatusFor(key)]].forEach(function(row){var d=document.createElement("div");d.className="sr-control-row";var l=document.createElement("div");l.className="sr-control-copy";var s=document.createElement("strong");s.textContent=row[0];var v=document.createElement("small");v.textContent=row[1];l.appendChild(s);l.appendChild(v);d.appendChild(l);section.appendChild(d);});
   var detail=document.createElement("div");detail.className="sr-note";detail.textContent=state.result?"Deterministic rules: "+state.result.model+" v"+state.result.modelVersion+" · "+state.result.inferenceMs+" ms · "+state.result.explanation:state.error;section.appendChild(detail);content.appendChild(section);
   if(!skipRulesRequest){requestModelTask(key).then(function(){if($("aiModulePanel").style.display==="block"&&$("aiModuleTitle").textContent===module.title){openAiModule(key,true);}});}
  }
 }
 function analysisStatusFor(key){var fn=SafeRouteAIEngine[key];return fn?fn.call(SafeRouteAIEngine).status:"UNAVAILABLE";}
 document.querySelectorAll("[data-ai-module]").forEach(function(button){ button.addEventListener("click",function(){ openAiModule(button.dataset.aiModule); }); });
 // AI integration boundary: context from real app state only; no service is connected.
 window.SafeRouteAI={ endpoint:null, connected:false,
  buildContext:function(){ var q=function(x){var n=document.querySelector(x);return n?n.textContent:null;};
   return { safetyChip:q("#safetyChipText"), distance:q("#routeInfoText .infoRow:nth-child(1) strong"), eta:q("#routeInfoText .infoRow:nth-child(2) strong") }; },
  ask:function(){ return Promise.reject(new Error("SafeRoute AI service is not connected")); } };
 // Visible navigation states (hooked from existing reroute/arrival code)
 var lbl=document.querySelector(".navDestLabel");
 window.__srNavState=function(st){ lbl.className="navDestLabel sr-st-"+st; lbl.textContent= st==="arrived"?"You have arrived":"Rerouting\u2026"; };
 new MutationObserver(function(){ if(lbl.className.indexOf("rerouting")>-1){ lbl.className="navDestLabel"; lbl.textContent="Route to destination"; } }).observe($("routeInfoText"),{childList:true});
 // Explore list from the built-in reference data
 var cats=document.querySelectorAll(".sr-cat[data-cat]");
 cats.forEach(function(c){ c.addEventListener("click",function(){
  cats.forEach(function(x){x.setAttribute("aria-pressed",x===c?"true":"false");});
  var list=$("srExploreList"); list.textContent="";
  var br=window.__srBridge; if(!br){ list.textContent="Place data is not loaded yet. Try again in a moment."; return; }
  var items=br.resources.filter(function(r){return r.category===c.dataset.cat;});
  if(!items.length){ list.textContent="No found in this map view."; return; }
  items.forEach(function(r){ var d=document.createElement("div"); d.className="sr-place";
   var t=document.createElement("div"); t.textContent=r.name; var sm=document.createElement("small"); sm.textContent=r.district+" District · "+r.source+" · "+r.scope+" · reference data may be outdated"; t.appendChild(sm);
   d.appendChild(t);
   if(c.dataset.cat!=="dam"){ var b=document.createElement("button"); b.textContent="Route"; b.setAttribute("aria-label","Route to "+r.name);
    b.addEventListener("click",function(){ hideAll(); sync(); br.route(r); }); d.appendChild(b); }
   list.appendChild(d); }); }); });
 // Route preview -> Start navigation (presentation + gate flag read by trackNavigationProgress)
 function setPreview(on){ window.__srPreview=on; $("startNavButton").style.display=on?"inline-flex":"none";
  lbl.className="navDestLabel"; lbl.textContent=on?"Route preview (navigation not started)":"Navigating"; }
 window.__srOnDestination=function(){ setPreview(true); };
 $("startNavButton").addEventListener("click",function(){ setPreview(false); });
 $("clearRouteButton").addEventListener("click",function(){ window.__srPreview=false; $("startNavButton").style.display="none"; lbl.className="navDestLabel"; lbl.textContent="Route to destination"; });
 $("srRetryWeather").addEventListener("click",function(){ $("safetyChipText").textContent="Checking safety data…"; if(window.__srBridge) window.__srBridge.retryWeather(); });
 // OSM POI categories
 var poiBtns=document.querySelectorAll(".sr-cat[data-poi]");
 function msg(list,cls,title,sub,retry){ list.textContent=""; var d=document.createElement("div"); d.className="sr-state "+cls;
  var h=document.createElement("strong"); h.textContent=title; d.appendChild(h);
  if(sub){ var p=document.createElement("span"); p.textContent=sub; d.appendChild(p); }
  if(retry){ var b=document.createElement("button"); b.className="sr-act"; b.textContent="Try again"; b.addEventListener("click",retry); d.appendChild(b); } list.appendChild(d); }
 // Honest generic labels, used only when OpenStreetMap supplies no name/brand/operator.
 var POI_GENERIC={hotels:"Accommodation",food:"Food place",cafes:"Cafe",fuel:"Fuel station",parking:"Parking area",tourist_places:"Tourist place",viewpoints:"Viewpoint",attractions:"Attraction",pharmacies:"Pharmacy",atms:"ATM",ev_charging:"EV charging station"};
 var POI_LABELS={hotels:"hotels",food:"food places",cafes:"cafes",fuel:"fuel stations",parking:"parking",tourist_places:"tourist places",viewpoints:"viewpoints",attractions:"attractions",pharmacies:"pharmacies",atms:"ATMs",ev_charging:"EV charging stations"};
 function fmtKm(km){ if(km===null||km===undefined) return "Distance unavailable"; if(km<0.1) return "Less than 100 m away"; if(km<10) return km.toFixed(1)+" km away"; return Math.round(km)+" km away"; }
 var poiSelectionGeneration=0;
 function loadPoi(key,btn){
  var selection=++poiSelectionGeneration;
  var list=$("srExploreList"), br=window.__srBridge;
  if(key==="tourist_places"){window.__srTourismPlaces=[];window.__srTourismPlacesUpdatedAt=0;}
  poiBtns.forEach(function(x){x.setAttribute("aria-pressed",x===btn?"true":"false");});
  document.querySelectorAll(".sr-cat[data-cat]").forEach(function(x){x.setAttribute("aria-pressed","false");});
  var again=function(){loadPoi(key,btn);};
  if(!window.__srPoi||!br){ msg(list,"err","Places are not ready yet.","Please try again in a moment.",again); return; }
  var categoryName=POI_LABELS[key]||"places";
  window.__srPoi.fetch(key,function(r){
   if(selection!==poiSelectionGeneration){return;}
   if(key==="tourist_places"&&(r.status==="ok"||r.status==="empty"||r.status==="cached")){window.__srTourismPlaces=(r.items||[]).slice();window.__srTourismPlacesUpdatedAt=r.cachedAt||Date.now();}
   if(r.status==="loading"){ list.textContent=""; var l=document.createElement("div"); l.setAttribute("role","status"); l.textContent="Finding "+categoryName+"..."; l.className="sr-note"; list.appendChild(l); list.appendChild(Object.assign(document.createElement("div"),{className:"sr-skel"})); list.appendChild(Object.assign(document.createElement("div"),{className:"sr-skel"})); return; }
   if(r.status==="offline") return msg(list,"err","You're offline.","Places need an internet connection.",again);
   if(r.status==="zoom") return msg(list,"","Zoom in to see places.","Places load for the current map view only.",again);
   if(r.status==="busy") return msg(list,"","Please wait a moment.","Then try again.",again);
   if(r.status==="timeout") return msg(list,"err",categoryName+" search timed out. Try again.","",again);
   if(r.status==="error") return msg(list,"err","Couldn't load "+categoryName+" right now.","Please try again in a moment.",again);
   if(r.status==="invalid") return msg(list,"err","Some "+categoryName+" results had invalid location data.","Only valid locations are shown.",again);
   if(r.status==="cached"&&!(r.items||[]).length) return msg(list,"","CACHED · No "+categoryName+" found in this map view.","Cached empty results are not proof that no places exist.");
   if(r.status==="empty"){if(window.__sr2dSetPois)window.__sr2dSetPois([]);return msg(list,"","No "+categoryName+" found in this map view.","Coverage varies. A missing result does not mean none exists.");}
   list.textContent="";
   var generic=POI_GENERIC[key]||"Place";
   if(r.status==="cached"&&window.__sr2dSetPois)window.__sr2dSetPois(r.items||[]);
   (r.items||[]).slice(0,25).forEach(function(it){ var d=document.createElement("div"); d.className="sr-place"; if(it.osm) d.dataset.osm=it.osm;
    var t=document.createElement("div"); var nm=document.createElement("span"); nm.textContent=it.name||generic; t.appendChild(nm);
    var sm=document.createElement("small"); sm.textContent=fmtKm(it.km); t.appendChild(sm); d.appendChild(t);
    var b=document.createElement("button"); b.textContent="Route"; b.setAttribute("aria-label","Route to "+(it.name||generic));
    b.addEventListener("click",function(){ hideAll(); sync(); br.route({name:it.name||generic,latitude:it.lat,longitude:it.lon,category:key,source:"OpenStreetMap"}); }); d.appendChild(b); list.appendChild(d); });
   var note=document.createElement("div"); note.className="sr-note";
   note.textContent=(r.status==="cached"?"CACHED · ":"")+(r.items.length>25?"Showing 25 of "+r.items.length+" places found in this view. ":"")+"Scope: current map view · OpenStreetMap. Distances are straight-line from your location, not road distance.";
   list.appendChild(note);
  });
 }
 poiBtns.forEach(function(b){ b.addEventListener("click",function(){ loadPoi(b.dataset.poi,b); }); });
 document.querySelectorAll("[data-map-detail]").forEach(function(b){ b.addEventListener("click",function(){
  var on=b.getAttribute("aria-pressed")!=="true"; b.setAttribute("aria-pressed",on?"true":"false"); b.textContent=on?"Shown":"Hidden";
  if(window.__srMapControls&&window.__srMapControls.setDetail){ window.__srMapControls.setDetail(b.dataset.mapDetail,on); }
 }); });
 document.querySelectorAll("[data-map-poi]").forEach(function(b){ b.addEventListener("click",function(){
  var on=b.getAttribute("aria-pressed")!=="true"; b.setAttribute("aria-pressed",on?"true":"false"); b.textContent=on?"Shown":"Hidden";
  if(window.__srMapControls&&window.__srMapControls.togglePoi){ window.__srMapControls.togglePoi(b.dataset.mapPoi,on); }
 }); });
 $("exploreOpenPermits").addEventListener("click",function(){ $("permitButton").click(); });
 $("safetyOpenEmergency").addEventListener("click",function(){ $("helplineButton").click(); });
 $("profileOpenEmergency").addEventListener("click",function(){ $("helplineButton").click(); });
 // Offline / stuck-loading honesty (presentation only)
 function net(){ $("srOffline").style.display=navigator.onLine?"none":"block"; }
 window.addEventListener("online",net); window.addEventListener("offline",net); net();
 setTimeout(function(){ var c=$("safetyChipText"); if(c.textContent.indexOf("Checking")>-1){ c.textContent="Safety data unavailable"; } },20000);
 SR_PANELS.forEach(function(id){ var e=$(id); e.setAttribute("role","dialog"); e.setAttribute("aria-label",id.replace("Panel","")); });
 $("safetyChip").setAttribute("aria-live","polite");
 // Search bar copy only; the Cesium geocoder itself is untouched.
 var tries=0,t=setInterval(function(){
  var inp=document.querySelector(".cesium-geocoder-input");
  if(inp){ inp.placeholder="Where do you want to go?"; inp.setAttribute("aria-label","Where do you want to go?"); clearInterval(t); }
  else if(++tries>60) clearInterval(t);
 },500);
})();
</script>
<script>
console.log("=================================");
console.log("SafeRoute 3D Starting...");
console.log("=================================");
window.onerror = function(message, source, line, column, error){
 console.error("JS ERROR");
 console.error(message);
 console.error(source);
 console.error(line);
 console.error(column);
 console.error(error);
};
window.addEventListener("unhandledrejection", function(event){
 console.error("PROMISE ERROR");
 console.error(event.reason);
});
Cesium.Ion.defaultAccessToken =
 "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJqdGkiOiIyMGZkOGE4YS1jODEwLTQ2MzctYTE2MC05OTlkZTczYWNhMDciLCJpZCI6NDE1OTcyLCJpYXQiOjE3NzU3NDYwMjB9.o7_SRyCIMRxQ-NaCn7e73399qqJsRJs13G8xegkW1Kg";
// SCALABILITY MIGRATION PATH (documentation only):
// Phase 1: client-side caching/throttling/dedup (this phase)
// Phase 2: central backend/cache for weather
// Phase 3: self-hosted GraphHopper
// Phase 4: preprocessed offline Sikkim+Kalimpong OSM data
// Phase 5: production monitoring/scaling infrastructure
//
// The active backend uses self-hosted GraphHopper and returns the same
// GraphHopper-compatible response schema expected by calculateRoute().
//
// FUTURE BACKEND CONTRACT:
// GET {backendUrl}?startLat=..&startLon=..&endLat=..&endLon=..
// Response must contain GraphHopper-compatible paths[] data.
//
// 700K-USER MIGRATION PATH:
// Stage 1 (done): client-side dedup/stale-response/throttle guards
// Stage 2 (next): self-hosted GraphHopper, flip mode -> "backend"
// Stage 3: shared backend weather cache
// Stage 4: offline Sikkim+Kalimpong OSM data
// Stage 5: production scaling (proxy/cache/monitoring)
window.__srBackendOrigin = window.__srBackendOrigin || (function(){
 const location = window.location;
 if (!location || location.protocol === "file:" || !location.hostname) {
  return "http://127.0.0.1:3000";
 }
 const hostname = location.hostname.toLowerCase();
 const localHost = hostname === "localhost" || hostname === "127.0.0.1" || hostname === "10.0.2.2";
 if (localHost && location.port !== "3000") {
  return location.protocol + "//" + hostname + ":3000";
 }
 return location.origin;
})();
window.__srBackendOrigin = String(window.__srBackendOrigin).replace(/\/+$/, "");
const ROUTING_CONFIG = {
 // ===================================================================
 // FIX for "route request times out on physical Android phone":
 // 10.0.2.2 is a special alias that ONLY exists inside the Android
 // EMULATOR's virtual network (it maps to the host machine's
 // 127.0.0.1). A physical phone has no such interface at all, so a
 // request to 10.0.2.2 fails immediately at the OS level with a
 // connection timeout — this matches the ERR_CONNECTION_TIMED_OUT
 // symptom exactly, independent of anything else in this file.
 //
 // For a physical phone on the same Wi-Fi as your backend machine, use
 // that machine's actual LAN IP instead. Find it with:
 //   Windows:      ipconfig            -> "IPv4 Address"
 //   Mac/Linux:    ifconfig | ip addr  -> look for your Wi-Fi interface
 // (matches the "Reachable from other devices on the same network at"
 // lines server.js now prints on startup).
 //
 // BEFORE trusting this, verify from the PHONE'S OWN BROWSER (not this
 // app) that http://<that IP>:3000/health loads and returns JSON. If it
 // doesn't, the problem is Windows Firewall or the phone being on a
 // different network — not this file (see delivery notes checklist).
 // ===================================================================
 // SECURITY FIX (Phase 11, Step 1): this previously also had a
 // "graphhopper" direct-cloud-call mode carrying a hardcoded
 // GraphHopper API key as a client-readable literal. That mode was
 // confirmed DEAD — mode has been "backend" for several phases, so the
 // key was never reached by live code, yet still shipped readable in
 // this file. Removed entirely rather than left disabled, since a
 // dormant secret is still a leaked secret. The backend now owns all
 // GraphHopper credentials server-side (see backend/.env, never sent
 // to the client). If a direct-cloud fallback mode is ever needed
 // again, it must fetch a short-lived token from the backend at
 // runtime — never embed a raw provider key in client code again.
 // ===================================================================
 mode: "backend",
 backendUrl: window.__srBackendOrigin + "/api/route"
};
// Abuse-reduction key (Phase 11, Step 4) — matches SAFEROUTE_CLIENT_KEY
// in backend/.env. This is intentionally NOT secret-grade: it lives in
// shipped client code by necessity for a login-free public app. See
// the header comment at the fetch() call site for the honest scope of
// what this does and doesn't protect against.
const SAFEROUTE_CLIENT_KEY = "";
// This state is deliberately unavailable until a backend response identifies
// a verified provider and freshness. Static dam points are never live data.
window.__srMonitoring={flood:{status:"UNAVAILABLE",sources:[]},dam:{status:"UNAVAILABLE",sources:[]}};
function refreshMonitoring(){var controller=new AbortController(),timer=setTimeout(function(){controller.abort();},4000);fetch(window.__srBackendOrigin+"/api/monitoring/status",{signal:controller.signal,headers:{"X-SafeRoute-Client-Key":SAFEROUTE_CLIENT_KEY}}).then(function(r){if(!r.ok)throw new Error("unavailable");return r.json();}).then(function(data){if(data&&data.flood&&data.dam)window.__srMonitoring=data;}).catch(function(){}).finally(function(){clearTimeout(timer);});}
refreshMonitoring();setInterval(refreshMonitoring,300000);
window.__srCesiumReady=false;
function buildRouteUrl(startLat, startLon, endLat, endLon){
 if (!ROUTING_CONFIG.backendUrl) {
 throw new Error("ROUTING_CONFIG.backendUrl is not set — routing cannot proceed.");
 }
 return ROUTING_CONFIG.backendUrl + "?startLat=" + startLat + "&startLon=" + startLon +
 "&endLat=" + endLat + "&endLon=" + endLon;
}
(function(){
 const map=document.getElementById("sr2dMap"), tiles=document.getElementById("sr2dTiles");
 const overlay=document.getElementById("sr2dOverlay"), routeLine=document.getElementById("sr2dRoute"), routeGroup=document.getElementById("sr2dRouteGroup"), trafficGroup=document.getElementById("sr2dTraffic"), poiGroup=document.getElementById("sr2dPois");
 const user=document.getElementById("sr2dUser"), destination=document.getElementById("sr2dDestination");
 const state={mode:"2d",lat:27.3314,lon:88.6138,zoom:12,route:null,user:null,destination:null,pois:[],drag:null,pointers:new Map(),pinch:null};
 window.__srAiContext=window.__srAiContext||{viewport:null,selectedLocation:null,lastEvent:null,updatedAt:null};
 let aiContextTimer=null;
 function publishAiContext(eventName){if(aiContextTimer)clearTimeout(aiContextTimer);aiContextTimer=setTimeout(function(){window.__srAiContext.viewport={lat:state.lat,lon:state.lon,zoom:state.zoom,mode:state.mode};window.__srAiContext.lastEvent=eventName;window.__srAiContext.updatedAt=new Date().toISOString();window.dispatchEvent(new CustomEvent("saferoute:context"));},350);}
 const size=256;
 const tileNodes=new Map(), tileCache=new Map(), tileFailures=new Set(); let renderQueued=false, lastTrafficView="";
 window.__sr2dMetrics={renders:0,lastRenderMs:0,maxRenderMs:0,visibleTiles:0};
 window.__sr2dTileMetrics={failed:0,pending:0,loaded:0};
 function clampLat(lat){return Math.max(-85.05112878,Math.min(85.05112878,lat));}
 function projectNormalized(lat,lon){var phi=clampLat(lat)*Math.PI/180;return {x:(lon+180)/360,y:(1-Math.log(Math.tan(phi)+1/Math.cos(phi))/Math.PI)/2};}
 function project(lat,lon,z){var p=projectNormalized(lat,lon),worldSize=Math.pow(2,z)*size;return {x:p.x*worldSize,y:p.y*worldSize};}
 function unproject(x,y,z){var n=Math.pow(2,z),lon=x/(n*size)*360-180,lat=Math.atan(Math.sinh(Math.PI*(1-2*y/(n*size))))*180/Math.PI;lon=((lon+180)%360+360)%360-180;return {lat:lat,lon:lon};}
 function screenProjected(point,centerX,centerY,worldSize){return {x:point.x*worldSize-centerX+map.clientWidth/2,y:point.y*worldSize-centerY+map.clientHeight/2};}
 function updateTileStatus(){
  window.__sr2dTileMetrics.failed=tileFailures.size;
  window.__sr2dTileMetrics.pending=Array.from(tileNodes.values()).filter(function(img){return !img.complete;}).length;
  map.setAttribute("aria-label",tileFailures.size?"SafeRoute 2D map; "+tileFailures.size+" map tile(s) unavailable":"SafeRoute 2D map");
  var status=document.getElementById("sr3dStatus");
  if(tileFailures.size){status.textContent=tileFailures.size+" map tile(s) unavailable · OpenStreetMap";}
  else if(/^\d+ map tile\(s\) unavailable · OpenStreetMap$/.test(status.textContent)){status.textContent=state.mode==="3d"?"3D map active · 2D state preserved":"2D map active · 3D loading in background";}
 }
 function render(){
  renderQueued=false;
  var renderStarted=performance.now();
  var tileZoom=Math.floor(state.zoom),tileScale=Math.pow(2,state.zoom-tileZoom),tileSize=size*tileScale;
  var center=project(state.lat,state.lon,tileZoom),centerX=center.x*tileScale,centerY=center.y*tileScale;
  var left=centerX-map.clientWidth/2,top=centerY-map.clientHeight/2;
  var firstX=Math.floor(left/tileSize),firstY=Math.floor(top/tileSize),lastX=Math.ceil((left+map.clientWidth)/tileSize)-1,lastY=Math.ceil((top+map.clientHeight)/tileSize)-1,n=Math.pow(2,tileZoom),needed=new Set();
  for(var x=firstX;x<=lastX;x++) for(var y=firstY;y<=lastY;y++){
   if(y<0||y>=n)continue;
   var tx=((x%n)+n)%n,key=tileZoom+"/"+tx+"/"+y;
   needed.add(key);
