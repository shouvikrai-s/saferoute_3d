  if (window.__sr2dTrafficRenderer) {
   trafficManager.setSecondaryRenderer(window.__sr2dTrafficRenderer);
  }
  window.__srTrafficManager = trafficManager;
 } catch (trafficError) {
  console.warn("SafeRoute traffic initialization skipped:", trafficError);
 }
} else {
 console.warn("SafeRoute traffic manager unavailable; continuing without traffic.");
}
// ===================================================================
// CONFIRMED FIX (video-evidenced): globe: false above means there is no
// fallback ellipsoid/base imagery layer. On a large geographic camera
// jump (e.g. Chungthang -> Gangtok), Photorealistic 3D Tiles for the
// brand-new area haven't loaded yet, and with no fallback layer the
// scene had NOTHING to draw for that gap — rendering as a near-solid
// black frame (confirmed on video, ~1s duration, self-resolves as the
// first coarse tile streams in). This is a rendering-CONTENT gap, not
// the earlier CPU/main-thread lag — nothing below touches route, OSM,
// taxi, marker, or height-sampling code.
// Setting a neutral dark background means that same gap now reads as
// an intentional "loading" tone instead of looking like a crash. Purely
// cosmetic — does not change what tiles load, when, or how fast.
// ===================================================================
viewer.scene.backgroundColor = Cesium.Color.fromCssColorString("#0d1b2a");
// ===================================================================
// GPU/WEBGL PERFORMANCE (verified against bundled Cesium 1.143 source
// before applying — see delivery notes for what was NOT applied and why):
//
// - viewer.shadows: real Cesium.Viewer property (confirmed in source).
//   Explicitly false — shadow map generation is one of the more
//   expensive optional Cesium features and this app never enables
//   dynamic sun shadows, so this just makes that "off" state explicit
//   rather than relying on the (also-false) default.
// - viewer.resolutionScale: real Cesium.Viewer property (confirmed in
//   source — it forwards to the underlying CesiumWidget). On a
//   high-DPI Android screen (devicePixelRatio 2–3+), Cesium by default
//   renders at full native pixel density, which is a large, often
//   invisible-to-the-user GPU cost on WebGL. Capping it here avoids
//   burning GPU time on detail the screen's own pixel density means
//   the user can't actually perceive the difference of.
// - viewer.scene.globe.enableLighting is intentionally NOT set: this
//   app creates the Viewer with `globe: false` (see above) and uses
//   Google Photorealistic 3D Tiles instead of Cesium's built-in
//   ellipsoid globe. viewer.scene.globe is therefore null here, and
//   setting a property on it would throw. Photorealistic 3D Tiles
//   already ship pre-lit/pre-baked imagery, so there is no separate
//   real-time lighting pass to disable for this app's actual rendering
//   path.
// ===================================================================
viewer.shadows = false;
viewer.resolutionScale = window.devicePixelRatio > 1.5 ? 1.0 : window.devicePixelRatio;
// ===================================================================
// PERFORMANCE: by default Cesium renders continuously at full frame
// rate even when nothing on screen is changing, which is heavy with
// Photorealistic 3D Tiles on mobile. requestRenderMode makes it only
// render when something actually changes. The pulsing dot still needs
// periodic redraws to animate, so a light manual render is triggered
// a few times per second — far cheaper than uncapped continuous
// rendering.
// ===================================================================
viewer.scene.requestRenderMode = true;
viewer.scene.maximumRenderTimeChange = Infinity;
setInterval(function(){
 viewer.scene.requestRender();
}, 150);
// ===================================================================
// PERFORMANCE DIAGNOSTICS (production-disabled by default). Renders a
// small on-screen HUD showing FPS, entity/tile counts, and pending
// network activity so the real remaining bottleneck can be MEASURED
// on-device instead of guessed at from static code reading. This does
// NOT monkey-patch fetch/XHR and adds zero overhead when disabled — the
// whole block is skipped entirely if the flag is false.
// ===================================================================
const ENABLE_PERFORMANCE_DIAGNOSTICS = false;
if (ENABLE_PERFORMANCE_DIAGNOSTICS) {
 const perfHud = document.createElement("div");
 perfHud.style.cssText =
 "position:fixed;top:6px;left:6px;z-index:99999;background:rgba(0,0,0,0.75);" +
 "color:#0f0;font:11px monospace;padding:6px 8px;border-radius:4px;" +
 "line-height:1.5;pointer-events:none;white-space:pre;";
 document.body.appendChild(perfHud);
 let perfLastFrameTime = performance.now();
 let perfFrameCount = 0;
 let perfFps = 0;
 viewer.scene.postRender.addEventListener(function(){
 perfFrameCount++;
 const now = performance.now();
