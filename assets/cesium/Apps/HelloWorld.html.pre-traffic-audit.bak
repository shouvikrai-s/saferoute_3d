const USER_MARKER_HEIGHT_REFINE_MIN_DISTANCE_KM = 0.003; // ~3 meters
let lastUserMarkerHeightRefineTime = 0;
let lastUserMarkerHeightRefineLat = null;
let lastUserMarkerHeightRefineLon = null;
function addOrUpdateUserMarker(lat, lon){
