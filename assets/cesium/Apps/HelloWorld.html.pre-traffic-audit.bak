 <div class="sr-sheet-subtitle">Data-grounded SafeRoute intelligence controls. Modules never invent live conditions.</div>
 <div class="sr-chipgrid" id="aiModuleGrid">
  <button class="sr-cat" data-ai-module="map">AI MAP</button><button class="sr-cat" data-ai-module="route">AI ROUTE</button>
  <button class="sr-cat" data-ai-module="traffic">AI TRAFFIC</button><button class="sr-cat" data-ai-module="weather">AI WEATHER</button>
  <button class="sr-cat" data-ai-module="hazards">AI HAZARDS</button><button class="sr-cat" data-ai-module="landslide">AI LANDSLIDE</button><button class="sr-cat" data-ai-module="flood">AI FLOOD</button><button class="sr-cat" data-ai-module="dam">AI DAM</button><button class="sr-cat" data-ai-module="safety">AI SAFETY</button>
  <button class="sr-cat" data-ai-module="tourism">AI TOURISM</button><button class="sr-cat" data-ai-module="emergency">AI EMERGENCY</button>
  <button class="sr-cat" data-ai-module="live">LIVE MONITOR</button><button class="sr-cat" data-ai-module="status">AI STATUS</button>
 </div>
 <div class="sr-note" id="aiCenterSummary"></div>
</div>
