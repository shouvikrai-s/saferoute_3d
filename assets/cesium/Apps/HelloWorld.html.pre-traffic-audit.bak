 }
 const xhr = this;
 const startTime = performance.now();
 const motionAtStart = diagnosticMotionCounter;
 let camLon = "N/A", camLat = "N/A", camHeight = "N/A";
 try {
 const cam = viewer.camera.positionCartographic;
 camLon = Cesium.Math.toDegrees(cam.longitude).toFixed(6);
 camLat = Cesium.Math.toDegrees(cam.latitude).toFixed(6);
 camHeight = cam.height.toFixed(1);
 } catch (camErr) { /* camera not ready yet, leave as N/A */ }
 const rawUrl = xhr.__diagnosticUrl;
 const shortUrl = rawUrl.substring(
 rawUrl.lastIndexOf("/") + 1,
 rawUrl.indexOf("?") > -1 ? rawUrl.indexOf("?") : rawUrl.length
 );
 console.log(
 "DIAGNOSTIC XHR START motion=" + motionAtStart +
 " camLon=" + camLon + " camLat=" + camLat + " camHeight=" + camHeight +
 " url=" + shortUrl
 );
 xhr.addEventListener("load", function(){
 const durationMs = (performance.now() - startTime).toFixed(0);
 const ok = xhr.status >= 200 && xhr.status < 300;
 console.log(
 "DIAGNOSTIC XHR " + (ok ? "LOAD" : "HTTP_ERROR") +
 " status=" + xhr.status + " durationMs=" + durationMs +
 " motion=" + motionAtStart + " url=" + shortUrl
 );
 });
 xhr.addEventListener("error", function(){
 const durationMs = (performance.now() - startTime).toFixed(0);
 console.error(
 "DIAGNOSTIC XHR ERROR durationMs=" + durationMs +
 " motion=" + motionAtStart + " url=" + shortUrl
 );
 });
 xhr.addEventListener("abort", function(){
 const durationMs = (performance.now() - startTime).toFixed(0);
 console.error(
 "DIAGNOSTIC XHR ABORT durationMs=" + durationMs +
 " motion=" + motionAtStart + " url=" + shortUrl
 );
 });
 xhr.addEventListener("timeout", function(){
 const durationMs = (performance.now() - startTime).toFixed(0);
 console.error(
 "DIAGNOSTIC XHR TIMEOUT durationMs=" + durationMs +
 " motion=" + motionAtStart + " url=" + shortUrl
 );
 });
 return diagnosticOriginalXHRSend.apply(this, arguments);
 };
 setInterval(function(){
 const stats = photorealisticTileset.statistics;
 console.log(
 "DIAGNOSTIC STATS [motion #" + diagnosticMotionCounter + "] " +
 "pending=" + stats.numberOfPendingRequests +
 " readyTiles=" + stats.numberOfTilesWithContentReady
 );
 }, 1000);
 } // end ENABLE_NETWORK_DIAGNOSTICS gate (fetch/XHR wrappers + per-second stats log)
} catch (tilesetError) {
 console.error("PHOTOREALISTIC TILES FAILED TO LOAD");
 console.error(tilesetError);
}
loadingOverlay.style.display = "none";
// ===================================================================
// SIKKIM SAFETY RESOURCE DATA — all 4 districts
// East (Gangtok), South (Namchi), West (Gyalshing), North (Mangan)
// Sourced from Google Places, verified real locations, July 2026.
// Dam markers are STATIC REFERENCE POINTS only — this is NOT live
// flood/landslide monitoring. That is a separate future roadmap
// phase requiring live sensor/gauge data feeds.
// ===================================================================
const resourceData = [
 // ---- EAST DISTRICT (Gangtok) — Hospitals ----
 { name: "Central Referral Hospital", type: "hospital", district: "East", lat: 27.3162391, lon: 88.5972587 },
 { name: "STNM Hospital", type: "hospital", district: "East", lat: 27.3449449, lon: 88.6038244 },
 { name: "District Hospital Singtam", type: "hospital", district: "East", lat: 27.2296952, lon: 88.4946887 },
 // ---- EAST DISTRICT (Gangtok) — Police ----
 { name: "Sadar Police Station", type: "police", district: "East", lat: 27.333706, lon: 88.6150315 },
 { name: "Sikkim Police Headquarters", type: "police", district: "East", lat: 27.3301671, lon: 88.6119303 },
 { name: "Tadong Police Station", type: "police", district: "East", lat: 27.3144007, lon: 88.6010724 },
 { name: "Ranipool Police Station", type: "police", district: "East", lat: 27.2936311, lon: 88.5908099 },
 // ---- SOUTH DISTRICT (Namchi) — Hospitals ----
 { name: "District Hospital Namchi", type: "hospital", district: "South", lat: 27.1613101, lon: 88.3581313 },
 // ---- SOUTH DISTRICT (Namchi) — Police ----
 { name: "Namchi Police Station", type: "police", district: "South", lat: 27.1647289, lon: 88.3603093 },
 // ---- WEST DISTRICT (Gyalshing/Geyzing) — Hospitals ----
 { name: "District Hospital Gyalshing", type: "hospital", district: "West", lat: 27.2911331, lon: 88.2568793 },
 // ---- WEST DISTRICT (Gyalshing/Geyzing) — Police ----
 { name: "Police Station Geyzing", type: "police", district: "West", lat: 27.2881708, lon: 88.2574613 },
 // ---- NORTH DISTRICT (Mangan) — Hospitals ----
 { name: "Mangan District Hospital", type: "hospital", district: "North", lat: 27.4908521, lon: 88.5318815 },
 // ---- NORTH DISTRICT (Mangan) — Police ----
 { name: "Mangan Police Station", type: "police", district: "North", lat: 27.5025105, lon: 88.5359942 },
 // ---- DAMS / HYDRO PROJECTS (reference points only, Teesta river) ----
 { name: "Teesta V Dam", type: "dam", district: "East", lat: 27.3869525, lon: 88.5036135 },
 { name: "Teesta III Dam (DESTROYED — Oct 2023 GLOF)", type: "dam", district: "North", lat: 27.5280130, lon: 88.5411727 },
 { name: "Teesta VI Hydroelectric Project", type: "dam", district: "East", lat: 27.1858348, lon: 88.5040573 },
 { name: "Teesta Power Station V", type: "dam", district: "East", lat: 27.2513724, lon: 88.4595430 }
];
resourceData.forEach(function(resource){
 resource.category=resource.type;
 resource.source="SafeRoute reference";
 resource.scope="SIKKIM";
 resource.latitude=resource.lat;
 resource.longitude=resource.lon;
});
window.__srResourceData = resourceData;
// Simple, reliable, immediate rendering — same reasoning as the user marker.
// Shared helper: after placing any entity at approximate height 0,
// quietly correct it to the REAL ground elevation in the background.
// Same fix as the user marker — prevents pins/labels from appearing to
// float or shift position as the camera zooms/pans over 3D terrain.
function refineEntityHeight(entity, lat, lon){
 const cartographic = Cesium.Cartographic.fromDegrees(lon, lat);
 viewer.scene.sampleHeightMostDetailed([cartographic]).then(function(){
 if (Cesium.defined(cartographic.height)) {
 entity.position = Cesium.Cartesian3.fromDegrees(lon, lat, cartographic.height);
 }
 }).catch(function(heightError){
 console.error("Height refine failed for entity (still visible at approximate height)");
 console.error(heightError);
 });
}
// ===================================================================
// PHASE 6 — NAVIGATION (tap-to-route)
// Tap anywhere on the map -> green flag marks that spot as the
// destination -> GraphHopper calculates a real road route from the
// user's current live GPS position -> route is drawn as a line,
// height-corrected to sit properly on the real 3D terrain.
// ===================================================================
let destinationEntity = null;
let routeEntity = null;
const routeInfoPanel = document.getElementById("routeInfoPanel");
const routeInfoText = document.getElementById("routeInfoText");
const clearRouteButton = document.getElementById("clearRouteButton");
// ===================================================================
// PHASE 9 — RULE-BASED ROUTE RISK ANALYSIS
// No paid AI API used — this checks a calculated route against known
// real hazard zones (verified via search/places tools, not guessed):
// 1. The 2023 Teesta III dam failure site (permanent hazard)
// 2. The Kaw / Lingee-Payong landslide corridor from the June 2026
// Sikkim floods/landslides (permanent-for-now hazard, real coords)
// 3. Any location CURRENTLY showing elevated rainfall (dynamic, pulled
// from the Phase 8 weather panel data)
// If a route passes within a zone's radius, a warning is shown in the
// route info panel alongside the distance/time.
// ===================================================================
const staticHazardZones = [
 {
 name: "2023 Teesta III Dam Failure Zone",
 lat: 27.5280130, lon: 88.5411727, radiusKm: 3,
 reason: "Passes near the site of the October 2023 Teesta III dam failure (GLOF-affected zone)"
 },
 {
 name: "Kaw / Lingee-Payong Landslide Corridor",
 lat: 27.369, lon: 88.4425, radiusKm: 4,
 reason: "Passes through an area with recent landslide/road damage activity (June 2026 Sikkim floods)"
 }
];
window.__srHazardZones = staticHazardZones;
let latestWeatherResults = [];
function haversineDistanceKm(lat1, lon1, lat2, lon2){
 const R = 6371;
 const dLat = (lat2 - lat1) * Math.PI / 180;
 const dLon = (lon2 - lon1) * Math.PI / 180;
 const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
 Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
 Math.sin(dLon / 2) * Math.sin(dLon / 2);
 const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
 return R * c;
}
function checkRouteRisk(coordinates){
 const risks = [];
 const activeZones = staticHazardZones.slice();
 latestWeatherResults.forEach(function(w){
 if (w.precipitation >= RAIN_RISK_THRESHOLD_MM) {
 const loc = weatherLocations.find(function(l){ return l.name === w.name; });
 if (loc) {
 activeZones.push({
 name: w.name + " Heavy Rainfall Zone",
 lat: loc.lat, lon: loc.lon, radiusKm: 5,
 reason: "Passes near " + w.name + ", currently experiencing heavy rainfall (" + w.precipitation.toFixed(1) + " mm/hr)"
 });
 }
 }
 });
 // CONFIRMED secondary cost (this pass): previously scanned the FULL
 // route coordinate array per hazard zone, called once per route
 // alternative — for a long route × several zones × 2-3 alternatives,
 // this adds thousands of haversine calls on every route calculation,
 // including every auto-reroute. A hazard radius check doesn't need
 // per-meter precision (zones are km-scale), so the same bounded
 // sampling used for route height above is reused here.
 const riskCheckIndices = buildRouteHeightSampleIndices(coordinates.length);
 activeZones.forEach(function(zone){
 let minDistance = Infinity;
 riskCheckIndices.forEach(function(i){
 const coord = coordinates[i];
 const d = haversineDistanceKm(zone.lat, zone.lon, coord[1], coord[0]);
 if (d < minDistance) { minDistance = d; }
 });
 if (minDistance <= zone.radiusKm) {
 risks.push({ reason: zone.reason, distanceKm: minDistance.toFixed(1) });
 }
 });
 return risks;
}
function clearRoute(){
 if (destinationEntity) {
 viewer.entities.remove(destinationEntity);
 destinationEntity = null;
 }
 if (routeEntity) {
 viewer.entities.remove(routeEntity);
 routeEntity = null;
 }
 if (typeof alternateRouteEntities !== "undefined") {
 alternateRouteEntities.forEach(function(e){ viewer.entities.remove(e); });
 alternateRouteEntities = [];
 }
 routeInfoPanel.style.display = "none";
 routeAlternatives = [];
 activeRoute = null;
 window.__srActiveRoute = null;
 lastSpokenInstructionIndex = -1;
 announcedApproachingDestination = false;
 announcedArrivedDestination = false;
 if (window.__sr2dSetRoute) { window.__sr2dSetRoute(null); }
 if (window.__sr2dSetDestination) { window.__sr2dSetDestination(null); }
 if (window.speechSynthesis) {
 window.speechSynthesis.cancel();
 }
 console.log("Route cleared");
}
clearRouteButton.addEventListener("click", function(){
 clearRoute();
});
function setDestination(destination, legacyLon){
 var place=typeof destination==="object" ? destination : {latitude:destination,longitude:legacyLon};
 var lat=Number(place.latitude), lon=Number(place.longitude);
 if(!Number.isFinite(lat)||!Number.isFinite(lon)||lat < -90||lat > 90||lon < -180||lon > 180){
  showRouteError("This place has invalid location data.","invalid_destination");
  return;
 }
 window.__srSelectedDestination={name:place.name||"Selected place",latitude:lat,longitude:lon,category:place.category||"unknown",source:place.source||"Unknown"};
 if (window.__sr2dSetDestination) { window.__sr2dSetDestination(lat,lon); }
 if (window.__srOnDestination) { window.__srOnDestination(); }
 const position = Cesium.Cartesian3.fromDegrees(lon, lat, 0);
 if (destinationEntity) {
 viewer.entities.remove(destinationEntity);
 }
 const pinBuilder = new Cesium.PinBuilder();
 const flagPin = pinBuilder.fromText("●", Cesium.Color.fromCssColorString("#EF4444"), 34);
 destinationEntity = viewer.entities.add({
 position: position,
 billboard: {
 image: flagPin.toDataURL(),
 verticalOrigin: Cesium.VerticalOrigin.BOTTOM,
 scale: 0.9,
 disableDepthTestDistance: Number.POSITIVE_INFINITY
 }
 });
 refineEntityHeight(destinationEntity, lat, lon);
 console.log("Destination set -> LAT:", lat, "LON:", lon);
 if (lastUserLat !== null && lastUserLon !== null) {
 calculateRoute(lastUserLat, lastUserLon, lat, lon);
 } else {
 showRouteError("Your current location is unavailable.","missing_gps");
 }
}
// ===================================================================
// V2 — ROUTE ALTERNATIVES, LIVE ETA, AUTO-REROUTE, VOICE NAVIGATION
// activeRoute holds everything about the currently-followed route so
// live GPS updates (auto-reroute, ETA, voice) can reference it.
// ===================================================================
let routeAlternatives = [];
let selectedAlternativeIndex = 0;
let activeRoute = null; // { coordinates, instructions, totalDistanceM, totalTimeMs, destLat, destLon, risks }
let voiceEnabled = false;
let lastSpokenInstructionIndex = -1;
let lastRerouteCheckTime = 0;
let announcedApproachingDestination = false;
let announcedArrivedDestination = false;
let routeRequestId = 0;
let lastRouteRequest = null; // used only by the Try again button in the route error card
let inFlightRouteKey = null; // prevents an identical duplicate route request while one is pending
function calculateRoute(startLat, startLon, endLat, endLon){
 if(![startLat,startLon].every(Number.isFinite)){ showRouteError("Your current location is unavailable.","missing_gps"); return; }
 if(![endLat,endLon].every(Number.isFinite)||endLat < -90||endLat > 90||endLon < -180||endLon > 180){ showRouteError("This place has invalid location data.","invalid_destination"); return; }
 const routeKey = startLat.toFixed(5) + "," + startLon.toFixed(5) + "->" +
 endLat.toFixed(5) + "," + endLon.toFixed(5);
 if (routeKey === inFlightRouteKey) {
 console.log("Duplicate route request for same start/end already in flight — skipping");
 return;
 }
 inFlightRouteKey = routeKey;
 lastRouteRequest = [startLat, startLon, endLat, endLon]; // UI retry bookkeeping only
 const thisRequestId = ++routeRequestId;
 const url = buildRouteUrl(startLat, startLon, endLat, endLon);
 console.log("Requesting route (with alternatives) from GraphHopper... id=" + thisRequestId);
 // CONFIRMED FIX (this pass): no AbortController/timeout existed here
 // previously — a route request that never resolves (dead network,
 // hung TCP connection, backend unreachable) would sit forever with
 // no failure ever surfacing, leaving inFlightRouteKey permanently set
 // and silently blocking all future route requests to that same
 // start/end pair. 12s gives real GraphHopper responses (including
 // the free-tier's occasional slow response) room to complete while
 // still surfacing a clear error instead of hanging indefinitely.
 const routeAbortController = new AbortController();
 const routeTimeoutHandle = setTimeout(function(){
 routeAbortController.abort();
 }, 12000);
 // SECURITY (Phase 11, Step 4): abuse-reduction header, NOT
 // cryptographic protection — this key is embedded in shipped client
 // code and readable by anyone who decompiles the APK. It raises the
 // bar against casual/scripted scraping of the bare endpoint; it does
 // not stop a determined reverse-engineer, and no claim to the
 // contrary should ever be made about it.
 fetch(url, {
 signal: routeAbortController.signal,
 headers: { "X-SafeRoute-Client-Key": SAFEROUTE_CLIENT_KEY }
 })
 .then(function(response){
 clearTimeout(routeTimeoutHandle);
 if (!response.ok) {
  var serviceError = new Error("Routing service returned HTTP " + response.status);
  serviceError.httpStatus=response.status;
  throw serviceError;
 }
 return response.json();
 })
 .then(function(data){
 if (inFlightRouteKey === routeKey) {
 inFlightRouteKey = null;
 }
 if (thisRequestId !== routeRequestId) {
 console.log("Ignoring stale route response id=" + thisRequestId + " (superseded by id=" + routeRequestId + ")");
 return;
 }
 if (data && data.fallback) {
  console.warn("Route backend did not provide a live provider result; showing truthful routing error.");
  showRouteError(data.message || "No live routing provider is configured. A real route cannot be shown until GraphHopper is connected.", "backend");
  return;
 }
 if (data.paths && data.paths.length > 0) {
 routeAlternatives = data.paths.map(function(path, index){
 const coordinates = path.points.coordinates;
 const risks = checkRouteRisk(coordinates);
 return {
 coordinates: coordinates,
 instructions: path.instructions || [],
 distanceM: path.distance,
 timeMs: path.time,
 risks: risks
 };
 });
 // Label alternatives: fastest = least time, shortest = least
 // distance, safest = fewest risk warnings (tie-break: time).
 let fastestIdx = 0, shortestIdx = 0, safestIdx = 0;
 routeAlternatives.forEach(function(alt, i){
 if (alt.timeMs < routeAlternatives[fastestIdx].timeMs) fastestIdx = i;
 if (alt.distanceM < routeAlternatives[shortestIdx].distanceM) shortestIdx = i;
 if (alt.risks.length < routeAlternatives[safestIdx].risks.length ||
 (alt.risks.length === routeAlternatives[safestIdx].risks.length && alt.timeMs < routeAlternatives[safestIdx].timeMs)) {
 safestIdx = i;
 }
 });
 routeAlternatives.forEach(function(alt){ alt.labels = []; });
 routeAlternatives[fastestIdx].labels.push("Fastest");
 routeAlternatives[shortestIdx].labels.push("Shortest");
 routeAlternatives[safestIdx].labels.push("Safest");
 console.log("Route alternatives found:", routeAlternatives.length);
 selectedAlternativeIndex = fastestIdx;
 selectAlternative(selectedAlternativeIndex, endLat, endLon);
 // If voice was already on before this NEW destination was
 // set, speak the summary now too (not just on the toggle
 // action). Switching between Fastest/Shortest/Safest for
 // the SAME destination goes through selectAlternative
 // directly and does not pass through here, so this never
 // re-announces for the same trip.
 announceRouteSummary();
 } else {
 console.error("GraphHopper returned no route");
 console.error(JSON.stringify(data));
 showRouteError(
 "No drivable route was found to this place.", "noroute"
 );
 }
 })
 .catch(function(fetchError){
 clearTimeout(routeTimeoutHandle);
 if (inFlightRouteKey === routeKey) {
 inFlightRouteKey = null;
 }
 if (thisRequestId !== routeRequestId) {
 console.log("Ignoring stale route error id=" + thisRequestId);
 return;
 }
 if (fetchError && fetchError.name === "AbortError") {
 console.error("Route request timed out after 12000ms, id=" + thisRequestId);
 showRouteError("The routing service took too long to respond. Please try again.", "timeout");
 return;
 }
 console.error("GraphHopper request failed");
 console.error(fetchError);
 var message=fetchError&&fetchError.httpStatus>=500?"Routing service is unavailable.":(fetchError&&fetchError.httpStatus?"Routing service is unavailable.":"Unable to reach the routing service.");
 showRouteError(message,fetchError&&fetchError.httpStatus?"backend":"network");
 });
}
// Reuses the existing routeInfoPanel (no new UI element) to show a
// clear message when routing fails — e.g. the GraphHopper free-tier
// rate limit we've confirmed hitting ("Minutely API limit heavily
// violated"), or no network. Previously this failed completely
// silently, leaving the user thinking the app was broken.
function showRouteError(message, kind){
 // Raw/backend text is logged for developers only, never shown to users.
 console.error("Route error shown to user:", message);
 let sub = "";
 if (kind === "timeout") { sub = "This is taking longer than expected. Please try again."; }
 else if (kind === "noroute") { sub = "No route was found to this place. Try a different destination."; }
 else if (kind === "invalid_destination") { sub = "Select a place with valid coordinates."; }
 else if (kind === "missing_gps") { sub = "Enable location services and try again."; }
 else if (kind === "backend") { sub = "The backend could not calculate a route."; }
 else if (kind === "network") { sub = "Check the network connection and try again."; }
 const startBtn = document.getElementById("startNavButton");
 window.__srStartHiddenByError = !!(startBtn && startBtn.style.display !== "none");
 if (window.__srStartHiddenByError) { startBtn.style.display = "none"; }
 routeInfoText.innerHTML =
 "<div role='alert' style='color:#ff9999;font-size:15px;line-height:1.4;font-weight:700;'><svg class='sr-i sr-i-sm' aria-hidden='true'><use href='#i-alert'/></svg> Unable to calculate this route.</div>" +
 "<div style='color:rgba(255,255,255,0.6);font-size:13px;margin:4px 0 8px;'>" + sub + "</div>" +
 (kind === "noroute" || !lastRouteRequest ? "" : "<button class='sr-act primary' onclick='window.__retryRoute()'>Try again</button>");
 routeInfoPanel.style.display = "block";
}
window.__retryRoute = function(){
 if (!lastRouteRequest) { return; }
 const startBtn = document.getElementById("startNavButton");
 if (window.__srStartHiddenByError && startBtn) { startBtn.style.display = "inline-flex"; }
 window.__srStartHiddenByError = false;
 routeInfoText.textContent = "Calculating route…";
 calculateRoute.apply(null, lastRouteRequest);
};
function selectAlternative(index, destLat, destLon){
 selectedAlternativeIndex = index;
 const alt = routeAlternatives[index];
 activeRoute = {
 coordinates: alt.coordinates,
 instructions: alt.instructions,
 totalDistanceM: alt.distanceM,
 totalTimeMs: alt.timeMs,
 destLat: destLat,
 destLon: destLon,
 risks: alt.risks
 };
 window.__srActiveRoute = activeRoute;
 lastSpokenInstructionIndex = -1;
 announcedApproachingDestination = false;
 announcedArrivedDestination = false;
 lastNearestRouteIndex = null; // reset windowed nav search — see trackNavigationProgress
 renderRoutePanel();
 drawRoute(alt.coordinates);
 drawAlternateRoutes();
}
function renderRoutePanel(){
 const alt = routeAlternatives[selectedAlternativeIndex];
 const distanceKm = (alt.distanceM / 1000).toFixed(2);
 const timeMin = Math.round(alt.timeMs / 60000);
 let panelHtml = "<div class='infoRow'><span>Distance</span><strong>" + distanceKm + " km</strong></div>" +
 "<div class='infoRow'><span>Time</span><strong>" + timeMin + " min</strong></div>";
 if (routeAlternatives.length > 1) {
 panelHtml += "<div class='altSelectorRow'>";
 routeAlternatives.forEach(function(a, i){
 const labelText = a.labels.length > 0 ? a.labels[0] : ("Option " + (i + 1));
 const isSelected = i === selectedAlternativeIndex;
 panelHtml += "<button class='altButton" + (isSelected ? " altButtonSelected" : "") +
 "' onclick='window.__selectAltFromUI(" + i + ")'>" + labelText + "</button>";
 });
 panelHtml += "</div>";
 }
 panelHtml += "<div class='infoRow' style='margin-top:8px;'><span>Voice Guidance</span>" +
 "<button id='voiceToggleButton' onclick='window.__toggleVoice()'>" +
 (voiceEnabled ? "<svg class='sr-i sr-i-sm' aria-hidden='true'><use href='#i-volume'/></svg>On" : "<svg class='sr-i sr-i-sm' aria-hidden='true'><use href='#i-volume-off'/></svg>Off") + "</button></div>";
 const aiRoute = window.SafeRouteAIEngine ? window.SafeRouteAIEngine.route() : null;
 if (aiRoute) {
 panelHtml += "<div class='sr-ai-assessment'><div class='sr-ai-assessment-title'>ROUTE CONTEXT SCREENING</div><div class='sr-ai-assessment-grid'>" +
 "<div class='sr-ai-metric'><b>" + aiRoute.risk + "</b><span>Risk</span></div>" +
 "<div class='sr-ai-metric'><b>" + (window.SafeRouteAIEngine.traffic().severity || "UNKNOWN") + "</b><span>Traffic</span></div>" +
 "<div class='sr-ai-metric'><b>" + (window.SafeRouteAIEngine.weather().risk || "UNKNOWN") + "</b><span>Weather</span></div>" +
 "<div class='sr-ai-metric'><b>" + (window.SafeRouteAIEngine.hazards().status === "STALE" ? "STALE" : window.SafeRouteAIEngine.hazards().risk) + "</b><span>Hazards</span></div>" +
 "<div class='sr-ai-metric'><b>" + (window.__srActiveRoute ? (window.__srActiveRoute.totalDistanceM / 1000).toFixed(1) + " km" : "N/A") + "</b><span>Route distance</span></div>" +
 "<div class='sr-ai-metric'><b class='sr-data-badge sr-data-" + aiRoute.status.toLowerCase() + "'>" + aiRoute.status + "</b><span>Data state</span></div>" +
 "</div></div>";
 }
 if (alt.risks.length > 0) {
 const level = alt.risks.length >= 2 ? "HIGH" : "MEDIUM";
 const levelColor = alt.risks.length >= 2 ? "#ff6b6b" : "#f5a623";
 panelHtml += "<div class='routeSectionDivider' style='color:" + levelColor + ";font-weight:bold;'>" +
 "<svg class='sr-i sr-i-sm' aria-hidden='true'><use href='#i-alert'/></svg> Route Safety: " + level + " (" + alt.risks.length + " zone" + (alt.risks.length > 1 ? "s" : "") + ")</div>";
 alt.risks.forEach(function(r){
 const lower = r.reason.toLowerCase();
 let riskType = "Hazard zone";
 if (lower.indexOf("landslide") !== -1) { riskType = "Landslide risk"; }
 else if (lower.indexOf("flood") !== -1 || lower.indexOf("glof") !== -1 || lower.indexOf("dam") !== -1 || lower.indexOf("rainfall") !== -1) { riskType = "Flood risk"; }
 panelHtml += "<div style='color:#ff9999;font-size:12px;margin-top:6px;line-height:1.4;'>• <strong>" + riskType + ":</strong> " + r.reason + "</div>";
 });
 panelHtml += "<div style='color:rgba(255,255,255,0.5);font-size:10px;margin-top:6px;'>Calculated risk from known hazard data — not an official government alert.</div>";
 } else {
 panelHtml += "<div class='routeSectionDivider' style='color:#8fdc8f;font-weight:bold;'><svg class='sr-i sr-i-sm' aria-hidden='true'><use href='#i-check'/></svg> Route Safety: LOW — no known risk zones detected on this route</div>";
 }
 routeInfoText.innerHTML = panelHtml;
 routeInfoPanel.style.display = "block";
}
// Exposed to window so the inline onclick handlers in the dynamically
// generated panel HTML above can reach these (innerHTML content can't
// use closures directly).
window.__selectAltFromUI = function(index){
 selectAlternative(index, activeRoute.destLat, activeRoute.destLon);
};
// Speaks the real route summary (distance/time) plus any known hazard
// zones this specific route crosses (reusing the exact, already-
// verified checkRouteRisk text — never invented). Called both when
// voice is toggled ON with an active route, and automatically when a
// NEW destination's route is calculated while voice is already on.
function announceRouteSummary(){
 if (!activeRoute) { return; }
 const distKm = (activeRoute.totalDistanceM / 1000).toFixed(1);
 const timeMin = Math.round(activeRoute.totalTimeMs / 60000);
 speak("Starting navigation. Distance is " + distKm + " kilometers. Estimated travel time is " + timeMin + " minutes.");
 if (activeRoute.risks && activeRoute.risks.length > 0) {
 activeRoute.risks.forEach(function(r){
 speak("Caution. " + r.reason + ".");
 });
 }
}
window.__toggleVoice = function(){
 voiceEnabled = !voiceEnabled;
 if (voiceEnabled) {
 if (activeRoute) {
 announceRouteSummary();
 } else {
 speak("Voice guidance on.");
 }
 } else if (window.speechSynthesis) {
 window.speechSynthesis.cancel();
 }
 renderRoutePanel();
};
// ===================================================================
// CONFIRMED ROOT CAUSE (this pass): drawRoute() batches ALL height
// sampling into one sampleHeightMostDetailed() call (already the right
// pattern vs. per-point calls), but for a real long mountain route this
// can be 500+ points in a SINGLE call — and it fires every time a route
// is (re)drawn, including every auto-reroute (checked every 8s while
// off-route — plausible for a while on mountain roads with GPS drift).
// That's a genuine recurring burst tied specifically to active
// navigation, not a one-off startup cost like the earlier fixes.
//
// FIX: sample height at a BOUNDED number of points along the route
// (120, matching the same bounded-work-budget pattern already used for
// OSM_MAX_LABELS elsewhere in this file) instead of every point. Each
// unsampled point reuses its nearest sampled neighbor's height —
// visually indistinguishable for a route line at normal driving-camera
// zoom (height only needs to roughly hug the terrain so the line
// doesn't float or clip; it doesn't need per-point precision), while
// cutting a 500-point route's sampling payload by ~75%. The line's
// actual ground path (lat/lon) is completely unaffected — only which
// points get an independently-sampled height is reduced.
// ===================================================================
const ROUTE_HEIGHT_SAMPLE_BUDGET = 120;
function buildRouteHeightSampleIndices(totalPoints){
 if (totalPoints <= ROUTE_HEIGHT_SAMPLE_BUDGET) {
 // Short route — sample every point, nothing to save.
 const all = [];
 for (let i = 0; i < totalPoints; i++) { all.push(i); }
 return all;
}
 const stride = (totalPoints - 1) / (ROUTE_HEIGHT_SAMPLE_BUDGET - 1);
 const indices = [];
 for (let i = 0; i < ROUTE_HEIGHT_SAMPLE_BUDGET; i++) {
 indices.push(Math.round(i * stride));
 }
 return indices;
}
function drawRoute(coordinates){
 if (window.__sr2dSetRoute) { window.__sr2dSetRoute(coordinates); }
 if (routeEntity) {
 viewer.entities.remove(routeEntity);
 routeEntity = null;
 }
 const sampleIndices = buildRouteHeightSampleIndices(coordinates.length);
 const sampleCartographics = sampleIndices.map(function(i){
 return Cesium.Cartographic.fromDegrees(coordinates[i][0], coordinates[i][1]);
 });
 viewer.scene.sampleHeightMostDetailed(sampleCartographics).then(function(){
 // Assign each full-resolution point the height of its NEAREST
 // sampled neighbor (by index distance along the route, which
 // correlates with physical distance for a road polyline).
 const positions = coordinates.map(function(coord, pointIndex){
 let nearestSampleI = 0;
 let nearestDist = Infinity;
 for (let s = 0; s < sampleIndices.length; s++) {
 const d = Math.abs(sampleIndices[s] - pointIndex);
 if (d < nearestDist) { nearestDist = d; nearestSampleI = s; }
 }
 const c = sampleCartographics[nearestSampleI];
 const height = Cesium.defined(c.height) ? c.height + 2 : 2;
 return Cesium.Cartesian3.fromDegrees(coord[0], coord[1], height);
 });
 routeEntity = viewer.entities.add({
 polyline: {
 positions: positions,
 width: 8,
 material: new Cesium.PolylineOutlineMaterialProperty({
 color: Cesium.Color.fromCssColorString("#3b82f6"),
 outlineWidth: 2,
 outlineColor: Cesium.Color.fromCssColorString("#0b2a5c")
 }),
 disableDepthTestDistance: Number.POSITIVE_INFINITY
 }
 });
 console.log("Route drawn with", positions.length, "points (" + sampleIndices.length + " height-sampled)");
 }).catch(function(heightError){
 console.error("Route height sampling failed, drawing at approximate height");
 console.error(heightError);
 const fallbackPositions = coordinates.map(function(coord){
 return Cesium.Cartesian3.fromDegrees(coord[0], coord[1], 2);
 });
 routeEntity = viewer.entities.add({
 polyline: {
 positions: fallbackPositions,
 width: 8,
 material: new Cesium.PolylineOutlineMaterialProperty({
 color: Cesium.Color.fromCssColorString("#3b82f6"),
 outlineWidth: 2,
 outlineColor: Cesium.Color.fromCssColorString("#0b2a5c")
 }),
 disableDepthTestDistance: Number.POSITIVE_INFINITY
 }
 });
 });
}
// Draws the OTHER (non-selected) route alternatives as thin, muted
// lines for context — tapping an alt button (selectAlternative) still
// swaps which one is the bold, colored "active" route.
let alternateRouteEntities = [];
function drawAlternateRoutes(){
 alternateRouteEntities.forEach(function(e){ viewer.entities.remove(e); });
 alternateRouteEntities = [];
 routeAlternatives.forEach(function(alt, index){
 if (index === selectedAlternativeIndex) { return; }
 const positions = alt.coordinates.map(function(coord){
 return Cesium.Cartesian3.fromDegrees(coord[0], coord[1], 2);
 });
 const entity = viewer.entities.add({
 polyline: {
 positions: positions,
 width: 4,
 material: Cesium.Color.fromCssColorString("#ffffff").withAlpha(0.35),
 disableDepthTestDistance: Number.POSITIVE_INFINITY
 }
 });
 alternateRouteEntities.push(entity);
 });
}
// ===================================================================
// PHASE 7 — TAXI (simulated demo)
// No real backend/driver data exists yet, so these taxis are
// SIMULATED — fixed starting points that nudge randomly every few
// seconds to look like movement. Tapping a taxi shows its info and
// a "Request This Taxi" button, which reuses the existing navigation
// system to draw a real road route from the user to that taxi.
// ===================================================================
const taxiData = [
 { id: "taxi1", name: "Taxi 1 — Driver Pemba", lat: 27.1770, lon: 88.5280 },
 { id: "taxi2", name: "Taxi 2 — Driver Tashi", lat: 27.1790, lon: 88.5310 },
 { id: "taxi3", name: "Taxi 3 — Driver Norden", lat: 27.1740, lon: 88.5265 },
 { id: "taxi4", name: "Taxi 4 — Driver Karma", lat: 27.1800, lon: 88.5250 },
 { id: "taxi5", name: "Taxi 5 — Driver Sonam", lat: 27.1755, lon: 88.5325 }
];
const taxiInfoPanel = document.getElementById("taxiInfoPanel");
const taxiInfoText = document.getElementById("taxiInfoText");
const requestTaxiButton = document.getElementById("requestTaxiButton");
let selectedTaxi = null;
function addTaxiMarkers(){
 const pinBuilder = new Cesium.PinBuilder();
 const taxiPin = pinBuilder.fromText("T", Cesium.Color.fromCssColorString("#f5b400"), 32);
 taxiData.forEach(function(taxi){
 const entity = viewer.entities.add({
 position: Cesium.Cartesian3.fromDegrees(taxi.lon, taxi.lat, 0),
 billboard: {
 image: taxiPin.toDataURL(),
 verticalOrigin: Cesium.VerticalOrigin.BOTTOM,
 scale: 0.85,
 disableDepthTestDistance: Number.POSITIVE_INFINITY,
 distanceDisplayCondition: new Cesium.DistanceDisplayCondition(0.0, 6000.0)
 }
 });
 entity.taxiInfo = taxi;
 taxi.entity = entity;
 refineEntityHeight(entity, taxi.lat, taxi.lon);
 });
 console.log("Taxi markers added:", taxiData.length);
 setupTaxiCluster();
}
// ===================================================================
// TAXI CLUSTER-LITE
// Individual taxis (via distanceDisplayCondition above) only show
// within ~6km of the camera. Beyond that, a single small badge shows
// the count instead — a lightweight form of clustering that avoids
// clutter when zoomed out, without a full clustering library.
// ===================================================================
let taxiClusterEntity = null;
function setupTaxiCluster(){
 const avgLat = taxiData.reduce(function(sum, t){ return sum + t.lat; }, 0) / taxiData.length;
 const avgLon = taxiData.reduce(function(sum, t){ return sum + t.lon; }, 0) / taxiData.length;
 const pinBuilder = new Cesium.PinBuilder();
 const clusterPin = pinBuilder.fromText(String(taxiData.length), Cesium.Color.fromCssColorString("#f5b400"), 30);
 taxiClusterEntity = viewer.entities.add({
 position: Cesium.Cartesian3.fromDegrees(avgLon, avgLat, 0),
 billboard: {
 image: clusterPin.toDataURL(),
 verticalOrigin: Cesium.VerticalOrigin.BOTTOM,
 scale: 0.85,
 disableDepthTestDistance: Number.POSITIVE_INFINITY,
 distanceDisplayCondition: new Cesium.DistanceDisplayCondition(6000.0, 5000000.0)
 }
 });
 refineEntityHeight(taxiClusterEntity, avgLat, avgLon);
}
// ===================================================================
// PERFORMANCE FIX (confirmed root cause #4): simulateTaxiMovement() runs
// on an unconditional setInterval every 4 seconds for the lifetime of
// the app (see setInterval(simulateTaxiMovement, 4000) below), and every
// single tick previously ran a real sampleHeightMostDetailed() terrain
// query against the Photorealistic 3D Tiles — regardless of whether the
// taxis are even on screen or the tileset is zoomed in enough for it to
// matter. That is a genuinely expensive, continuously-recurring
// background cost that runs forever, independent of user activity, and
// is a real contributor to lag that accumulates the longer the app has
// been open. Height is now only re-sampled every 3rd tick (~12s) and
// skipped entirely when the camera is too high up for the ~2m accuracy
// to be visually meaningful anyway.
// ===================================================================
const TAXI_HEIGHT_REFINE_EVERY_N_TICKS = 3;
const TAXI_HEIGHT_REFINE_MAX_CAMERA_HEIGHT_M = 8000;
let taxiSimulationTickCount = 0;
function simulateTaxiMovement(){
 taxiSimulationTickCount++;
 taxiData.forEach(function(taxi){
 taxi.lat += (Math.random() - 0.5) * 0.001;
 taxi.lon += (Math.random() - 0.5) * 0.001;
 if (taxi.entity) {
 taxi.entity.position = Cesium.Cartesian3.fromDegrees(taxi.lon, taxi.lat, 0);
 }
 });
 const shouldRefineHeight = (taxiSimulationTickCount % TAXI_HEIGHT_REFINE_EVERY_N_TICKS === 0) &&
 (viewer.camera.positionCartographic.height <= TAXI_HEIGHT_REFINE_MAX_CAMERA_HEIGHT_M);
 if (!shouldRefineHeight) { return; }
 // Batched height lookup: one request covering all 5 taxis, instead
 // of 5 separate requests — much lighter on performance.
 const cartographics = taxiData.map(function(t){ return Cesium.Cartographic.fromDegrees(t.lon, t.lat); });
 viewer.scene.sampleHeightMostDetailed(cartographics).then(function(){
 taxiData.forEach(function(taxi, index){
 if (taxi.entity && Cesium.defined(cartographics[index]) && Cesium.defined(cartographics[index].height)) {
 taxi.entity.position = Cesium.Cartesian3.fromRadians(
 cartographics[index].longitude,
 cartographics[index].latitude,
 cartographics[index].height
 );
 }
 });
 }).catch(function(err){
 console.error("Batched taxi height refine failed");
 console.error(err);
 });
}
addTaxiMarkers();
// ===================================================================
// PHASE 8 (partial) — LIVE RAINFALL RISK WARNING
// Real live data from Open-Meteo (free, no API key required). This is
// a RAINFALL-BASED PROXY for flood/landslide risk, not a true river
// gauge or landslide sensor network — no simple public API for that
// exists yet for Sikkim. Chungthang is included specifically because
// it's where the Teesta III Dam was destroyed by a glacial lake
// outburst flood (GLOF) in October 2023 — a real, historically
// significant risk point for this region.
// Threshold: 10mm/hr+ current rainfall is flagged as elevated risk.
// This should be upgraded to real river-gauge data once/if Google
// Flood Hub API access is approved (see Section 8 of the handoff doc).
// ===================================================================
const weatherLocations = [
 { name: "Gangtok", lat: 27.3389, lon: 88.6065 },
 { name: "Namchi", lat: 27.1663, lon: 88.3639 },
 { name: "Gyalshing", lat: 27.2896, lon: 88.2597 },
 { name: "Mangan", lat: 27.5083, lon: 88.5322 },
 { name: "Chungthang", lat: 27.6167, lon: 88.6333 }
];
const RAIN_RISK_THRESHOLD_MM = 10;
const weatherRiskPanel = document.getElementById("weatherRiskPanel");
const weatherRiskText = document.getElementById("weatherRiskText");
const safetySheetClose = document.getElementById("safetySheetClose");
const safetyChip = document.getElementById("safetyChip");
const safetyChipText = document.getElementById("safetyChipText");
safetyChip.addEventListener("click", function(){
 const isOpen = weatherRiskPanel.style.display === "block";
 closeAllSheets();
 weatherRiskPanel.style.display = isOpen ? "none" : "block";
});
safetySheetClose.addEventListener("click", function(){
 weatherRiskPanel.style.display = "none";
});
let isFetchingWeather = false;
let lastWeatherFetchTime = 0;
const WEATHER_MIN_INTERVAL_MS = 60000; // do not re-fetch more than once/minute
async function fetchWeatherRisk(){
 if (isFetchingWeather) {
 console.log("Weather fetch already in progress — skipping duplicate call");
 return;
 }
 const now = Date.now();
 if (now - lastWeatherFetchTime < WEATHER_MIN_INTERVAL_MS &&
 latestWeatherResults.length > 0) {
 console.log(
 "Reusing recent weather data (" +
 Math.round((now - lastWeatherFetchTime) / 1000) +
 "s old)"
 );
 return;
 }
 isFetchingWeather = true;
 const controller=new AbortController();
 const timeout=setTimeout(function(){controller.abort();},12000);
 try{
  const received=await Promise.all(weatherLocations.map(async function(loc){
   try{
    const url="https://api.open-meteo.com/v1/forecast?latitude="+loc.lat+"&longitude="+loc.lon+"&current=precipitation&timezone=auto";
    const response=await fetch(url,{signal:controller.signal});
    if(!response.ok)throw new Error("Open-Meteo returned HTTP "+response.status);
    const data=await response.json();
    if(!(data.current&&typeof data.current.precipitation==="number"))throw new Error("precipitation missing for "+loc.name);
    return {name:loc.name,precipitation:data.current.precipitation};
   }catch(weatherError){
    console.warn("Weather fetch failed for "+loc.name+": "+(weatherError.name==="AbortError"?"request timed out":weatherError.message));
    return null;
   }
  }));
  const results=received.filter(Boolean);
  latestWeatherResults=results;
  window.__srLatestWeatherResults=results;
  window.__srWeatherFetchedAt=new Date().toISOString();
  lastWeatherFetchTime=Date.now();
  updateWeatherRiskPanel(results);
 }finally{
  clearTimeout(timeout);
  isFetchingWeather=false;
 }
}
function updateWeatherRiskPanel(results){
 if (results.length === 0) {
 console.error("No weather results to display");
 safetyChipText.textContent = "Safety data unavailable";
 safetyChip.classList.remove("sr-chip-safe");
 safetyChip.classList.remove("sr-chip-warn");
 safetyChip.classList.add("sr-chip-pending");
 weatherRiskText.innerHTML = "<div class='sr-note'>Rainfall data unavailable right now. No risk level is shown.</div>";
 var rt = document.getElementById("srRainTag"); if (rt) { rt.textContent = "Data unavailable"; }
 return;
 }
 let html = "";
 let anyRisk = false;
 results.forEach(function(r){
 const risky = r.precipitation >= RAIN_RISK_THRESHOLD_MM;
 if (risky) { anyRisk = true; }
 html += "<div class='infoRow" + (risky ? " riskyRow" : "") + "'><span>" + r.name + "</span><strong>" +
 r.precipitation.toFixed(1) + " mm/hr</strong></div>";
 if (risky) {
 html += "<div class='riskyNote'><svg class='sr-i sr-i-sm' aria-hidden='true'><use href='#i-alert'/></svg>Elevated Risk</div>";
 }
 });
 weatherRiskText.innerHTML = html;
 // Update the compact chip only — the full sheet stays closed unless
 // the user explicitly taps the chip to open it (progressive
 // disclosure, doesn't cover the map by default).
 if (anyRisk) {
 safetyChipText.textContent = "Rainfall: ELEVATED";
 safetyChip.classList.remove("sr-chip-pending");
 var rt1 = document.getElementById("srRainTag"); if (rt1) { rt1.textContent = "Monitoring"; }
 safetyChip.classList.remove("sr-chip-safe");
 safetyChip.classList.add("sr-chip-warn");
 } else {
 safetyChipText.textContent = "Rainfall: LOW";
 safetyChip.classList.remove("sr-chip-pending");
 var rt2 = document.getElementById("srRainTag"); if (rt2) { rt2.textContent = "Monitoring"; }
 safetyChip.classList.remove("sr-chip-warn");
 safetyChip.classList.add("sr-chip-safe");
 }
 console.log("Weather risk check complete. Elevated risk detected:", anyRisk);
}
fetchWeatherRisk();
setInterval(fetchWeatherRisk, 600000);
window.__srBridge = { resources: resourceData, route: setDestination,
 retryWeather: function(){ isFetchingWeather = false; lastWeatherFetchTime = 0; fetchWeatherRisk(); } };
// POI categories: extends the existing Overpass setup (same endpoint, same viewport-bbox method,
// bounded cache, throttle). Only real OSM fields are returned.
const POI_DEFS = {
hotels:{label:"Hotels",selectors:['["tourism"~"hotel|guest_house|hostel|motel"]'],valid:function(t){return /^(hotel|guest_house|hostel|motel)$/.test(t.tourism||"");}},
food:{label:"Food",selectors:['["amenity"~"restaurant|fast_food|food_court"]'],valid:function(t){return /^(restaurant|fast_food|food_court)$/.test(t.amenity||"");}},
cafes:{label:"Cafes",selectors:['["amenity"="cafe"]'],valid:function(t){return t.amenity==="cafe";}},
fuel:{label:"Fuel",selectors:['["amenity"="fuel"]'],valid:function(t){return t.amenity==="fuel";}},
parking:{label:"Parking",selectors:['["amenity"="parking"]'],valid:function(t){return t.amenity==="parking";}},
tourist_places:{label:"Tourist places",selectors:['["tourism"~"attraction|museum|gallery|zoo|theme_park"]'],valid:function(t){return /^(attraction|museum|gallery|zoo|theme_park)$/.test(t.tourism||"");}},
viewpoints:{label:"Viewpoints",selectors:['["tourism"="viewpoint"]'],valid:function(t){return t.tourism==="viewpoint";}},
attractions:{label:"Attractions",selectors:['["historic"]','["amenity"="place_of_worship"]'],valid:function(t){return Boolean(t.historic)||t.amenity==="place_of_worship";}},
pharmacies:{label:"Pharmacies",selectors:['["amenity"="pharmacy"]'],valid:function(t){return t.amenity==="pharmacy";}},
atms:{label:"ATMs",selectors:['["amenity"="atm"]'],valid:function(t){return t.amenity==="atm";}},
ev_charging:{label:"EV charging",selectors:['["amenity"="charging_station"]'],valid:function(t){return t.amenity==="charging_station";}}
};
const poiCache = new Map();
const POI_CACHE_MAX_ENTRIES = 40;
const POI_CACHE_TTL_MS = 300000;
let lastPoiFetch = 0;
let activePoiRequest = null;
let activePoiCategory = null;
let poiRequestGeneration = 0;
function getPoiViewRectangle(){
 const view=window.__sr2dGetView&&window.__sr2dGetView();
 const map=document.getElementById("sr2dMap");
 if(view&&view.mode==="2d"&&map){
  const worldSize=256*Math.pow(2,view.zoom);
  const centerX=(view.lon+180)/360*worldSize;
  const latitude=Math.max(-85.05112878,Math.min(85.05112878,view.lat))*Math.PI/180;
  const centerY=(1-Math.asinh(Math.tan(latitude))/Math.PI)/2*worldSize;
  const west=centerX-map.clientWidth/2,east=centerX+map.clientWidth/2;
  const north=Math.max(0,centerY-map.clientHeight/2),south=Math.min(worldSize,centerY+map.clientHeight/2);
  const longitudeForX=function(x){return x/worldSize*360-180;};
  const latitudeForY=function(y){return Math.atan(Math.sinh(Math.PI*(1-2*y/worldSize)))*180/Math.PI;};
  return {south:latitudeForY(south)*Math.PI/180,west:longitudeForX(west)*Math.PI/180,north:latitudeForY(north)*Math.PI/180,east:longitudeForX(east)*Math.PI/180};
 }
 try{return viewer.camera.computeViewRectangle();}catch(error){return null;}
}
function waitForPoiRetry(controller, delayMs){
 return new Promise(function(resolve,reject){
 if(controller.signal.aborted){reject(new DOMException("POI request was superseded.","AbortError"));return;}
 var timer=setTimeout(done,delayMs);
 function done(){controller.signal.removeEventListener("abort",abort);resolve();}
 function abort(){clearTimeout(timer);controller.signal.removeEventListener("abort",abort);reject(new DOMException("POI request was superseded.","AbortError"));}
 controller.signal.addEventListener("abort",abort,{once:true});
 });
}
async function fetchPoiQuery(query, controller){
 var lastError=null;
 for(var attempt=0;attempt<2;attempt++){
 if(controller.signal.aborted) throw new DOMException("POI request was superseded.","AbortError");
 var attemptController=new AbortController(),timedOut=false;
 var abortFromSelection=function(){attemptController.abort();};
 controller.signal.addEventListener("abort",abortFromSelection,{once:true});
 var timeout=setTimeout(function(){timedOut=true;attemptController.abort();},10000);
 try{
  var response=await fetch("https://overpass-api.de/api/interpreter",{
   method:"POST",
   headers:{"Accept":"application/json","Content-Type":"application/x-www-form-urlencoded; charset=UTF-8"},
   body:"data="+encodeURIComponent(query),
   signal:attemptController.signal
  });
  if(!response.ok){var httpError=new Error("Overpass HTTP "+response.status);httpError.status=response.status;throw httpError;}
  return {data:await response.json(),attempts:attempt+1};
 }catch(error){
  if(controller.signal.aborted) throw new DOMException("POI request was superseded.","AbortError");
  error.poiTimedOut=timedOut;
  lastError=error;
  var retryable=timedOut||error.status===429||error.status>=500||error instanceof TypeError;
  if(attempt===0&&retryable){await waitForPoiRetry(controller,500);continue;}
  throw error;
 }finally{
  clearTimeout(timeout);
  controller.signal.removeEventListener("abort",abortFromSelection);
 }
 }
 throw lastError||new Error("Overpass request failed.");
}
window.__srPoi = { defs: POI_DEFS, fetch: function(key, cb){
 const def = POI_DEFS[key];
 if (!def) { return; }
 activePoiCategory = key;
 const requestGeneration = ++poiRequestGeneration;
 if(activePoiRequest){activePoiRequest.abort();activePoiRequest=null;}
 if (!navigator.onLine) { cb({status:"offline"}); return; }
 if (viewer.camera.positionCartographic.height > OSM_MAX_CAMERA_HEIGHT_M) { cb({status:"zoom"}); return; }
 let rect = getPoiViewRectangle();
 if (!rect) { cb({status:"zoom"}); return; }
 const bbox = [rect.south, rect.west, rect.north, rect.east].map(function(r){ return Cesium.Math.toDegrees(r).toFixed(2); }).join(",");
 const ck = key + "|" + bbox;
 if (poiCache.has(ck)) {
 const cached=poiCache.get(ck);
 if(Date.now()-cached.timestamp<=POI_CACHE_TTL_MS){
  if(activePoiCategory!==key||requestGeneration!==poiRequestGeneration)return;
  cb({status:"cached",items:cached.items.filter(function(item){return item.category===key&&def.valid(item.tags||{});}),cachedAt:cached.timestamp,label:def.label});
  return;
 }
 poiCache.delete(ck);
 }
 if (Date.now() - lastPoiFetch < 2000) { cb({status:"busy"}); return; }
 lastPoiFetch = Date.now();
 cb({status:"loading"});
 if(window.__sr2dSetPois)window.__sr2dSetPois([]);
 let q = "[out:json][timeout:8];(";
 def.selectors.forEach(function(sel){ q += "node" + sel + "(" + bbox + ");way" + sel + "(" + bbox + ");"; });
 q += ");out center 60;";
 const ctl = new AbortController(); activePoiRequest=ctl;
 fetchPoiQuery(q,ctl)
 .then(function(result){
 const data=result.data;
  let invalidCount = 0;
  let items = (data.elements || []).map(function(el){
   const t = el.tags || {}; if(!def.valid(t)) { return null; } const lat = Number(el.lat || (el.center && el.center.lat)); const lon = Number(el.lon || (el.center && el.center.lon));
   if (!Number.isFinite(lat) || !Number.isFinite(lon) || lat < -90 || lat > 90 || lon < -180 || lon > 180) { invalidCount++; return null; }
   const d = (lastUserLat !== null && lastUserLon !== null) ? haversineDistanceKm(lastUserLat, lastUserLon, lat, lon) : null;
   return { name: t.name || t.brand || t.operator || null, lat: lat, lon: lon, latitude: lat, longitude: lon, category: key, source: "OpenStreetMap", tags: t, osm: el.type + "/" + el.id, km: d };
  }).filter(function(x){ return x; });
  items.sort(function(a,b){ return (a.km === null ? 1e9 : a.km) - (b.km === null ? 1e9 : b.km); });
  if (poiCache.size >= POI_CACHE_MAX_ENTRIES && !poiCache.has(ck)) { poiCache.delete(poiCache.keys().next().value); }
  const cachedAt=Date.now();
  poiCache.set(ck,{items:items,timestamp:cachedAt});
  if(activePoiRequest===ctl){activePoiRequest=null;}
  if(activePoiCategory===key&&requestGeneration===poiRequestGeneration){
   const validItems=items.filter(function(item){return item.category===key&&def.valid(item.tags||{});});
   if(window.__sr2dSetPois)window.__sr2dSetPois(validItems);
   cb({status:validItems.length?"ok":(invalidCount?"invalid":"empty"),items:validItems,label:def.label,attempts:result.attempts,cachedAt:cachedAt});
  }
 }).catch(function(err){
  if(activePoiRequest===ctl){activePoiRequest=null;}
  if(err&&err.name==="AbortError")return;
  if(activePoiCategory===key&&requestGeneration===poiRequestGeneration){
   const timedOut=Boolean(err&&err.poiTimedOut)||Boolean(err&&(err.status===408||err.status===504));
   if(timedOut)cb({status:"timeout",label:def.label});
   else{console.error("POI fetch failed");cb({status:"error",label:def.label});}
  }
 });
} };
setInterval(simulateTaxiMovement, 4000);
function showTaxiInfo(taxi){
 selectedTaxi = taxi;
 taxiInfoText.textContent = taxi.name + " (simulated) — tap below to route to it";
 taxiInfoPanel.style.display = "block";
}
requestTaxiButton.addEventListener("click", function(){
 if (selectedTaxi) {
 taxiInfoPanel.style.display = "none";
 setDestination(selectedTaxi.lat, selectedTaxi.lon);
 }
});
viewer.screenSpaceEventHandler.setInputAction(function(movement){
 const pickedObject = viewer.scene.pick(movement.position);
 if (Cesium.defined(pickedObject) && Cesium.defined(pickedObject.id) && Cesium.defined(pickedObject.id.taxiInfo)) {
 showTaxiInfo(pickedObject.id.taxiInfo);
 return;
 }
 taxiInfoPanel.style.display = "none";
 const cartesian = viewer.scene.pickPosition(movement.position);
 if (Cesium.defined(cartesian)) {
 const cartographic = Cesium.Cartographic.fromCartesian(cartesian);
 const tappedLat = Cesium.Math.toDegrees(cartographic.latitude);
 const tappedLon = Cesium.Math.toDegrees(cartographic.longitude);
 setDestination(tappedLat, tappedLon);
 } else {
 console.error("Tap did not hit any surface — try tapping directly on visible terrain/buildings");
 }
}, Cesium.ScreenSpaceEventType.LEFT_CLICK);
console.log("Tap-to-navigate enabled");
const resourceEntitiesByType = { hospital: [], police: [] };
const placeLabelEntities = [];
function addResourceMarkers(){
 const resourceEntitiesForHeightRefine = [];
 const resourceCartographicsForHeightRefine = [];
 const pinBuilder = new Cesium.PinBuilder();
 resourceData.forEach(function(resource){
 let pinCanvas;
 if (resource.type === "hospital") {
 pinCanvas = pinBuilder.fromText("+", Cesium.Color.RED, 48);
 } else if (resource.type === "police") {
 pinCanvas = pinBuilder.fromText("P", Cesium.Color.BLUE, 48);
 } else if (resource.type === "dam") {
 pinCanvas = pinBuilder.fromText("D", Cesium.Color.ORANGE, 48);
 } else {
 pinCanvas = pinBuilder.fromText("?", Cesium.Color.GRAY, 48);
 }
 const newEntity = viewer.entities.add({
 name: resource.name,
 position: Cesium.Cartesian3.fromDegrees(resource.lon, resource.lat, 0),
 billboard: {
 image: pinCanvas.toDataURL(),
 verticalOrigin: Cesium.VerticalOrigin.BOTTOM,
 scale: 0.75,
 disableDepthTestDistance: Number.POSITIVE_INFINITY,
 distanceDisplayCondition: new Cesium.DistanceDisplayCondition(0.0, 15000.0)
 },
 label: {
 text: resource.name,
 font: "12px sans-serif",
 fillColor: Cesium.Color.WHITE,
 outlineColor: Cesium.Color.BLACK,
 outlineWidth: 3,
 style: Cesium.LabelStyle.FILL_AND_OUTLINE,
 verticalOrigin: Cesium.VerticalOrigin.TOP,
 pixelOffset: new Cesium.Cartesian2(0, 5),
 disableDepthTestDistance: Number.POSITIVE_INFINITY,
 distanceDisplayCondition: new Cesium.DistanceDisplayCondition(0.0, 2500.0)
 }
 });
 if (resourceEntitiesByType[resource.type]) { resourceEntitiesByType[resource.type].push(newEntity); }
 resourceEntitiesForHeightRefine.push(newEntity);
 resourceCartographicsForHeightRefine.push(Cesium.Cartographic.fromDegrees(resource.lon, resource.lat));
 });
 console.log("Resource markers added:", resourceData.length);
 // CONFIRMED FIX (this pass): previously called refineEntityHeight()
 // individually per resource marker — resourceData.length (~17)
 // separate sampleHeightMostDetailed() promises fired back-to-back at
 // startup. Batched into one call, same pattern already used for OSM
 // places and taxis.
 if (resourceCartographicsForHeightRefine.length > 0) {
 viewer.scene.sampleHeightMostDetailed(resourceCartographicsForHeightRefine).then(function(){
 resourceEntitiesForHeightRefine.forEach(function(entity, i){
 const c = resourceCartographicsForHeightRefine[i];
 if (Cesium.defined(c.height)) {
 entity.position = Cesium.Cartesian3.fromRadians(c.longitude, c.latitude, c.height);
 }
 });
 }).catch(function(err){
 console.error("Batched resource marker height refine failed (markers still visible at approximate height)");
 console.error(err);
 });
 }
}
addResourceMarkers();
// ===================================================================
// TOWN / DISTRICT NAME LABELS
// The flat base map (with its own place-name labels) is hidden now
// that the 3D tileset is the ground surface (globe: false), so we add
// our own bold labels for major towns and all six district headquarters
// so tourists/locals can still orient themselves by name.
// ===================================================================
const placeLabels = [
 { name: "GANGTOK", district: true, lat: 27.3389, lon: 88.6065 },
 { name: "PAKYONG", district: true, lat: 27.2306, lon: 88.6138 },
 { name: "NAMCHI", district: true, lat: 27.1663, lon: 88.3639 },
 { name: "SORENG", district: true, lat: 27.1683, lon: 88.1874 },
 { name: "GYALSHING", district: true, lat: 27.2896, lon: 88.2597 },
 { name: "MANGAN", district: true, lat: 27.5083, lon: 88.5322 },
 { name: "Rangpo", district: false, lat: 27.176147, lon: 88.528734 },
 { name: "Majitar", district: false, lat: 27.187601, lon: 88.499709 },
 { name: "Singtam", district: false, lat: 27.2296952, lon: 88.4946887 },
 { name: "Ranipool", district: false, lat: 27.2936311, lon: 88.5908099 }
];
function addPlaceLabels(){
 const labelEntitiesForHeightRefine = [];
 const labelCartographicsForHeightRefine = [];
 placeLabels.forEach(function(place){
 const newEntity = viewer.entities.add({
 position: Cesium.Cartesian3.fromDegrees(place.lon, place.lat, 0),
 label: {
 text: place.name,
 font: place.district ? "bold 20px sans-serif" : "14px sans-serif",
 fillColor: place.district ? Cesium.Color.YELLOW : Cesium.Color.WHITE,
 outlineColor: Cesium.Color.BLACK,
 outlineWidth: 4,
 style: Cesium.LabelStyle.FILL_AND_OUTLINE,
 verticalOrigin: Cesium.VerticalOrigin.CENTER,
 disableDepthTestDistance: Number.POSITIVE_INFINITY,
 distanceDisplayCondition: place.district
 ? new Cesium.DistanceDisplayCondition(0.0, 60000.0)
 : new Cesium.DistanceDisplayCondition(0.0, 4000.0)
 }
 });
 placeLabelEntities.push(newEntity);
 labelEntitiesForHeightRefine.push(newEntity);
 labelCartographicsForHeightRefine.push(Cesium.Cartographic.fromDegrees(place.lon, place.lat));
 });
 console.log("Place labels added:", placeLabels.length);
 // CONFIRMED FIX (this pass): previously called refineEntityHeight()
 // individually per label — 8 separate sampleHeightMostDetailed()
 // promises fired back-to-back at startup, right alongside the ~17
 // individual resource-marker calls above. Both together meant roughly
 // 25 concurrent terrain queries firing in the same startup window —
 // now each batched into one call apiece.
 if (labelCartographicsForHeightRefine.length > 0) {
 viewer.scene.sampleHeightMostDetailed(labelCartographicsForHeightRefine).then(function(){
 labelEntitiesForHeightRefine.forEach(function(entity, i){
 const c = labelCartographicsForHeightRefine[i];
 if (Cesium.defined(c.height)) {
 entity.position = Cesium.Cartesian3.fromRadians(c.longitude, c.latitude, c.height);
 }
 });
 }).catch(function(err){
 console.error("Batched place label height refine failed (labels still visible at approximate height)");
 console.error(err);
 });
 }
}
addPlaceLabels();
// Map Controls uses the same honest OSM fetch/cache path as Explore. POI
// entities are keyed by OSM identity so toggling or revisiting a view never
// creates duplicates; disabled categories do not start new requests.
const mapPoiEnabled = { fuel: false, tourist: false, viewpoint: false, parking: false };
const mapPoiEntities = new Map();
function setMapDetail(detail, visible){
 if (detail === "labels") { placeLabelEntities.forEach(function(e){ e.show = visible; }); }
 else if (resourceEntitiesByType[detail]) { resourceEntitiesByType[detail].forEach(function(e){ e.show = visible; }); }
 viewer.scene.requestRender();
}
function toggleMapPoi(key, enabled){
 mapPoiEnabled[key] = enabled;
 mapPoiEntities.forEach(function(entity, identity){
  if (identity.indexOf(key + "|") === 0) { entity.show = enabled; }
 });
 if (!enabled) { viewer.scene.requestRender(); return; }
 if (!window.__srPoi || !window.__srPoi.fetch) { return; }
 const poiKey = key === "tourist" ? "tourist_places" : key;
 window.__srPoi.fetch(poiKey, function(result){
  if (!mapPoiEnabled[key] || !result || !result.items) { return; }
  const pinBuilder = new Cesium.PinBuilder();
  result.items.forEach(function(item){
   const identity = key + "|" + (item.osm || (item.lat + "," + item.lon));
   let entity = mapPoiEntities.get(identity);
   if (!entity) {
    entity = viewer.entities.add({
     name: item.name || result.label,
     position: Cesium.Cartesian3.fromDegrees(item.lon, item.lat, 0),
     billboard: { image: pinBuilder.fromText("•", Cesium.Color.CYAN, 34).toDataURL(), verticalOrigin: Cesium.VerticalOrigin.BOTTOM, scale: .8, disableDepthTestDistance: Number.POSITIVE_INFINITY, distanceDisplayCondition: new Cesium.DistanceDisplayCondition(0, 20000) },
     label: { text: item.name || result.label, font: "11px sans-serif", fillColor: Cesium.Color.WHITE, outlineColor: Cesium.Color.BLACK, outlineWidth: 3, style: Cesium.LabelStyle.FILL_AND_OUTLINE, verticalOrigin: Cesium.VerticalOrigin.TOP, pixelOffset: new Cesium.Cartesian2(0, 4), disableDepthTestDistance: Number.POSITIVE_INFINITY, distanceDisplayCondition: new Cesium.DistanceDisplayCondition(0, 2500) }
    });
    mapPoiEntities.set(identity, entity);
    refineEntityHeight(entity, item.lat, item.lon);
   }
   entity.show = true;
  });
  viewer.scene.requestRender();
 });
}
window.__srMapControls = { setDetail: setMapDetail, togglePoi: toggleMapPoi };
viewer.scene.renderError.addEventListener(function(scene, error) {
 console.log("========== RENDER ERROR ==========");
 console.log(error);
 console.dir(error);
 if (error) {
 console.log("constructor:", error.constructor?.name);
 console.log("message:", error.message);
 console.log("stack:", error.stack);
 for (const key of Object.getOwnPropertyNames(error)) {
 console.log(key + " = ", error[key]);
 }
 }
});
// globe is disabled (globe: false), so the old globe.tileLoadProgressEvent
// no longer applies. Tile loading progress for the 3D tileset itself is
// tracked via console logs at creation time instead (see above).
console.log("SafeRoute Ready");
}
catch(e){
console.error("CESIUM FAILED");
console.error(e);
window.__srCesiumReady=false;
document.getElementById("sr3dStatus").textContent="3D unavailable · 2D map remains active";
document.getElementById("cesiumContainer").style.visibility="hidden";
}
})();
</script>
</body>
</html>
