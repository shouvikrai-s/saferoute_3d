# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real keys.

# Port the backend listens on
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=https://your-render-app.example,http://127.0.0.1

# Routing mode: "cloud" uses the public GraphHopper API (interim, current
# stage). "self_hosted" uses your own GraphHopper instance once Phase G is
# actually deployed (see backend/README.md).
ROUTING_MODE=cloud

# Required when ROUTING_MODE=cloud.
# This key now lives ONLY on the server — it is never sent to the app.
GRAPHHOPPER_API_KEY=your_graphhopper_key_here
GRAPHHOPPER_CLOUD_URL=https://graphhopper.com/api/1/route

# Required when ROUTING_MODE=self_hosted (Phase G, not yet active).
# Example once you run a local GraphHopper server:
GRAPHHOPPER_SELF_HOSTED_URL=http://127.0.0.1:8989/route

# Rate limit: max requests allowed per IP per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Route cache
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=500

# Required for the server-side TomTom traffic-flow tile proxy.
# Keep the real key only in backend/.env or the deployment environment.
TOMTOM_API_KEY=

# --- Phase 1: upstream resilience layer (services/upstreamQueue.js) ---

# Max concurrent requests this instance will send to GraphHopper at once.
GRAPHHOPPER_MAX_CONCURRENT=5

# Max requests allowed to wait in the FIFO queue once MAX_CONCURRENT is
# saturated. Beyond this, new requests get a fast 503 instead of piling up.
UPSTREAM_QUEUE_MAX_DEPTH=50

# Retry only for transient upstream failures (429/502/503/504), never
# for plain 4xx client errors. This is attempts AFTER the first try.
UPSTREAM_MAX_RETRIES=2
UPSTREAM_RETRY_BASE_MS=200
UPSTREAM_RETRY_MAX_MS=2000

# Circuit breaker: after this many consecutive upstream failures, stop
# calling GraphHopper entirely for CIRCUIT_OPEN_DURATION_MS, then allow
# one trial request through (half-open) to test recovery.
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_DURATION_MS=10000

# How long graceful shutdown waits for in-flight requests to finish
# before forcing exit on SIGTERM/SIGINT.
SHUTDOWN_TIMEOUT_MS=10000

# --- Infrastructure services ---
# PostgreSQL/PostGIS connection
POSTGRES_HOST=your_postgres_host
POSTGRES_PORT=5432
POSTGRES_DATABASE=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
# Redis connection
REDIS_URL=redis://your_redis_host:6379
